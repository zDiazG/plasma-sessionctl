# plasma-sessionctl / plasmactl v0.4.3 configuration baseline
# Target: KDE Plasma Wayland + Sunshine + Moonlight headless/isolated session manager.
# Runtime config source: ~/.config/plasmactl.conf. JSON overlay (~/.config/plasmactl/config.json) is optional.

PLASMA_GPU_DEFAULT=igpu
PLASMA_GPU_ALLOW_FALLBACK=false
PLASMA_GPU_IGPU_DRIVERS="i915 xe"
PLASMA_GPU_DGPU_DRIVERS="amdgpu nvidia nouveau"
PLASMA_GPU_FORBID_DRIVERS=

PLASMA_DRM_DEVICE=auto
PLASMA_DRM_DEVICE_AUTO_FALLBACK=true
PLASMA_DRM_DRIVER_ORDER="i915 xe amdgpu"
PLASMA_DRM_REQUIRE_DRIVER=
ALLOW_VKMS=false

HEADLESS_MODE=kernel-forced-edid
HEADLESS_FORCE_OUTPUT=HDMI-A-1
HEADLESS_FORCE_MODE=1920x1080@60
HEADLESS_EDID_FILE=edid_1080p.bin
REQUIRE_CONNECTED_OUTPUT_ON_START=true

ACTIVATE_TTY_ON_START=true
REQUIRE_ACTIVE_TTY_ON_START=true
TTY_ACTIVATE_TIMEOUT=8

LOCK_TMUX_ON_STOP=true
KILL_TMUX_ON_STOP=false
TERMINATE_TTY_SESSION_ON_STOP=false
RETURN_TTY_ON_STOP=true
RETURN_TTY_NAME=tty2

# Session lifecycle backend. The managed candidate requires separate installation.
# See SPEC.md and docs/INSTALLATION.md before selecting systemd-scope.
PLASMA_SESSION_BACKEND=legacy

# Legacy Sunshine startup modes. These do not use the restricted managed helper.
# - systemd-run: Transient root unit using the legacy privilege configuration
# - tmux: Foreground window inside target tmux session
# - systemd: Standard user systemd service
SUNSHINE_START_MODE=systemd-run
SUNSHINE_SYSTEMD_ISOLATE_DRI=true
SUNSHINE_SYSTEMD_UNIT_PREFIX=sunshine-plasmactl
SUNSHINE_SYSTEMD_REQUIRE_CAP_SYS_ADMIN=true
SUNSHINE_SYSTEMD_DEVICE_ALLOW_UINPUT=true
SUNSHINE_SYSTEMD_ASSERT_MODE=journal
SUNSHINE_SYSTEMD_FD_ASSERT_STRICT=false

SUNSHINE_PROFILE=performance
SUNSHINE_SUPERVISE=false
SUNSHINE_RESTART_ON_START=true
SUNSHINE_REQUIRED_TCP_PORTS="47990 48010"
SUNSHINE_TCP_PORTS="47984 47989 47990 48010"
SUNSHINE_UDP_PORTS="47998 47999 48000 48010"
SUNSHINE_ARGS=

# Sunshine GPU render adapter & output selection
SUNSHINE_ADAPTER_MODE=auto
SUNSHINE_ADAPTER_NAME=
SUNSHINE_OUTPUT_MODE=disabled
SUNSHINE_OUTPUT_NAME=
SUNSHINE_STRICT_GPU_ASSERT=false

SUNSHINE_IGPU_LIBVA_DRIVER_NAME=iHD
SUNSHINE_DGPU_LIBVA_DRIVER_NAME=

# Performance Profile parameters (hardware acceleration on iGPU)
SUNSHINE_PERF_ENCODER=vaapi
SUNSHINE_PERF_CAPTURE=kms
SUNSHINE_PERF_MAX_BITRATE=20000
SUNSHINE_PERF_QP=14
SUNSHINE_PERF_FEC=5
SUNSHINE_PERF_FPS_TARGET=60
SUNSHINE_PERF_HEVC_MODE=1
SUNSHINE_PERF_AV1_MODE=1
SUNSHINE_PERF_MIN_THREADS=2
SUNSHINE_PERF_VAAPI_STRICT_RC_BUFFER=disabled

# Safe Fallback Profile parameters (software encoder for diagnostic isolation)
SUNSHINE_SAFE_ENCODER=software
SUNSHINE_SAFE_CAPTURE=kms
SUNSHINE_SAFE_MAX_BITRATE=30000
SUNSHINE_SAFE_QP=23
SUNSHINE_SAFE_FEC=20
SUNSHINE_SAFE_FPS_TARGET=60
