cmd_logs() {
    local target="${1:-last}" lines="${2:-0}" n
    _tail_file() { local f="$1"; [[ -f "${f}" ]] || { echo "(no log at ${f})"; return; }; [[ "${lines}" -gt 0 ]] && tail -n "${lines}" "${f}" || cat "${f}"; }
    n="${lines}"; [[ "${n}" -le 0 ]] && n=100
    case "${target}" in
        start) echo "=== start: ${START_LOG} ==="; _tail_file "${START_LOG}" ;;
        stop) echo "=== stop: ${STOP_LOG} ==="; _tail_file "${STOP_LOG}" ;;
        last) echo "=== last: ${LAST_LOG} ==="; _tail_file "${LAST_LOG}" ;;
        sun*) echo "=== journalctl: ${SUNSHINE_UNIT} ==="; _run_as_user journalctl --user -u "${SUNSHINE_UNIT}" -n "${n}" --no-pager 2>/dev/null || true; echo ""; echo "=== tmux sunshine: ${SUNSHINE_TMUX_LOG} ==="; [[ -f "${SUNSHINE_TMUX_LOG}" ]] && tail -n "${n}" "${SUNSHINE_TMUX_LOG}" || true ;;
        plasma|tmux) echo "=== tmux capture: ${SESSION} ==="; _run_as_user "${TMUX_BIN}" capture-pane -pt "${SESSION}" -S "-${n}" 2>/dev/null || true ;;
        systemd) echo "=== journalctl --user -b ==="; _run_as_user journalctl --user -b -n "${n}" --no-pager 2>/dev/null || true ;;
        all) ls -lh "${LOG_DIR}/" 2>/dev/null || true ;;
        *) echo "Usage: plasmactl logs [start|stop|last|sunshine|plasma|systemd|all] [N]" ;;
    esac
}

