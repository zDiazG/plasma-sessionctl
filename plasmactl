    echo ""
    cmd_headless_check
    echo ""
    resolve_plasma_drm_device >/dev/null 2>&1 || true
    local card driver render connectors adapter
    card="$(basename "${TARGET_DRM_DEVICE:-}" 2>/dev/null || true)"
    driver="${card:+$(_card_driver "/sys/class/drm/${card}" 2>/dev/null || true)}"
    render="${card:+$(_card_render_node "${card}" 2>/dev/null || true)}"
    connectors="${card:+$(_card_connected_connectors "${card}" 2>/dev/null | paste -sd ' ' -)}"
    adapter="$(_selected_sunshine_adapter 2>/dev/null || true)"
