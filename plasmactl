        "${SUNSHINE_SAFE_QP}" "${SUNSHINE_SAFE_FEC}" "${SUNSHINE_SAFE_APPS}" \
        "sw_preset = superfast" \
        "sw_tune = zerolatency"

    cat > "${SUNSHINE_SAFE_APPS}" <<'EOF_SAFE_APPS'
{
  "env": {},
  "apps": [
    {
      "name": "Desktop",
      "image-path": "desktop.png"
