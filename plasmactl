# Bootstrap must work before dependencies or valid user configuration exist.
# Dispatch before sourcing config, creating directories or resolving user tools.
if [[ "${BASH_SOURCE[0]}" == "$0" && "${1:-}" == bootstrap ]]; then
    shift
    bootstrap_root="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
    [[ -f "${bootstrap_root}/tools/bootstrap.py" ]] || {
        echo 'Bootstrap resources are missing. Run install.sh from a complete checkout.' >&2
        exit 1
    }
    command -v python3 >/dev/null 2>&1 || {
        echo 'Bootstrap requires Python 3.10+; install it through your distribution package manager.' >&2
        exit 1
    }
    exec python3 -I "${bootstrap_root}/tools/bootstrap.py" "$@"
fi

