cmd_doctor() {
    _LOG_CTX="doctor"
    local failures=0 bin sid
    resolve_plasma_drm_device >/dev/null 2>&1 || true

    echo ""
    printf '\033[1mplasmactl doctor v%s\033[0m\n' "${VERSION}"
    echo "───────────────────────"
    ${FIX_MODE} && _info "Auto-fix: ENABLED (--fix)" || _info "Auto-fix: disabled"
    echo ""

    echo "Binaries"; echo "--------"
    for bin in "${REQUIRED_BINS[@]}"; do
        command -v "${bin}" >/dev/null 2>&1 && _pass "${bin}" || { _fail "${bin}"; ((failures++)); }
    done
    command -v sunshine >/dev/null 2>&1 && _pass "sunshine binary" || _warn "sunshine binary not in PATH; relying on user service"
    echo ""

    echo "Getty / ${TTY_NAME}"; echo "------------"
    systemctl is-active --quiet "getty@${TTY_NAME}" && _pass "getty@${TTY_NAME} active" || { _fail "getty@${TTY_NAME} inactive"; ((failures++)); }
    if check_tty_session; then
        sid="$(get_tty_session_id)"
        _pass "${TTY_NAME} loginctl session active (session ${sid})"
        check_tty_seat0 && _pass "${TTY_NAME} on seat0" || { _fail "${TTY_NAME} not on seat0"; ((failures++)); }
        check_tty_active && _pass "${TTY_NAME} is active on seat0" || { _warn "${TTY_NAME} is not active now (active VT=$(get_active_tty_name)); start will try to activate it"; }
    else
        _fail "no ${TTY_NAME} session in loginctl"; ((failures++))
    fi
    echo ""

    echo "DRM target"; echo "----------"
    if [[ -n "${TARGET_DRM_DEVICE}" && -e "${TARGET_DRM_DEVICE}" ]]; then
        _pass "Plasma target: ${TARGET_DRM_DEVICE}"
        case "${TARGET_DRM_DEVICE}" in
            */card*)
                local cn="${TARGET_DRM_DEVICE##*/}"
                local cd="/sys/class/drm/${cn}"
                if [[ -d "${cd}" ]]; then
                    _info "driver=$(_card_driver "${cd}") vendor=$(_card_vendor "${cd}")"
                    _is_vkms_card "${cd}" && _warn "selected target is VKMS/faux; real iGPU is preferred for this project"
                fi
                ;;
        esac
    else
        _fail "No usable DRM target selected"; ((failures++))
    fi
    _print_drm_map
    if ! _bool_true "${ALLOW_VKMS}" && [[ -n "$(_find_vkms_card 2>/dev/null || true)" ]]; then
        _warn "VKMS/faux card is present while ALLOW_VKMS=false. Plasma target is real, but Sunshine may still choose VKMS for KMS capture."
        _info "Recommended test: stop Plasma/Sunshine, remove /etc/modules-load.d/vkms.conf, unload vkms or reboot, then retest."
    fi
    echo ""

    echo "TMUX"; echo "----"
    check_tmux_session && _pass "session '${SESSION}' exists" || { _fail "session '${SESSION}' not found"; ((failures++)); }
    check_tmux_attached && _pass "session '${SESSION}' attached" || _warn "session '${SESSION}' not attached"
    echo ""

    echo "Sunshine"; echo "--------"
    command -v sunshine >/dev/null 2>&1 && _pass "binary: $(command -v sunshine)" || { _fail "sunshine binary not found"; ((failures++)); }
    _info "start mode: ${SUNSHINE_START_MODE}"
    _info "profile: ${SUNSHINE_PROFILE}"
    _info "safe config: ${SUNSHINE_SAFE_CONFIG}"
    check_sunshine_exists && _pass "systemd unit present: ${SUNSHINE_UNIT}" || _warn "systemd unit not found (OK if using tmux mode and sunshine binary exists)"
    check_sunshine_enabled && _pass "systemd service enabled" || _warn "systemd service not enabled"
    if systemctl --user is-failed --quiet "${SUNSHINE_UNIT}" 2>/dev/null; then
        _warn "systemd service is failed/start-limit-hit; tmux launcher is recommended/default"
        ${FIX_MODE} && systemctl --user reset-failed "${SUNSHINE_UNIT}" sunshine.service >/dev/null 2>&1 || true
    fi
    if check_sunshine_ready; then
        _pass "Sunshine stream-ready: process + TCP ${SUNSHINE_REQUIRED_TCP_PORTS}"
    elif check_sunshine_process; then
        _warn "sunshine process exists but required TCP listeners are missing"
    else
        _info "sunshine not running before start is OK"
    fi
    echo ""

    echo "Summary"; echo "-------"
    if [[ ${failures} -eq 0 ]]; then
        printf '\033[1;32m✓ All critical checks passed\033[0m\n'
    else
        printf '\033[1;31m✗ %d critical check(s) failed\033[0m\n' "${failures}"
    fi
    echo ""
    return $(( failures > 0 ? 1 : 0 ))
}

