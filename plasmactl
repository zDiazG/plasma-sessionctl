# DRM / GPU DETECTION (CONSOLIDATED CORE HELPER)
# ─────────────────────────────────────────────────────────────────────────────

_card_name_from_dir() { basename "$1"; }
_card_dev_from_name() { printf '/dev/dri/%s' "$1"; }

_card_device_path() {
    local card_dir="$1"
    readlink -f "${card_dir}/device" 2>/dev/null || true
}

_card_driver() {
    local card_dir="$1" mod_link drv_link dev_path
    mod_link="${card_dir}/device/driver/module"
    if [[ -e "${mod_link}" ]]; then
        readlink -f "${mod_link}" 2>/dev/null | xargs basename 2>/dev/null && return
    fi
    drv_link="${card_dir}/device/driver"
    if [[ -e "${drv_link}" ]]; then
        basename "$(readlink -f "${drv_link}" 2>/dev/null || true)" 2>/dev/null && return
    fi
    dev_path="$(_card_device_path "${card_dir}")"
    [[ -n "${dev_path}" ]] && basename "${dev_path}" || echo "unknown"
}

_card_vendor() {
    local f="$1/device/vendor"
    [[ -r "${f}" ]] && tr -d '[:space:]' < "${f}" || echo ""
}

_card_render_node() {
    local card_name="$1" r node byp
    for r in /sys/class/drm/${card_name}/device/drm/renderD*; do
        [[ -e "${r}" ]] || continue
        node="/dev/dri/$(basename "${r}")"
        for byp in /dev/dri/by-path/*-render; do
            [[ -e "${byp}" ]] || continue
            if [[ "$(readlink -f "${byp}" 2>/dev/null || true)" == "$(readlink -f "${node}" 2>/dev/null || true)" ]]; then
                echo "${byp}"
                return 0
            fi
        done
        echo "${node}"
        return 0
    done
    return 1
}

_card_driver_from_dev() {
    local dev="$1" card_dir
    card_dir="/sys/class/drm/$(basename "${dev}")"
    [[ -d "${card_dir}" ]] || return 1
    _card_driver "${card_dir}"
}

_card_has_connected_display() {
    local card_name="$1" connector status
    for connector in /sys/class/drm/${card_name}-*; do
        [[ -f "${connector}/status" ]] || continue
        status="$(tr -d '[:space:]' < "${connector}/status" 2>/dev/null || true)"
        [[ "${status}" == "connected" ]] && return 0
    done
    return 1
}

_require_kms_output_ready() {
    local card_name
    _bool_true "${REQUIRE_CONNECTED_OUTPUT_ON_START}" || return 0

    if [[ -z "${TARGET_DRM_DEVICE:-}" ]]; then
        err "Cannot check KMS output: no DRM device is selected."
        return 1
    fi

    card_name="$(basename "${TARGET_DRM_DEVICE}")"
    if [[ ! "${card_name}" =~ ^card[0-9]+$ ]]; then
        err "Cannot check KMS output for invalid DRM card '${TARGET_DRM_DEVICE}'."
        return 1
    fi

    if ! _card_has_connected_display "${card_name}"; then
        err "No connected KMS output is reported for ${TARGET_DRM_DEVICE}. Check the selected GPU, display cable or forced-EDID kernel settings."
        return 1
    fi

    vlog "Connected KMS output found for ${TARGET_DRM_DEVICE}"
}

_card_connected_connectors() {
    local card_name="$1" connector status
    for connector in /sys/class/drm/${card_name}-*; do
        [[ -f "${connector}/status" ]] || continue
        status="$(tr -d '[:space:]' < "${connector}/status" 2>/dev/null || true)"
        [[ "${status}" == "connected" ]] && basename "${connector}"
    done
}

_first_connected_connector() {
    local connector status
    for connector in /sys/class/drm/card[0-9]*-*; do
        [[ -f "${connector}/status" ]] || continue
        status="$(tr -d '[:space:]' < "${connector}/status" 2>/dev/null || true)"
        [[ "${status}" == "connected" ]] && { basename "${connector}"; return 0; }
    done
    return 1
}

_connector_short_name() {
    local name="$1"
    echo "${name}" | sed -E 's/^card[0-9]+-//'
}

_validate_headless_edid_inputs() {
    local connector="$1" mode="$2" edid_file="$3"
    if [[ ! "${connector}" =~ ^[[:alnum:]_.-]+$ ]]; then
        err "Invalid DRM connector name '${connector}'."
        return 2
    fi
    if [[ ! "${mode}" =~ ^[0-9]+x[0-9]+@[0-9]+$ ]]; then
        err "Invalid forced display mode '${mode}'. Expected WIDTHxHEIGHT@REFRESH."
        return 2
    fi
    if [[ ! "${edid_file}" =~ ^[[:alnum:]_.-]+$ || "${edid_file}" == *..* ]]; then
        err "Invalid EDID filename '${edid_file}'. Use a plain filename without path components."
        return 2
    fi
}

_limine_cmdline_sed_expression() {
    local params="$1"
    local safe_params_re='^[[:alnum:]_.:@/=& -]+$'
    local sed_params
    if [[ ! "${params}" =~ ${safe_params_re} ]]; then
        err "Refusing unsafe Limine kernel parameters."
        return 2
    fi
    sed_params=${params//\\/\\\\}
    sed_params=${sed_params//\&/\\\&}
    sed_params=${sed_params//|/\\|}
    printf '/^KERNEL_CMDLINE\\[default\\]/{s|"$| %s"|}' "${sed_params}"
}

_connector_sysfs_path() {
    local input="$1" connector
    if [[ -d "/sys/class/drm/${input}" ]]; then
        echo "/sys/class/drm/${input}"; return 0
    fi
    for connector in /sys/class/drm/card[0-9]*-${input}; do
        [[ -d "${connector}" ]] && { echo "${connector}"; return 0; }
    done
    return 1
}

_selected_card_name() {
    [[ -n "${TARGET_DRM_DEVICE:-}" ]] || return 1
    basename "${TARGET_DRM_DEVICE}"
}

_is_vkms_card() {
    local card_dir="$1" dev_path driver
    dev_path="$(_card_device_path "${card_dir}")"
    driver="$(_card_driver "${card_dir}")"
    [[ "$(basename "${dev_path:-x}")" == "vkms" ]] && return 0
    [[ "${driver}" == "vkms" || "${driver}" == "faux_driver" ]] && return 0
    [[ "${dev_path}" == */vkms* ]] && return 0
    return 1
}

_card_is_real() { ! _is_vkms_card "$1"; }

# Consolidated DRM Card Finder
_find_drm_card() {
    local driver="" require_connected=false require_real=true require_vkms=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --driver) driver="$2"; shift ;;
            --connected) require_connected=true ;;
            --real) require_real=true ;;
            --vkms) require_vkms=true; require_real=false ;;
        esac
        shift
    done
    local card_dir cname dev drv
    for card_dir in /sys/class/drm/card[0-9]*; do
        cname="$(_card_name_from_dir "${card_dir}")"
        [[ "${cname}" =~ ^card[0-9]+$ ]] || continue
        if ${require_vkms}; then
            _is_vkms_card "${card_dir}" || continue
        elif ${require_real}; then
            _card_is_real "${card_dir}" || continue
        fi
        if [[ -n "${driver}" ]]; then
            drv="$(_card_driver "${card_dir}")"
            [[ "${drv}" == "${driver}" ]] || continue
        fi
        if ${require_connected}; then
            _card_has_connected_display "${cname}" || continue
        fi
        dev="$(_card_dev_from_name "${cname}")"
        [[ -e "${dev}" ]] || continue
        echo "${dev}"
        return 0
    done
    return 1
}

_find_connected_card_by_driver() { _find_drm_card --driver "$1" --connected --real; }
_find_card_by_driver()           { _find_drm_card --driver "$1" --real; }
_find_connected_real_card()     { _find_drm_card --connected --real; }
_find_any_real_card()          { _find_drm_card --real; }
_find_vkms_card()              { _find_drm_card --vkms; }

_find_connected_card_by_driver_list() {
    local drv found
    for drv in $1; do
        found="$(_find_connected_card_by_driver "${drv}" || true)"
        [[ -n "${found}" ]] && { echo "${found}"; return 0; }
    done
    return 1
}

_find_card_by_driver_list() {
    local drv found
    for drv in $1; do
        found="$(_find_card_by_driver "${drv}" || true)"
        [[ -n "${found}" ]] && { echo "${found}"; return 0; }
    done
    return 1
}

_print_drm_map() {
    local card_dir cname dev driver vendor conn vkms rec
    for card_dir in /sys/class/drm/card[0-9]*; do
        cname="$(_card_name_from_dir "${card_dir}")"
        [[ "${cname}" =~ ^card[0-9]+$ ]] || continue
        dev="$(_card_dev_from_name "${cname}")"
        driver="$(_card_driver "${card_dir}")"
        vendor="$(_card_vendor "${card_dir}")"
        conn=""
        _card_has_connected_display "${cname}" && conn=" [display connected]" || true
        vkms=""
        _is_vkms_card "${card_dir}" && vkms=" ← VKMS/faux" || true
        rec=""
        [[ "${dev}" == "${TARGET_DRM_DEVICE:-}" ]] && rec=" ← selected"
        printf '  %-10s → %-12s vendor=%-8s%s%s%s\n' "${cname}" "${driver}" "${vendor:-?}" "${conn}" "${vkms}" "${rec}"
    done
}

_effective_gpu_role() {
    local role="${PLASMA_GPU_OVERRIDE:-${PLASMA_GPU_DEFAULT:-auto}}"
    case "${role}" in
        igpu|integrated|intel) echo "igpu" ;;
        dgpu|discrete|amd|nvidia) echo "dgpu" ;;
        auto|any|"") echo "auto" ;;
        *) echo "${role}" ;;
    esac
}

_gpu_role_drivers() {
    case "$(_effective_gpu_role)" in
        igpu) echo "${PLASMA_GPU_IGPU_DRIVERS}" ;;
        dgpu) echo "${PLASMA_GPU_DGPU_DRIVERS}" ;;
        auto) echo "${PLASMA_DRM_DRIVER_ORDER}" ;;
        *) echo "${PLASMA_DRM_DRIVER_ORDER}" ;;
    esac
}

_target_driver() {
    local card_dir
    [[ -n "${TARGET_DRM_DEVICE:-}" ]] || return 1
    card_dir="/sys/class/drm/$(basename "${TARGET_DRM_DEVICE}")"
    _card_driver "${card_dir}"
}

_driver_list_contains() {
    local wanted="$1" list="$2" drv
    for drv in ${list}; do
        [[ "${drv}" == "${wanted}" ]] && return 0
    done
    return 1
}

_assert_target_driver_policy() {
    local driver role allowed forbidden
    driver="$(_target_driver 2>/dev/null || true)"
    [[ -n "${driver}" ]] || return 0

    for forbidden in ${PLASMA_GPU_FORBID_DRIVERS}; do
        if [[ "${driver}" == "${forbidden}" ]]; then
            err "Selected DRM target ${TARGET_DRM_DEVICE} uses forbidden driver '${driver}'."
            return 1
        fi
    done

    if [[ -n "${PLASMA_DRM_REQUIRE_DRIVER}" && "${driver}" != "${PLASMA_DRM_REQUIRE_DRIVER}" ]]; then
        err "Selected DRM target ${TARGET_DRM_DEVICE} uses driver '${driver}', but PLASMA_DRM_REQUIRE_DRIVER=${PLASMA_DRM_REQUIRE_DRIVER}."
        return 1
    fi

    role="$(_effective_gpu_role)"
    if [[ "${role}" != "auto" ]] && ! _bool_true "${PLASMA_GPU_ALLOW_FALLBACK}"; then
        allowed="$(_gpu_role_drivers)"
        if ! _driver_list_contains "${driver}" "${allowed}"; then
            err "GPU role '${role}' is enforced, but selected DRM target ${TARGET_DRM_DEVICE} uses driver '${driver}'."
            err "Allowed drivers for role '${role}': ${allowed}"
            err "Use --gpu=dgpu/--gpu=igpu for a one-shot override, or set PLASMA_GPU_DEFAULT accordingly."
            return 1
        fi
    fi
    return 0
}

_resolve_configured_drm() {
    local configured="${PLASMA_DRM_DEVICE:-auto}"
    if [[ -n "${PLASMA_GPU_OVERRIDE:-}" && "${PLASMA_GPU_OVERRIDE}" != "auto" ]]; then
        return 2
    fi
    [[ -n "${KWIN_DRM_DEVICES:-}" ]] && configured="${KWIN_DRM_DEVICES%%:*}"
    if [[ "${configured}" != "auto" && -n "${configured}" ]]; then
        if [[ -e "${configured}" ]]; then
            TARGET_DRM_DEVICE="${configured}"
            _assert_target_driver_policy || return 1
            echo "${TARGET_DRM_DEVICE}" > "${TARGET_DEVICE_FILE}"
            return 0
        fi
        if _bool_true "${PLASMA_DRM_DEVICE_AUTO_FALLBACK}"; then
            _warn "Configured PLASMA_DRM_DEVICE=${configured} does not exist; falling back to auto DRM detection."
            return 2
        fi
        err "Configured PLASMA_DRM_DEVICE=${configured} does not exist"
        return 1
    fi
    return 2
}

resolve_plasma_drm_device() {
    if _resolve_configured_drm; then
        vlog "Using configured DRM device: ${TARGET_DRM_DEVICE}"
        return 0
    elif [[ $? -eq 1 ]]; then
        return 1
    fi

    local found="" drv role role_drivers
    role="$(_effective_gpu_role)"
    role_drivers="$(_gpu_role_drivers)"

    if [[ -n "${PLASMA_DRM_REQUIRE_DRIVER}" ]]; then
        found="$(_find_connected_card_by_driver "${PLASMA_DRM_REQUIRE_DRIVER}" || true)"
        [[ -z "${found}" ]] && found="$(_find_card_by_driver "${PLASMA_DRM_REQUIRE_DRIVER}" || true)"
        if [[ -z "${found}" ]]; then
            err "PLASMA_DRM_REQUIRE_DRIVER=${PLASMA_DRM_REQUIRE_DRIVER} requested, but no matching DRM card exists."
            return 1
        fi
    fi

    if [[ -z "${found}" && "${role}" != "auto" ]]; then
        found="$(_find_connected_card_by_driver_list "${role_drivers}" || true)"
        [[ -z "${found}" ]] && found="$(_find_card_by_driver_list "${role_drivers}" || true)"
        if [[ -z "${found}" ]] && ! _bool_true "${PLASMA_GPU_ALLOW_FALLBACK}"; then
            err "GPU role '${role}' requested, but no matching DRM card exists (drivers: ${role_drivers})."
            _print_drm_map >&2 || true
            return 1
        fi
    fi

    if [[ -z "${found}" ]]; then
        for drv in ${PLASMA_DRM_DRIVER_ORDER}; do
            found="$(_find_connected_card_by_driver "${drv}" || true)"
            [[ -n "${found}" ]] && break
        done
    fi

    [[ -z "${found}" ]] && found="$(_find_connected_real_card || true)"

    if [[ -z "${found}" ]]; then
        for drv in ${PLASMA_DRM_DRIVER_ORDER}; do
            found="$(_find_card_by_driver "${drv}" || true)"
            [[ -n "${found}" ]] && break
        done
    fi
    [[ -z "${found}" ]] && found="$(_find_any_real_card || true)"

    if [[ -z "${found}" ]] && _bool_true "${ALLOW_VKMS}"; then
        found="$(_find_vkms_card || true)"
    fi

    if [[ -z "${found}" ]]; then
        err "No suitable real DRM card found. Run: plasmactl detect-gpu --verbose"
        return 1
    fi

    TARGET_DRM_DEVICE="${found}"
    _assert_target_driver_policy || return 1
    echo "${TARGET_DRM_DEVICE}" > "${TARGET_DEVICE_FILE}"
    vlog "Auto-selected DRM device: ${TARGET_DRM_DEVICE}"
}

# Inspect prerequisites for a NEW systemd-managed execution. This does not
# adopt an existing session or establish that DRM/streaming will work.
_session_property() {
    local properties="$1" key="$2"
    awk -v key="${key}" 'index($0, key "=") == 1 {print substr($0, length(key) + 2); exit}' <<< "${properties}"
}

cmd_session_check() {
    local sessions sid properties user type seat tty unit units state load
    local conflict=false unavailable=false login_found=false
    printf 'Systemd session preflight for a new execution\n'
    if ! sessions="$("${LOGINCTL_BIN}" list-sessions --no-legend 2>/dev/null)"; then
        err "Cannot query logind sessions."
        return 2
    fi
    while read -r sid _; do
        [[ -n "${sid}" ]] || continue
        if ! properties="$("${LOGINCTL_BIN}" show-session "${sid}" -p User -p Type -p Seat -p TTY 2>/dev/null)"; then
            err "Cannot inspect login session ${sid}."
            unavailable=true
            continue
        fi
        user="$(_session_property "${properties}" User)"
        type="$(_session_property "${properties}" Type)"
        if [[ -z "${user}" || -z "${type}" ]]; then
            err "Incomplete identity for login session ${sid}."
            unavailable=true
            continue
        fi
        [[ "${user}" == "${REAL_UID}" ]] || continue
        case "${type}" in
            x11|wayland|mir)
                printf 'conflict: graphical login session %s (%s)\n' "${sid}" "${type}"
                conflict=true ;;
            tty)
                seat="$(_session_property "${properties}" Seat)"
                tty="$(_session_property "${properties}" TTY)"
                if [[ "${seat}" == seat0 && "${tty}" == "${TTY_NAME}" ]]; then
                    printf 'login: session %s, %s, %s\n' "${sid}" "${seat}" "${tty}"
                    login_found=true
                fi ;;
        esac
    done <<< "${sessions}"
    if [[ "${login_found}" != true ]]; then
        err "No matching ${TTY_NAME}/seat0 login for the target UID."
        unavailable=true
    fi

    # Include graphical-session.target to catch a desktop using another DE.
    units='graphical-session.target plasma-workspace-wayland.target plasma-kwin_wayland.service plasma-plasmashell.service'
    for unit in ${units}; do
        if ! properties="$(_run_as_user "${SYSTEMCTL_BIN}" --user show "${unit}" -p LoadState -p ActiveState 2>/dev/null)"; then
            err "Cannot inspect user unit ${unit}."
            unavailable=true
            continue
        fi
        load="$(_session_property "${properties}" LoadState)"
        state="$(_session_property "${properties}" ActiveState)"
        printf 'unit: %s load=%s state=%s\n' "${unit}" "${load:-unknown}" "${state:-unknown}"
        if [[ "${load}" != loaded ]]; then
            unavailable=true
        else
            case "${state}" in
                inactive) ;;
                active|activating|deactivating|reloading|refreshing) conflict=true ;;
                *) unavailable=true ;;
            esac
        fi
    done
    printf 'This check does not validate scope launch, DRM access or streaming.\n'
    if [[ "${unavailable}" == true ]]; then return 2; fi
    if [[ "${conflict}" == true ]]; then return 1; fi
    printf 'Known login and unit prerequisites are clear for a new execution.\n'
}

cmd_detect_gpu() {
    _LOG_CTX="detect-gpu"
    resolve_plasma_drm_device >/dev/null 2>&1 || true
    echo ""
    printf '\033[1mDRM Device Map\033[0m\n'
    echo "──────────────"
    _print_drm_map
    echo ""
    echo "Selected Plasma DRM target: ${TARGET_DRM_DEVICE:-not resolved}"
    echo "Config file: ${CONFIG_FILE}"
    echo ""
}

