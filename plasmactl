_proc_fd_lines() {
    local pid="$1"
    [[ -d "/proc/${pid}/fd" ]] || return 0
    if [[ "${EUID}" -eq 0 ]]; then
        ls -l "/proc/${pid}/fd" 2>/dev/null || true
    else
        sudo -n ls -l "/proc/${pid}/fd" 2>/dev/null || ls -l "/proc/${pid}/fd" 2>/dev/null || true
    fi
}

_proc_cmdline_short() {
    local pid="$1" cmd
    cmd="$(tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null | sed 's/[[:space:]]*$//' || true)"
    [[ -n "${cmd}" ]] || cmd="$(cat "/proc/${pid}/comm" 2>/dev/null || echo unknown)"
    printf '%s' "${cmd}" | cut -c1-180
}

_proc_user_name() {
    local pid="$1"
    ps -o user= -p "${pid}" 2>/dev/null | awk '{print $1}' || echo unknown
}

_unit_main_pid() {
    local unit="$1" pid
    if [[ "${EUID}" -eq 0 ]]; then
        pid="$(systemctl show -p MainPID --value "${unit}" 2>/dev/null || true)"
    else
        pid="$(sudo -n systemctl show -p MainPID --value "${unit}" 2>/dev/null || systemctl show -p MainPID --value "${unit}" 2>/dev/null || true)"
    fi
    [[ "${pid}" =~ ^[0-9]+$ && "${pid}" != "0" ]] && echo "${pid}"
}

_list_processes_using_gpu_nodes() {
    local label="$1" card_node="$2" render_node="$3" card_base render_base pid p fds cmd user any=false
    card_base="$(basename "${card_node}" 2>/dev/null || true)"
    render_base="$(basename "${render_node}" 2>/dev/null || true)"
    echo "### Processes using ${label} (${card_base:-unknown}/${render_base:-unknown})"
    for p in /proc/[0-9]*; do
        [[ -d "${p}" ]] || continue
        pid="${p#/proc/}"
        [[ "${pid}" =~ ^[0-9]+$ ]] || continue
        fds="$(_proc_fd_lines "${pid}" | grep -E "/dev/dri/(${card_base}|${render_base})([^0-9]|$)" || true)"
        [[ -n "${fds}" ]] || continue
        any=true
        user="$(_proc_user_name "${pid}")"
        cmd="$(_proc_cmdline_short "${pid}")"
        printf 'pid=%-8s user=%-12s cmd=%s
' "${pid}" "${user}" "${cmd}"
        printf '%s
' "${fds}" | sed 's/^/  fd: /'
    done
    ${any} || echo "(no visible processes currently hold these DRM nodes)"
}

cmd_confirm_gpu() {
    _LOG_CTX="confirm-gpu"
    local requested="${1:-}" role card_node card_base driver render_node render_base unit spid journal kwpid envdev ok=true other_card other_driver
    case "${requested}" in
        igpu|integrated|intel) PLASMA_GPU_OVERRIDE="igpu" ;;
        dgpu|discrete|amd|nvidia) PLASMA_GPU_OVERRIDE="dgpu" ;;
        auto|any) PLASMA_GPU_OVERRIDE="auto" ;;
        "") ;;
        *) echo "ERROR: confirm-gpu expects igpu, dgpu, auto, or no argument" >&2; return 2 ;;
    esac
    resolve_plasma_drm_device >/dev/null 2>&1 || true
    role="$(_effective_gpu_role)"
    card_node="$(_selected_card_node_plain 2>/dev/null || true)"
    card_base="$(basename "${card_node}" 2>/dev/null || true)"
    driver="$(_target_driver 2>/dev/null || true)"
    render_node="$(_selected_render_node_plain 2>/dev/null || true)"
    render_base="$(basename "${render_node}" 2>/dev/null || true)"
    unit="$(_sunshine_systemd_unit_name).service"
    spid="$(_unit_main_pid "${unit}" || true)"
    [[ -z "${spid}" ]] && spid="$(_sunshine_newest_pid || true)"
    journal="$(_journalctl_unit "${unit}" -n 260)"

    echo "=== plasmactl confirm-gpu v${VERSION} ==="
    echo "CONFIRM_TAG=confirm:${role}"
    echo "expected_role=${role}"
    echo "selected_card=${card_node:-unresolved}"
    echo "selected_driver=${driver:-unknown}"
    echo "selected_render=${render_node:-unknown}"
    echo "systemd_unit=${unit}"
    echo "sunshine_pid=${spid:-none}"
    echo ""
    echo "### DRM map"
    _print_drm_map

    echo ""
    echo "### KWin assertion"
    kwpid="$(pgrep -u "${REAL_USER}" -x kwin_wayland | head -1 || true)"
    echo "kwin_pid=${kwpid:-none}"
    if [[ -n "${kwpid}" ]]; then
        envdev="$(tr '\0' '\n' < "/proc/${kwpid}/environ" 2>/dev/null | awk -F= '/^KWIN_DRM_DEVICES=/{print $2; exit}' || true)"
        echo "kwin_env_KWIN_DRM_DEVICES=${envdev:-none}"
        if [[ -n "${card_node}" && "${envdev}" == "${card_node}" ]]; then
            echo "KWIN_SELECTED_GPU_OK"
        else
            echo "KWIN_SELECTED_GPU_WARN"
            ok=false
        fi
        _proc_fd_lines "${kwpid}" | grep -E '/dev/dri|card|render' | sed 's/^/kwin_fd: /' || true
    fi

    echo ""
    echo "### Sunshine assertion"
    if [[ -n "${journal}" ]]; then
        printf '%s
' "${journal}" | grep -Ei 'Operation not permitted|/dev/dri/card|Screencasting|KMS|monitor|connector|encoder|vaapi|Intel|AMD|Radeon|Fatal|Error' | tail -n 120 || true
    else
        echo "journal_unavailable_or_empty"
    fi
    if grep -Eq "/dev/dri/${card_base} -> ${driver}" <<<"${journal}"; then
        echo "SUNSHINE_SELECTED_GPU_JOURNAL_OK"
    else
        echo "SUNSHINE_SELECTED_GPU_JOURNAL_WARN"
        ok=false
    fi
    for other_card in /sys/class/drm/card[0-9]*; do
        [[ -e "${other_card}" ]] || continue
        other_card="$(basename "${other_card}")"
        [[ "${other_card}" == "${card_base}" ]] && continue
        other_driver="$(_card_driver "/sys/class/drm/${other_card}" 2>/dev/null || echo unknown)"
        if grep -Fq "Couldn't open: /dev/dri/${other_card}: Operation not permitted" <<<"${journal}"; then
            echo "FORBIDDEN_GPU_BLOCKED_OK card=${other_card} driver=${other_driver}"
        else
            echo "FORBIDDEN_GPU_BLOCKED_NOT_OBSERVED card=${other_card} driver=${other_driver}"
        fi
    done
    if [[ -n "${spid}" ]]; then
        _proc_fd_lines "${spid}" | grep -E '/dev/dri|card|render' | sed 's/^/sunshine_fd: /' || echo "sunshine_fd: none visible yet"
        if _proc_fd_lines "${spid}" | grep -E '/dev/dri/(card|renderD)' | grep -Ev "${card_base}|${render_base}" >/dev/null 2>&1; then
            echo "SUNSHINE_FD_WRONG_GPU_FAIL"
            ok=false
        else
            echo "SUNSHINE_FD_NO_WRONG_GPU_OK"
        fi
    fi

    echo ""
    _list_processes_using_gpu_nodes "selected:${role}" "${card_node}" "${render_node}"
    echo ""
    for other_card in /sys/class/drm/card[0-9]*; do
        [[ -e "${other_card}" ]] || continue
        other_card="$(basename "${other_card}")"
        [[ "${other_card}" == "${card_base}" ]] && continue
        other_driver="$(_card_driver "/sys/class/drm/${other_card}" 2>/dev/null || echo unknown)"
        local other_render=""
        other_render="$(_selected_tmp_card_render_plain "${other_card}" 2>/dev/null || true)"
        _list_processes_using_gpu_nodes "non-selected:${other_card}:${other_driver}" "/dev/dri/${other_card}" "${other_render}"
        echo ""
    done

    if ${ok}; then
        echo "CONFIRM_RESULT=OK"
        return 0
    else
        echo "CONFIRM_RESULT=WARN"
        return 1
    fi
}

_selected_tmp_card_render_plain() {
    local card_name="$1" r
    for r in /sys/class/drm/${card_name}/device/drm/renderD*; do
        [[ -e "${r}" ]] || continue
        echo "/dev/dri/$(basename "${r}")"
        return 0
    done
    return 1
}

cmd_gpu_assert() {
    _LOG_CTX="gpu-assert"
    echo "=== plasmactl gpu-assert v${VERSION} ==="
    resolve_plasma_drm_device >/dev/null 2>&1 || true
    local card driver render adapter kwpid ok=true
    card="${TARGET_DRM_DEVICE:-}"
    driver="$(_target_driver 2>/dev/null || true)"
    render="$(_card_render_node "$(basename "${card}" 2>/dev/null || true)" 2>/dev/null || true)"
    adapter="$(_selected_sunshine_adapter 2>/dev/null || true)"
    echo "gpu_default=${PLASMA_GPU_DEFAULT}"
    echo "gpu_override=${PLASMA_GPU_OVERRIDE:-none}"
    echo "gpu_effective_role=$(_effective_gpu_role)"
    echo "gpu_allow_fallback=${PLASMA_GPU_ALLOW_FALLBACK}"
    echo "target_drm=${card:-unresolved}"
    echo "target_driver=${driver:-unknown}"
    echo "target_render=${render:-unknown}"
    echo "sunshine_adapter_effective=${adapter:-unknown}"
    echo "sunshine_output_effective=$(_selected_sunshine_output 2>/dev/null || echo unset)"
    if [[ -z "${card}" || -z "${driver}" || -z "${render}" ]]; then
        echo "FAIL: selected GPU target is unresolved"
        ok=false
    fi
    if ! _assert_target_driver_policy; then ok=false; fi
    if [[ -n "${render}" && -n "${adapter}" && "${render}" != "${adapter}" ]]; then
        echo "FAIL: Sunshine adapter does not match selected card render node"
        ok=false
    fi
    kwpid="$(pgrep -u "${REAL_USER}" -x kwin_wayland | head -1 || true)"
    echo "kwin_pid=${kwpid:-none}"
    if [[ -n "${kwpid}" ]]; then
        local envdev
        envdev="$(tr '\0' '\n' < "/proc/${kwpid}/environ" 2>/dev/null | awk -F= '/^KWIN_DRM_DEVICES=/{print $2; exit}' || true)"
        echo "kwin_env_KWIN_DRM_DEVICES=${envdev:-none}"
        if [[ -n "${card}" && -n "${envdev}" && "${envdev}" != "${card}" ]]; then
            echo "FAIL: running KWin is not using selected DRM target"
            ok=false
        fi
    fi
    ${ok} && echo "GPU assert: OK" || { echo "GPU assert: FAIL"; return 1; }
}

usage() {
    cat <<EOF_USAGE

plasmactl v${VERSION} — KDE Plasma / Sunshine session controller

Usage: plasmactl [--verbose] <command> [args]

Flags:
  --verbose, -v  Extra diagnostic output
  --fix          Used with doctor where applicable

Commands:
  start           Launch Plasma + Sunshine on selected real DRM target (v0.4: Sunshine via systemd-run by default)
  stop            Stop Sunshine/Plasma and lock the physical tmux console when possible
  restart         stop + start
  status          Health check all components
  doctor          Diagnose prerequisites
  detect-gpu      Show DRM device map and selected target
  headless-check  Diagnose no-monitor/no-dummy KMS viability and show forced-EDID hints
  headless-edid   status|params|capture|install-limine EDID helper for no-monitor boot
  list            Sessions, tmux, DRM, processes, services, state
  logs            logs [start|stop|last|sunshine|plasma|systemd|all] [N]
  debug           Full diagnostic snapshot → ${DEBUG_DIR}/
  cleanup         Remove stale PID/lock/device cache files
  attach          Attach to tmux session '${SESSION}'
  sunshine-safe      Generate SAFE Sunshine profile/config
  sunshine-profiles  Generate SAFE + PERFORMANCE Sunshine profiles and manifest
  setup [--system]   Create default config/profiles; --system also configures getty/tmux/sudoers
  config-snapshot    Show plasmactl + Sunshine configs/apps
  config-template    Write optional JSON overlay config template
  sanity             Full post-boot runtime sanity check
  gpu-assert         Verify selected GPU role/driver/render and running KWin/Sunshine alignment
  confirm-gpu        Confirm selected GPU isolation: confirm-gpu [igpu|dgpu|auto]
  confirm-igpu       Alias for confirm-gpu igpu
  confirm-dgpu       Alias for confirm-gpu dgpu

GPU selection flags:
  --gpu=igpu | --igpu    One-shot force integrated GPU role for start/restart/sanity
  --gpu=dgpu | --dgpu    One-shot force discrete GPU role for start/restart/sanity
  --gpu=auto             One-shot auto selection

Config: ${CONFIG_FILE}
Example for current host:
  plasmactl setup
  # Optional for fresh install only:
  plasmactl setup --system

EOF_USAGE
}

# ─────────────────────────────────────────────────────────────────────────────
# ARG PARSING + DISPATCH
# ─────────────────────────────────────────────────────────────────────────────

POSITIONAL=()
while [[ $# -gt 0 ]]; do
    case "${1}" in
        --verbose|-v) VERBOSE=true ;;
        --fix) FIX_MODE=true ;;
        --gpu=*) PLASMA_GPU_OVERRIDE="${1#--gpu=}" ;;
        --gpu)
            shift || { echo "ERROR: --gpu requires igpu|dgpu|auto" >&2; exit 1; }
            PLASMA_GPU_OVERRIDE="${1:-}"
            ;;
        --igpu) PLASMA_GPU_OVERRIDE="igpu" ;;
        --dgpu) PLASMA_GPU_OVERRIDE="dgpu" ;;
        -dgpu|-igpu) echo "ERROR: use --${1#-}, not ${1}. Example: plasmactl --${1#-} start --verbose" >&2; exit 2 ;;
        *) POSITIONAL+=("${1}") ;;
    esac
    shift || true
done
set -- "${POSITIONAL[@]+"${POSITIONAL[@]}"}"

case "${1:-}" in
    start)      cmd_start ;;
    stop)       cmd_stop ;;
    restart)    cmd_restart ;;
    status)     cmd_status ;;
    doctor)     cmd_doctor ;;
    detect-gpu) cmd_detect_gpu ;;
    headless-check) cmd_headless_check ;;
    headless-edid)  cmd_headless_edid "$@" ;;
    list)       cmd_list ;;
    logs)       cmd_logs "${2:-last}" "${3:-0}" ;;
    debug)      cmd_debug ;;
