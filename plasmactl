#!/usr/bin/env bash
# plasmactl — KDE Plasma Wayland + Sunshine session controller
# Architecture: getty@tty2 → autologin → tmux plasma → startplasma-wayland → Sunshine
# Version: 0.4.2
#
# v0.2.4 design changes:
# - VKMS is optional, not a hard requirement.
# - Prefer a real iGPU DRM card for KWin (i915/xe first), with config override.
# - Stop/restart Sunshine around Plasma start so it does not grab KMS too early.
# - Wait for kwin + WAYLAND_DISPLAY socket + plasmashell before starting Sunshine.
# - Use systemctl --user set-environment so Sunshine inherits Wayland/runtime hints.
# - Avoid fragile pgrep|head pipelines under set -euo pipefail.
#
# v0.2.5 hotfix:
# - Fix doctor unbound variable on local cn/cd assignment under set -u.
# - Warn when VKMS/faux is still present while ALLOW_VKMS=false, because Sunshine may still select it for KMS capture.
# - After Sunshine start, inspect fresh journal lines and warn if Sunshine chose VKMS/faux for capture.
#
# v0.2.6 changes:
# - Sunshine health is process + TCP listener validation, not only systemd active.
# - Default Sunshine launcher changed to tmux window inside the real tty2 session.
#   This matches the confirmed working manual foreground launch and bypasses the user service
#   crash/start-limit-hit path seen with signal=TRAP.
# - systemd Sunshine service is stopped/reset before tmux launch to avoid port/process conflicts.
# - status/doctor/logs/debug now show listeners and tmux Sunshine log.
#
# v0.2.7 hotfix:
# - Fix broken tmux Sunshine launcher quoting that caused line 714 command injection.
# - Generate a dedicated launcher script in ~/.local/state/plasmactl/ and run that from tmux.
# - Keep Sunshine considered healthy only after PID + required TCP listeners are up.
#
# v0.2.8 regression:
# - Attempted SUNSHINE_ARGS=--cmd, but this Sunshine build treats cmd as an unknown command and exits rc=7.
#
# v0.2.9 hotfix:
# - Revert default Sunshine launch to plain /usr/bin/sunshine, the last known listener-good mode.
# - Keep SUNSHINE_ARGS config knob, but auto-ignore --cmd/--no-tray style args that break this build.
# - This version is a stable automation baseline; it does not claim to solve the later Initial Ping Timeout.
#
# v0.3.0 changes:
# - Adds a Sunshine SAFE profile to isolate stream failures from user config.
# - SAFE profile disables tray/notifications, disables HEVC/AV1 advertisement, caps bitrate, and uses software H.264 first.
# - SAFE profile uses a clean apps file without xrandr/prep commands.
# - Adds an optional tmux supervisor loop to auto-restart Sunshine after SIGTRAP/crash so the host does not stay offline.
# - Adds sunshine-safe and config-snapshot commands for repeatable diagnosis.
#
# v0.3.1 hotfix:
# - Activates the real tty2/seat0 session before launching Plasma so KMS capture does not stream tty1/getty.
# - Adds active VT/session diagnostics to status/doctor/list.
# - Supports loginctl activate first, with optional sudo chvt fallback.
#
# v0.3.2 changes:
# - Stop can lock the attached tmux session and optionally switch back to an idle/locked VT.
# - Adds safe and performance Sunshine profile generation with centralized plasmactl profile manifest.
# - Adds optional setup/firstrun helper for fresh installs.
# - Keeps v0.3.1 start path intact; no change to the working KMS/tty2 activation flow.
#
# v0.3.6 changes:
# - Adds optional JSON overlay config for repo-friendly deployments: ~/.config/plasmactl/config.json.
# - Adds explicit DRM driver ordering/requirement knobs so headless EDID can be pinned to iGPU or allowed to fall back to dGPU.
# - Aligns Sunshine adapter_name with the selected DRM card render node by default, avoiding stale adapter_name from old Sunshine configs.
# - Adds headless-edid install-limine helper for CachyOS/Limine forced-EDID deployment.
#
# v0.3.7 changes:
# - Adds explicit GPU role selection: igpu/dgpu/auto with default iGPU for this use case.
# - Adds --gpu=igpu|dgpu|auto, --igpu, --dgpu start overrides without editing config.
# - Enforces iGPU-only/dGPU-only role when fallback is disabled, preventing silent use of the wrong GPU.
# - Adds gpu-assert to verify selected DRM/render/driver and running KWin/Sunshine GPU alignment.
# - Adds config-template and sanity commands for repo bootstrap and post-boot validation.
#
# v0.3.8 hotfix:
# - Adds Sunshine output_name pinning so KMS capture follows the selected KWin/Wayland output instead of a connected dGPU dummy.
# - Adds strict Sunshine GPU log assertion; iGPU mode fails if Sunshine captures/encodes on AMD.
# - Exports LIBVA_DRIVER_NAME=iHD for iGPU runs by default, configurable.
#
# v0.4.0 architecture:
# - Keeps Plasma/KWin in the tty2/tmux session, but runs Sunshine via transient root systemd-run by default.
# - Uses DevicePolicy=closed + DeviceAllow for the selected card/render node so Sunshine cannot capture the wrong GPU.
# - Grants the transient Sunshine unit the KMS/capture capability path that worked on i915 headless.
# - Default GPU remains iGPU; --dgpu/--igpu still override per start/restart/sanity.
#
# v0.4.1 hotfix:
# - Do not kill a working transient Sunshine unit because the initial /proc fd assert runs before first launch/capture.
# - Default systemd-run assertion mode is journal/soft; selected-GPU proof comes from Sunshine KMS/VAAPI journal lines.
# - Keep FD checks as diagnostics/warnings unless SUNSHINE_SYSTEMD_ASSERT_MODE=strict.
#
# v0.4.2 consolidation:
# - Adds confirm-gpu/confirm-igpu/confirm-dgpu for runtime proof tagged as confirm:igpu or confirm:dgpu.
# - Lists KWin/Sunshine DRM fds and visible processes using each selected GPU.
# - Fixes stray warn() call from v0.4.1 and rejects common typo -dgpu/-igpu with a clear message.
# - Updates config-template defaults for systemd-run isolation and H.264-only iGPU baseline.

set -euo pipefail

VERSION="0.4.2"
VERBOSE=false
FIX_MODE=false

# ─────────────────────────────────────────────────────────────────────────────
# USER CONTEXT
# ─────────────────────────────────────────────────────────────────────────────

if [[ -n "${SUDO_USER:-}" ]]; then
    REAL_USER="${SUDO_USER}"
    REAL_HOME="$(getent passwd "${SUDO_USER}" | cut -d: -f6)"
else
    REAL_USER="${USER}"
    REAL_HOME="${HOME}"
fi
REAL_UID="$(id -u "${REAL_USER}" 2>/dev/null || echo "${UID}")"
RUNTIME_DIR="/run/user/${REAL_UID}"

# ─────────────────────────────────────────────────────────────────────────────
# CONFIG
# ─────────────────────────────────────────────────────────────────────────────

CONFIG_DIR="${REAL_HOME}/.config"
CONFIG_FILE="${CONFIG_DIR}/plasmactl.conf"
PLASMACTL_JSON_CONFIG="${PLASMACTL_JSON_CONFIG:-${CONFIG_DIR}/plasmactl/config.json}"
PLASMACTL_USE_JSON_CONFIG="${PLASMACTL_USE_JSON_CONFIG:-auto}" # auto|true|false

# Defaults. Can be overridden in ~/.config/plasmactl.conf or env.
SESSION="${SESSION:-plasma}"
TTY_NAME="${TTY_NAME:-tty2}"
ACTIVATE_TTY_ON_START="${ACTIVATE_TTY_ON_START:-true}"
REQUIRE_ACTIVE_TTY_ON_START="${REQUIRE_ACTIVE_TTY_ON_START:-true}"
TTY_ACTIVATE_TIMEOUT="${TTY_ACTIVATE_TIMEOUT:-8}"

# Stop/idle security behavior. Defaults are conservative: lock the visible tmux client,
# do not kill the main tty2 tmux session unless explicitly requested.
LOCK_TMUX_ON_STOP="${LOCK_TMUX_ON_STOP:-true}"
KILL_TMUX_ON_STOP="${KILL_TMUX_ON_STOP:-false}"
TERMINATE_TTY_SESSION_ON_STOP="${TERMINATE_TTY_SESSION_ON_STOP:-false}"
RETURN_TTY_ON_STOP="${RETURN_TTY_ON_STOP:-true}"
RETURN_TTY_NAME="${RETURN_TTY_NAME:-${TTY_NAME}}"
STOP_TTY_ACTIVATE_TIMEOUT="${STOP_TTY_ACTIVATE_TIMEOUT:-5}"
SUNSHINE_UNIT="${SUNSHINE_UNIT:-app-dev.lizardbyte.app.Sunshine.service}"
PLASMA_DRM_DEVICE="${PLASMA_DRM_DEVICE:-auto}"      # auto | /dev/dri/cardN
PLASMA_DRM_DEVICE_AUTO_FALLBACK="${PLASMA_DRM_DEVICE_AUTO_FALLBACK:-true}" # if configured card disappears, auto-detect instead of hard failing
PLASMA_DRM_DRIVER_ORDER="${PLASMA_DRM_DRIVER_ORDER:-i915 xe amdgpu}" # auto-detect order; set amdgpu first if forced EDID lands on dGPU
PLASMA_DRM_REQUIRE_DRIVER="${PLASMA_DRM_REQUIRE_DRIVER:-}" # optional hard pin: i915|xe|amdgpu
# GPU role policy. Default is iGPU because this host should keep the dGPU free/unused for this session.
# Override one run with: plasmactl --gpu=dgpu start  OR  plasmactl --dgpu start
PLASMA_GPU_DEFAULT="${PLASMA_GPU_DEFAULT:-igpu}"        # igpu | dgpu | auto
PLASMA_GPU_OVERRIDE="${PLASMA_GPU_OVERRIDE:-}"          # runtime only; normally set by --gpu/--igpu/--dgpu
PLASMA_GPU_ALLOW_FALLBACK="${PLASMA_GPU_ALLOW_FALLBACK:-false}" # false = never silently fall back to another GPU role
PLASMA_GPU_IGPU_DRIVERS="${PLASMA_GPU_IGPU_DRIVERS:-i915 xe}"
PLASMA_GPU_DGPU_DRIVERS="${PLASMA_GPU_DGPU_DRIVERS:-amdgpu nvidia nouveau}"
PLASMA_GPU_FORBID_DRIVERS="${PLASMA_GPU_FORBID_DRIVERS:-}"
ALLOW_VKMS="${ALLOW_VKMS:-false}"                  # true only if you explicitly want VKMS fallback
HEADLESS_MODE="${HEADLESS_MODE:-none}"              # none | kernel-forced-edid | vkms (diagnostic label only)
HEADLESS_FORCE_OUTPUT="${HEADLESS_FORCE_OUTPUT:-HDMI-A-1}"
HEADLESS_FORCE_MODE="${HEADLESS_FORCE_MODE:-1920x1080@60}"
HEADLESS_EDID_FILE="${HEADLESS_EDID_FILE:-white_1080p.bin}"
REQUIRE_CONNECTED_OUTPUT_ON_START="${REQUIRE_CONNECTED_OUTPUT_ON_START:-true}" # fail early if selected DRM has no connected KMS connector
SUNSHINE_RESTART_ON_START="${SUNSHINE_RESTART_ON_START:-true}"
SUNSHINE_START_MODE="${SUNSHINE_START_MODE:-systemd-run}"      # systemd-run | tmux | systemd | auto
SUNSHINE_ARGS="${SUNSHINE_ARGS-}"                  # default empty; --cmd is unsupported by this Sunshine build
SUNSHINE_PROFILE="${SUNSHINE_PROFILE:-safe}"               # normal | safe | performance
SUNSHINE_CONFIG_PATH="${SUNSHINE_CONFIG_PATH:-}"           # explicit Sunshine config file; overrides profile
SUNSHINE_ADAPTER_MODE="${SUNSHINE_ADAPTER_MODE:-auto}" # auto|selected|preserve|path|disabled
SUNSHINE_ADAPTER_NAME="${SUNSHINE_ADAPTER_NAME:-}"         # explicit adapter_name when SUNSHINE_ADAPTER_MODE=path or non-empty override
# Sunshine can choose the wrong KMS card when both iGPU and dGPU have connected outputs.
# output_name is a Sunshine display id; with this tmux/KWin architecture the selected compositor output is normally id 0.
SUNSHINE_OUTPUT_MODE="${SUNSHINE_OUTPUT_MODE:-disabled}"   # selected|preserve|path|disabled
SUNSHINE_OUTPUT_NAME="${SUNSHINE_OUTPUT_NAME:-}"           # Sunshine output_name id/name; disabled by default
SUNSHINE_STRICT_GPU_ASSERT="${SUNSHINE_STRICT_GPU_ASSERT:-false}" # opt-in fail if Sunshine logs show capture/encode on the wrong GPU
SUNSHINE_IGPU_LIBVA_DRIVER_NAME="${SUNSHINE_IGPU_LIBVA_DRIVER_NAME:-iHD}" # Gen9+ Intel VAAPI driver for systemd-run iGPU mode
SUNSHINE_DGPU_LIBVA_DRIVER_NAME="${SUNSHINE_DGPU_LIBVA_DRIVER_NAME:-}" # empty lets Mesa pick AMD radeonsi when dGPU is selected
SUNSHINE_SYSTEMD_UNIT_PREFIX="${SUNSHINE_SYSTEMD_UNIT_PREFIX:-sunshine-plasmactl}"
SUNSHINE_SYSTEMD_ISOLATE_DRI="${SUNSHINE_SYSTEMD_ISOLATE_DRI:-true}"
SUNSHINE_SYSTEMD_REQUIRE_CAP_SYS_ADMIN="${SUNSHINE_SYSTEMD_REQUIRE_CAP_SYS_ADMIN:-true}"
SUNSHINE_SYSTEMD_DEVICE_ALLOW_UINPUT="${SUNSHINE_SYSTEMD_DEVICE_ALLOW_UINPUT:-true}"
SUNSHINE_SYSTEMD_ASSERT_MODE="${SUNSHINE_SYSTEMD_ASSERT_MODE:-journal}" # off|journal|strict
SUNSHINE_SYSTEMD_FD_ASSERT_STRICT="${SUNSHINE_SYSTEMD_FD_ASSERT_STRICT:-false}"
SUNSHINE_SUPERVISE="${SUNSHINE_SUPERVISE:-true}"           # restart Sunshine after crash inside tmux launcher
SUNSHINE_SUPERVISE_MAX_RESTARTS="${SUNSHINE_SUPERVISE_MAX_RESTARTS:-5}"  # 0 = unlimited
SUNSHINE_SUPERVISE_RESTART_DELAY="${SUNSHINE_SUPERVISE_RESTART_DELAY:-2}"
SUNSHINE_SAFE_ENCODER="${SUNSHINE_SAFE_ENCODER:-software}" # software first to isolate VAAPI/KMS bugs
SUNSHINE_SAFE_CAPTURE="${SUNSHINE_SAFE_CAPTURE:-kms}"
SUNSHINE_SAFE_MAX_BITRATE="${SUNSHINE_SAFE_MAX_BITRATE:-30000}"
SUNSHINE_SAFE_FPS_TARGET="${SUNSHINE_SAFE_FPS_TARGET:-60}"
SUNSHINE_SAFE_QP="${SUNSHINE_SAFE_QP:-23}"
SUNSHINE_SAFE_FEC="${SUNSHINE_SAFE_FEC:-20}"
SUNSHINE_PERF_ENCODER="${SUNSHINE_PERF_ENCODER:-vaapi}"
SUNSHINE_PERF_CAPTURE="${SUNSHINE_PERF_CAPTURE:-kms}"
SUNSHINE_PERF_MAX_BITRATE="${SUNSHINE_PERF_MAX_BITRATE:-20000}"
SUNSHINE_PERF_FPS_TARGET="${SUNSHINE_PERF_FPS_TARGET:-60}"
SUNSHINE_PERF_QP="${SUNSHINE_PERF_QP:-15}"
SUNSHINE_PERF_FEC="${SUNSHINE_PERF_FEC:-5}"
SUNSHINE_PERF_HEVC_MODE="${SUNSHINE_PERF_HEVC_MODE:-1}"   # 0=auto by encoder capability; 1=force H264-only; 2=force HEVC Main
SUNSHINE_PERF_AV1_MODE="${SUNSHINE_PERF_AV1_MODE:-1}"     # UHD 630 has no AV1 encode; keep disabled
SUNSHINE_PERF_MIN_THREADS="${SUNSHINE_PERF_MIN_THREADS:-2}"
SUNSHINE_PERF_VAAPI_STRICT_RC_BUFFER="${SUNSHINE_PERF_VAAPI_STRICT_RC_BUFFER:-disabled}"
SUNSHINE_PERF_VK_RC_MODE="${SUNSHINE_PERF_VK_RC_MODE:-1}" # only applies if encoder=vulkan; 1=CQP
SUNSHINE_SAFE_PING_TIMEOUT="${SUNSHINE_SAFE_PING_TIMEOUT:-30000}"
SUNSHINE_WINDOW="${SUNSHINE_WINDOW:-sunshine}"
SUNSHINE_TCP_PORTS="${SUNSHINE_TCP_PORTS:-47984 47989 47990 48010}"
SUNSHINE_REQUIRED_TCP_PORTS="${SUNSHINE_REQUIRED_TCP_PORTS:-47990 48010}"
WAIT_SUNSHINE_PORTS="${WAIT_SUNSHINE_PORTS:-20}"
WAIT_KWIN="${WAIT_KWIN:-45}"
WAIT_WAYLAND="${WAIT_WAYLAND:-30}"
WAIT_PLASMA="${WAIT_PLASMA:-45}"
WAIT_SUNSHINE="${WAIT_SUNSHINE:-30}"
WAIT_STOP="${WAIT_STOP:-15}"

if [[ -f "${CONFIG_FILE}" ]]; then
    # shellcheck disable=SC1090
    source "${CONFIG_FILE}"
fi

# Optional repo-friendly JSON overlay. The classic .conf remains the stable runtime
# source of truth; JSON is an optional override layer for deployments that prefer
# a single structured config file. Requires jq; ignored safely when absent.
_apply_json_scalar() {
    local var="$1" jqpath="$2" val
    command -v jq >/dev/null 2>&1 || return 0
    [[ -f "${PLASMACTL_JSON_CONFIG}" ]] || return 0
    val="$(jq -er "${jqpath} // empty" "${PLASMACTL_JSON_CONFIG}" 2>/dev/null || true)"
    [[ -n "${val}" && "${val}" != "null" ]] || return 0
    printf -v "${var}" '%s' "${val}"
}

if [[ "${PLASMACTL_USE_JSON_CONFIG}" != "false" && -f "${PLASMACTL_JSON_CONFIG}" ]]; then
    if command -v jq >/dev/null 2>&1; then
        _apply_json_scalar PLASMA_DRM_DEVICE '.drm.device'
        _apply_json_scalar PLASMA_DRM_DEVICE_AUTO_FALLBACK '.drm.auto_fallback'
        _apply_json_scalar PLASMA_DRM_DRIVER_ORDER '.drm.driver_order | if type=="array" then join(" ") else . end'
        _apply_json_scalar PLASMA_DRM_REQUIRE_DRIVER '.drm.require_driver'
        _apply_json_scalar PLASMA_GPU_DEFAULT '.drm.gpu_default'
        _apply_json_scalar PLASMA_GPU_ALLOW_FALLBACK '.drm.gpu_allow_fallback'
        _apply_json_scalar PLASMA_GPU_IGPU_DRIVERS '.drm.gpu_roles.igpu.drivers | if type=="array" then join(" ") else . end'
        _apply_json_scalar PLASMA_GPU_DGPU_DRIVERS '.drm.gpu_roles.dgpu.drivers | if type=="array" then join(" ") else . end'
        _apply_json_scalar PLASMA_GPU_FORBID_DRIVERS '.drm.forbid_drivers | if type=="array" then join(" ") else . end'
        _apply_json_scalar REQUIRE_CONNECTED_OUTPUT_ON_START '.drm.require_connected_output_on_start'
        _apply_json_scalar ALLOW_VKMS '.drm.allow_vkms'
        _apply_json_scalar HEADLESS_MODE '.headless.mode'
        _apply_json_scalar HEADLESS_FORCE_OUTPUT '.headless.force_output'
        _apply_json_scalar HEADLESS_FORCE_MODE '.headless.force_mode'
        _apply_json_scalar HEADLESS_EDID_FILE '.headless.edid_file'
        _apply_json_scalar ACTIVATE_TTY_ON_START '.tty.activate_on_start'
        _apply_json_scalar REQUIRE_ACTIVE_TTY_ON_START '.tty.require_active_on_start'
        _apply_json_scalar LOCK_TMUX_ON_STOP '.stop.lock_tmux'
        _apply_json_scalar KILL_TMUX_ON_STOP '.stop.kill_tmux'
        _apply_json_scalar TERMINATE_TTY_SESSION_ON_STOP '.stop.terminate_tty_session'
        _apply_json_scalar RETURN_TTY_ON_STOP '.stop.return_tty'
        _apply_json_scalar RETURN_TTY_NAME '.stop.return_tty_name'
        _apply_json_scalar SUNSHINE_PROFILE '.sunshine.profile'
        _apply_json_scalar SUNSHINE_START_MODE '.sunshine.start_mode'
        _apply_json_scalar SUNSHINE_SYSTEMD_UNIT_PREFIX '.sunshine.systemd.unit_prefix'
        _apply_json_scalar SUNSHINE_SYSTEMD_ISOLATE_DRI '.sunshine.systemd.isolate_dri'
        _apply_json_scalar SUNSHINE_SYSTEMD_REQUIRE_CAP_SYS_ADMIN '.sunshine.systemd.require_cap_sys_admin'
        _apply_json_scalar SUNSHINE_SYSTEMD_DEVICE_ALLOW_UINPUT '.sunshine.systemd.device_allow_uinput'
        _apply_json_scalar SUNSHINE_SUPERVISE '.sunshine.supervise'
        _apply_json_scalar SUNSHINE_ADAPTER_MODE '.sunshine.adapter.mode'
        _apply_json_scalar SUNSHINE_ADAPTER_NAME '.sunshine.adapter.name'
        _apply_json_scalar SUNSHINE_OUTPUT_MODE '.sunshine.output.mode'
        _apply_json_scalar SUNSHINE_OUTPUT_NAME '.sunshine.output.name'
        _apply_json_scalar SUNSHINE_STRICT_GPU_ASSERT '.sunshine.strict_gpu_assert'
        _apply_json_scalar SUNSHINE_SYSTEMD_ASSERT_MODE '.sunshine.systemd.assert_mode'
        _apply_json_scalar SUNSHINE_SYSTEMD_FD_ASSERT_STRICT '.sunshine.systemd.fd_assert_strict'
        _apply_json_scalar SUNSHINE_IGPU_LIBVA_DRIVER_NAME '.sunshine.igpu_libva_driver_name'
        _apply_json_scalar SUNSHINE_DGPU_LIBVA_DRIVER_NAME '.sunshine.dgpu_libva_driver_name'
        _apply_json_scalar SUNSHINE_PERF_ENCODER '.profiles.performance.encoder'
        _apply_json_scalar SUNSHINE_PERF_CAPTURE '.profiles.performance.capture'
        _apply_json_scalar SUNSHINE_PERF_MAX_BITRATE '.profiles.performance.max_bitrate'
        _apply_json_scalar SUNSHINE_PERF_QP '.profiles.performance.qp'
        _apply_json_scalar SUNSHINE_PERF_FEC '.profiles.performance.fec_percentage'
        _apply_json_scalar SUNSHINE_PERF_FPS_TARGET '.profiles.performance.fps_target'
        _apply_json_scalar SUNSHINE_PERF_HEVC_MODE '.profiles.performance.hevc_mode'
        _apply_json_scalar SUNSHINE_PERF_AV1_MODE '.profiles.performance.av1_mode'
        _apply_json_scalar SUNSHINE_PERF_VAAPI_STRICT_RC_BUFFER '.profiles.performance.vaapi_strict_rc_buffer'
        _apply_json_scalar SUNSHINE_SAFE_ENCODER '.profiles.safe.encoder'
        _apply_json_scalar SUNSHINE_SAFE_CAPTURE '.profiles.safe.capture'
        _apply_json_scalar SUNSHINE_SAFE_MAX_BITRATE '.profiles.safe.max_bitrate'
        _apply_json_scalar SUNSHINE_SAFE_QP '.profiles.safe.qp'
        _apply_json_scalar SUNSHINE_SAFE_FEC '.profiles.safe.fec_percentage'
        _apply_json_scalar SUNSHINE_SAFE_FPS_TARGET '.profiles.safe.fps_target'
    else
        echo "[plasmactl] JSON config exists but jq is not installed; ignoring ${PLASMACTL_JSON_CONFIG}" >&2
    fi
fi

