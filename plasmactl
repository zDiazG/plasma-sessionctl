cmd_headless_check() {
    _LOG_CTX="headless-check"
    echo "=== plasmactl headless-check v${VERSION} ==="
    echo "Config: ${CONFIG_FILE}"
    echo "PLASMA_DRM_DEVICE=${PLASMA_DRM_DEVICE}"
    echo "PLASMA_DRM_DEVICE_AUTO_FALLBACK=${PLASMA_DRM_DEVICE_AUTO_FALLBACK}"
    echo "ALLOW_VKMS=${ALLOW_VKMS}"
    echo "PLASMA_GPU_DEFAULT=${PLASMA_GPU_DEFAULT}"
    echo "PLASMA_GPU_OVERRIDE=${PLASMA_GPU_OVERRIDE:-none}"
    echo "PLASMA_GPU_ALLOW_FALLBACK=${PLASMA_GPU_ALLOW_FALLBACK}"
    echo "PLASMA_GPU_IGPU_DRIVERS=${PLASMA_GPU_IGPU_DRIVERS}"
    echo "PLASMA_GPU_DGPU_DRIVERS=${PLASMA_GPU_DGPU_DRIVERS}"
    echo "HEADLESS_MODE=${HEADLESS_MODE}"
    echo "HEADLESS_FORCE_OUTPUT=${HEADLESS_FORCE_OUTPUT}"
    echo "HEADLESS_FORCE_MODE=${HEADLESS_FORCE_MODE}"
    echo "HEADLESS_EDID_FILE=${HEADLESS_EDID_FILE}"
    echo "REQUIRE_CONNECTED_OUTPUT_ON_START=${REQUIRE_CONNECTED_OUTPUT_ON_START}"
    echo ""
    echo "=== kernel cmdline ==="
    cat /proc/cmdline 2>/dev/null || true
    echo ""
    echo "=== DRM cards ==="
    resolve_plasma_drm_device >/dev/null 2>&1 || true
    _print_drm_map
    echo ""
    echo "=== DRM connectors ==="
    local connector name status modes connected_count=0
    shopt -s nullglob
    for connector in /sys/class/drm/card[0-9]*-*; do
        [[ -f "${connector}/status" ]] || continue
        name="$(basename "${connector}")"
        status="$(tr -d '[:space:]' < "${connector}/status" 2>/dev/null || echo unknown)"
        [[ "${status}" == "connected" ]] && connected_count=$((connected_count+1))
        printf '  %-24s status=%s\n' "${name}" "${status}"
        if [[ -r "${connector}/modes" ]]; then
            modes="$(head -5 "${connector}/modes" 2>/dev/null | paste -sd ',' -)"
            [[ -n "${modes}" ]] && printf '    modes: %s\n' "${modes}"
        fi
    done
    shopt -u nullglob
    echo ""
    if [[ "${connected_count}" -gt 0 ]]; then
        echo "Result: at least one DRM connector is connected. Physical/dummy-output KMS capture path is viable."
    else
        cat <<EOF_HEADLESS
Result: no DRM connector reports connected.

For this Plasma+KWin+Sunshine KMS architecture, a real streamable desktop needs an active KMS output/CRTC.
Without a monitor/dummy, the script can start pieces of the session, but it cannot invent a real iGPU output for KMS capture by itself.

Viable headless options:
  1) Recommended/reliable: HDMI/DP dummy plug on the iGPU.
  2) Possible but kernel/BIOS-dependent: force a connector and EDID at boot.
     First identify the connector name when a monitor is attached, e.g. HDMI-A-1 from /sys/class/drm/card*-HDMI-A-1.
     Then use kernel parameters similar to:
       drm.edid_firmware=${HEADLESS_FORCE_OUTPUT}:edid/${HEADLESS_EDID_FILE} video=${HEADLESS_FORCE_OUTPUT}:${HEADLESS_FORCE_MODE}e
     The EDID file must exist under /usr/lib/firmware/edid/ or /lib/firmware/edid/ and initramfs may need rebuilding.
  3) Different architecture: VKMS/virtual display. This is not the same as the current iGPU KMS path and may require separate Sunshine/Plasma tuning.

Current best config for physical/dummy output:
  PLASMA_DRM_DEVICE=auto
  PLASMA_DRM_DEVICE_AUTO_FALLBACK=true
EOF_HEADLESS
    fi
}


cmd_headless_edid() {
    _LOG_CTX="headless-edid"
    local sub="${2:-status}" connector_arg="${3:-}" file_arg="${4:-}" connector sysfs short edid_file dest mode params
    edid_file="${file_arg:-${HEADLESS_EDID_FILE}}"
    mode="${HEADLESS_FORCE_MODE}"

    case "${sub}" in
        status)
            echo "=== plasmactl headless-edid status v${VERSION} ==="
            echo "HEADLESS_FORCE_OUTPUT=${HEADLESS_FORCE_OUTPUT}"
            echo "HEADLESS_FORCE_MODE=${HEADLESS_FORCE_MODE}"
            echo "HEADLESS_EDID_FILE=${HEADLESS_EDID_FILE}"
            echo ""
            echo "=== connected connectors ==="
            local c any=0 p st size
            for p in /sys/class/drm/card[0-9]*-*; do
                [[ -f "${p}/status" ]] || continue
                st="$(tr -d '[:space:]' < "${p}/status" 2>/dev/null || echo unknown)"
                [[ "${st}" == "connected" ]] || continue
                any=1
                c="$(basename "${p}")"
                size="0"
                [[ -r "${p}/edid" ]] && size="$(wc -c < "${p}/edid" 2>/dev/null || echo 0)"
                printf '  %-24s short=%-12s edid_bytes=%s\n' "${c}" "$(_connector_short_name "${c}")" "${size}"
                [[ -r "${p}/modes" ]] && head -5 "${p}/modes" | sed 's/^/    mode: /'
            done
            [[ "${any}" == "1" ]] || echo "  (none)"
            echo ""
            echo "=== installed EDID files ==="
            ls -lh /usr/lib/firmware/edid 2>/dev/null || echo "  (none under /usr/lib/firmware/edid)"
            echo ""
            cmd_headless_edid "headless-edid" params
            ;;
        params)
            short="${connector_arg:-${HEADLESS_FORCE_OUTPUT}}"
            short="$(_connector_short_name "${short}")"
            params="drm.edid_firmware=${short}:edid/${HEADLESS_EDID_FILE} video=${short}:${HEADLESS_FORCE_MODE}e"
            echo "Kernel params for forced EDID:"
            echo "  ${params}"
            echo ""
            echo "mkinitcpio FILES entry:"
            echo "  FILES=(/usr/lib/firmware/edid/${HEADLESS_EDID_FILE})"
            echo ""
            echo "After applying bootloader params and mkinitcpio, reboot and verify:"
            echo "  plasmactl headless-check"
            ;;
        capture)
            connector="${connector_arg:-$(_first_connected_connector || true)}"
            [[ -n "${connector}" ]] || { err "No connected connector found to capture EDID from. Connect a monitor/dummy first."; return 1; }
            sysfs="$(_connector_sysfs_path "${connector}" || true)"
            [[ -n "${sysfs}" && -r "${sysfs}/edid" ]] || { err "EDID not readable for connector ${connector}"; return 1; }
            local bytes
            bytes="$(wc -c < "${sysfs}/edid" 2>/dev/null || echo 0)"
            [[ "${bytes}" -gt 0 ]] || { err "Connector ${connector} has empty EDID."; return 1; }
            short="$(_connector_short_name "$(basename "${sysfs}")")"
            dest="/usr/lib/firmware/edid/${edid_file}"
            log "Capturing EDID from $(basename "${sysfs}") (${short}, ${bytes} bytes) to ${dest}..."
            sudo mkdir -p /usr/lib/firmware/edid
            sudo cp "${sysfs}/edid" "${dest}"
            sudo chmod 0644 "${dest}"
            echo "Captured: ${dest}"
            echo ""
            echo "Recommended ~/.config/plasmactl.conf entries:"
            echo "  HEADLESS_MODE=kernel-forced-edid"
            echo "  HEADLESS_FORCE_OUTPUT=${short}"
            echo "  HEADLESS_FORCE_MODE=${HEADLESS_FORCE_MODE}"
            echo "  HEADLESS_EDID_FILE=${edid_file}"
            echo ""
            echo "Recommended kernel params:"
            echo "  drm.edid_firmware=${short}:edid/${edid_file} video=${short}:${HEADLESS_FORCE_MODE}e"
            echo ""
            echo "Remember to include the EDID in initramfs if your distro needs it:"
            echo "  FILES=(/usr/lib/firmware/edid/${edid_file})"
            echo "  sudo mkinitcpio -P"
            ;;
        install-limine|apply-limine)
            short="${connector_arg:-${HEADLESS_FORCE_OUTPUT}}"
            short="$(_connector_short_name "${short}")"
            edid_file="${file_arg:-${HEADLESS_EDID_FILE}}"
            dest="/usr/lib/firmware/edid/${edid_file}"
            [[ -r "${dest}" ]] || { err "EDID file not found/readable: ${dest}. Run headless-edid capture first."; return 1; }
            params="drm.edid_firmware=${short}:edid/${edid_file} video=${short}:${HEADLESS_FORCE_MODE}e"
            echo "Applying Limine forced-EDID params: ${params}"
            if [[ ! -f /etc/default/limine ]]; then
                err "/etc/default/limine not found. This helper is only for CachyOS/Limine."
                return 1
            fi
            sudo cp /etc/default/limine "/etc/default/limine.bak.$(date +%Y%m%d-%H%M%S)"
            if ! grep -Fq "drm.edid_firmware=${short}:edid/${edid_file}" /etc/default/limine; then
                if grep -q '^KERNEL_CMDLINE\[default\]+=' /etc/default/limine; then
                    sudo sed -i "/^KERNEL_CMDLINE\[default\]+=/{s/"$/ ${params}"/}" /etc/default/limine
                else
                    printf 'KERNEL_CMDLINE[default]+="%s"
' "${params}" | sudo tee -a /etc/default/limine >/dev/null
                fi
            else
                echo "Limine already contains forced-EDID param."
            fi
            if [[ -f /etc/mkinitcpio.conf ]]; then
                sudo cp /etc/mkinitcpio.conf "/etc/mkinitcpio.conf.bak.$(date +%Y%m%d-%H%M%S)"
                if grep -q '^FILES=' /etc/mkinitcpio.conf; then
                    if ! grep -Fq "${dest}" /etc/mkinitcpio.conf; then
                        sudo sed -i -E "s|^FILES=\((.*)\)|FILES=(\1 ${dest})|" /etc/mkinitcpio.conf
                    fi
                else
                    printf 'FILES=(%s)
' "${dest}" | sudo tee -a /etc/mkinitcpio.conf >/dev/null
                fi
            else
                echo "WARN: /etc/mkinitcpio.conf not found; ensure EDID is included in initramfs by your distro tooling." >&2
            fi
            if command -v limine-mkinitcpio >/dev/null 2>&1; then
                sudo limine-mkinitcpio
            else
                sudo mkinitcpio -P
            fi
            echo "Done. Reboot without monitor and run: plasmactl headless-check && plasmactl start --verbose"
            ;;
        *)
            cat <<EOF_EDID_USAGE
Usage:
  plasmactl headless-edid status
  plasmactl headless-edid params [HDMI-A-1]
  plasmactl headless-edid capture [card1-HDMI-A-1|HDMI-A-1] [white_1080p.bin]
  plasmactl headless-edid install-limine [HDMI-A-1] [white_1080p.bin]

Notes:
  capture requires a real monitor/dummy connected once, so the kernel can expose a valid EDID.
  This command copies EDID into /usr/lib/firmware/edid/ and prints kernel parameters.
  It does not blindly edit your bootloader, because CachyOS setups may use Limine, GRUB, or systemd-boot.
EOF_EDID_USAGE
            return 1
            ;;
    esac
}


