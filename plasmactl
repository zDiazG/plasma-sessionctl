# ─────────────────────────────────────────────────────────────────────────────
# LOGGING & SYSLOG INTEGRATION
# ─────────────────────────────────────────────────────────────────────────────

_ts() { date '+%Y-%m-%d %H:%M:%S'; }

log() {
    local msg="[${_LOG_CTX:-plasmactl}] $(_ts) $*"
    echo "${msg}"
    echo "${msg}" >> "${LAST_LOG}"
}

vlog() {
    local msg="[${_LOG_CTX:-plasmactl}] $(_ts) [v] $*"
    ${VERBOSE} && echo "${msg}" || true
    echo "${msg}" >> "${LAST_LOG}"
}

err() {
    local msg="[${_LOG_CTX:-plasmactl}] $(_ts) ERROR: $*"
    echo "${msg}" >&2
    echo "${msg}" >> "${LAST_LOG}"
    logger -p user.err -t "plasmactl" "$*" 2>/dev/null || true
}

_pass() { printf '  \033[1;32m✓\033[0m %s\n' "$*"; }
_fail() { printf '  \033[1;31m✗\033[0m %s\n' "$*"; }
_warn() { printf '  \033[1;33m!\033[0m %s\n' "$*"; }
_info() { printf '  \033[1;34m→\033[0m %s\n' "$*"; }

# ─────────────────────────────────────────────────────────────────────────────
# GENERAL HELPERS & LOCKING
# ─────────────────────────────────────────────────────────────────────────────

_bool_true() {
    case "${1:-}" in true|yes|1|on|enabled) return 0 ;; *) return 1 ;; esac
}

# Scope process queries strictly to the active target user REAL_UID
_pid_first() {
    local name="$1"
    pgrep -u "${REAL_UID}" -xo "${name}" 2>/dev/null || true
}

_pid_newest() {
    local name="$1"
    pgrep -u "${REAL_UID}" -xn "${name}" 2>/dev/null || true
}

_pid_env() {
    local pid="$1"
    [[ -n "${pid}" && -r "/proc/${pid}/environ" ]] || return 1
    tr '\0' '\n' < "/proc/${pid}/environ" 2>/dev/null
}

_escape_sq() {
    printf "%s" "$1" | sed "s/'/'\\\\''/g"
}

check_required_bins() {
    local missing=() bin
    for bin in "${REQUIRED_BINS[@]}"; do
        command -v "${bin}" >/dev/null 2>&1 || missing+=("${bin}")
    done
    if [[ ${#missing[@]} -gt 0 ]]; then
        err "Missing required binaries: ${missing[*]}"
        return 1
    fi
}

acquire_lock() {
    local holder=""
    command -v flock >/dev/null || { err "flock is required for lifecycle operations."; return 1; }
    if [[ -f "${LOCK_FILE}" ]]; then
        holder="$(cat "${LOCK_FILE}")" || return 1
        if [[ "${holder}" =~ ^[0-9]+$ ]] && kill -0 "${holder}" 2>/dev/null; then
            err "An older controller still holds the PID lock; wait for it to exit."
            return 1
        fi
    fi
    # Keep this inode in place. Unlinking a flock file permits a second lock
    # on a replacement inode while the first process is still working.
    exec {PLASMACTL_LOCK_FD}>>"${LOCK_FILE}" || return 1
    if ! flock -w 10 "${PLASMACTL_LOCK_FD}"; then
        exec {PLASMACTL_LOCK_FD}>&-
        unset PLASMACTL_LOCK_FD
        err "Timed out waiting for the lifecycle lock."
        return 1
    fi
    : > "${LOCK_FILE}"
    printf 'flock:%s\n' "$$" >&"${PLASMACTL_LOCK_FD}"
    trap release_lock EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
}

release_lock() {
    [[ -n "${PLASMACTL_LOCK_FD:-}" ]] || return 0
    flock -u "${PLASMACTL_LOCK_FD}"
    exec {PLASMACTL_LOCK_FD}>&-
    unset PLASMACTL_LOCK_FD
}

# ─────────────────────────────────────────────────────────────────────────────
# LOGINCTL / TMUX MANAGEMENT
# ─────────────────────────────────────────────────────────────────────────────

get_tty_session_id() {
    "${LOGINCTL_BIN}" list-sessions --no-legend 2>/dev/null | awk -v tty="${TTY_NAME}" '$7==tty {print $1; exit}'
}

check_tty_session() {
    [[ -n "$(get_tty_session_id)" ]]
}

check_tty_seat0() {
    local sid; sid="$(get_tty_session_id)"
    [[ -n "${sid}" ]] || return 1
    "${LOGINCTL_BIN}" show-session "${sid}" -p Seat --value 2>/dev/null | grep -qx 'seat0'
}

get_session_active_state() {
    local sid="$1"
    [[ -n "${sid}" ]] || return 1
    "${LOGINCTL_BIN}" show-session "${sid}" -p Active --value 2>/dev/null || true
}

get_active_session_id() {
    "${LOGINCTL_BIN}" show-seat seat0 -p ActiveSession --value 2>/dev/null | awk '{print $1}'
}

get_active_tty_name() {
    local active_sid tty=""
    active_sid="$(get_active_session_id || true)"
    if [[ -n "${active_sid}" ]]; then
        tty="$("${LOGINCTL_BIN}" show-session "${active_sid}" -p TTY --value 2>/dev/null || true)"
    fi
    if [[ -z "${tty}" && -r /sys/class/tty/tty0/active ]]; then
        tty="$(cat /sys/class/tty/tty0/active 2>/dev/null | awk '{print $NF}')"
    fi
    echo "${tty}"
}

check_tty_active() {
    local sid; sid="$(get_tty_session_id)"
    [[ -n "${sid}" ]] || return 1
    [[ "$(get_session_active_state "${sid}")" == "yes" ]]
}

_activate_tty_session() {
    local sid="$1" target_tty="${TTY_NAME}"
    [[ -n "${sid}" ]] || return 1

    log "Activating ${target_tty} session ${sid} on seat0 before Plasma/KMS capture..."

    if _sudo "${CHVT_BIN}" "${target_tty#tty}" >/dev/null 2>&1; then
        vlog "sudo -n ${CHVT_BIN} ${target_tty#tty}: OK"
    elif "${LOGINCTL_BIN}" activate "${sid}" >/dev/null 2>&1; then
        vlog "loginctl activate ${sid}: OK"
    else
        _warn "Could not switch active VT automatically. Configure passwordless sudo for chvt or run: sudo chvt ${target_tty#tty}"
    fi

    local waited active_tty active_state
    for ((waited=0; waited<TTY_ACTIVATE_TIMEOUT; waited++)); do
        active_state="$(get_session_active_state "${sid}")"
        active_tty="$(get_active_tty_name)"
        if [[ "${active_state}" == "yes" || "${active_tty}" == "${target_tty}" ]]; then
            log "Active VT: ${active_tty:-unknown}; ${target_tty} session Active=${active_state:-unknown}"
            return 0
        fi
        sleep 1
    done

    active_state="$(get_session_active_state "${sid}")"
    active_tty="$(get_active_tty_name)"
    _warn "${target_tty} is not active after ${TTY_ACTIVATE_TIMEOUT}s (active VT=${active_tty:-unknown}, session Active=${active_state:-unknown})"
    return 1
}

ensure_tty_active_for_kms() {
    local sid="$1"
    [[ "${ACTIVATE_TTY_ON_START}" == "true" ]] || return 0
    if check_tty_active; then
        log "${TTY_NAME} is already the active seat0 session"
        return 0
    fi
    _activate_tty_session "${sid}" && return 0
    if [[ "${REQUIRE_ACTIVE_TTY_ON_START}" == "true" ]]; then
        err "${TTY_NAME} is not active. KMS capture will stream the current VT/login screen instead of Plasma."
        echo "Fix once: echo '${REAL_USER} ALL=(root) NOPASSWD: ${CHVT_BIN}' | sudo tee /etc/sudoers.d/plasmactl-chvt" >&2
        echo "Then retry: plasmactl restart --verbose" >&2
        return 1
    fi
    return 0
}

check_tmux_session() {
    _run_as_user "${TMUX_BIN}" has-session -t "${SESSION}" 2>/dev/null || return 1
    _run_as_user "${TMUX_BIN}" list-windows -t "${SESSION}" >/dev/null 2>&1
}

check_tmux_attached() {
    check_tmux_session || return 1
    local attached
    attached="$(_run_as_user "${TMUX_BIN}" display-message -p -t "${SESSION}" '#{session_attached}' 2>/dev/null || echo 0)"
    [[ "${attached}" != "0" ]]
}

send_tmux_command() {
    local cmd="$1"
    _run_as_user "${TMUX_BIN}" send-keys -t "${SESSION}" C-c
    sleep 0.2
    _run_as_user "${TMUX_BIN}" send-keys -t "${SESSION}" "${cmd}" C-m
}

