cmd_headless_check() {
    _LOG_CTX="headless-check"
    echo "=== plasmactl headless-check v${VERSION} ==="
    echo "Config: ${CONFIG_FILE}"
    echo "PLASMA_DRM_DEVICE=${PLASMA_DRM_DEVICE}"
    echo "PLASMA_DRM_DEVICE_AUTO_FALLBACK=${PLASMA_DRM_DEVICE_AUTO_FALLBACK}"
    echo "ALLOW_VKMS=${ALLOW_VKMS}"
    echo "PLASMA_GPU_DEFAULT=${PLASMA_GPU_DEFAULT}"
    echo "HEADLESS_MODE=${HEADLESS_MODE}"
    echo "HEADLESS_FORCE_OUTPUT=${HEADLESS_FORCE_OUTPUT}"
    echo "HEADLESS_FORCE_MODE=${HEADLESS_FORCE_MODE}"
    echo "HEADLESS_EDID_FILE=${HEADLESS_EDID_FILE}"
    echo ""
    echo "=== kernel cmdline ==="
    cat /proc/cmdline 2>/dev/null || true
    echo ""
    echo "=== DRM cards ==="
    resolve_plasma_drm_device >/dev/null 2>&1 || true
    _print_drm_map
    echo ""
    echo "=== DRM connectors ==="
    local connector name status modes connected_count=0
    shopt -s nullglob
    for connector in /sys/class/drm/card[0-9]*-*; do
        [[ -f "${connector}/status" ]] || continue
        name="$(basename "${connector}")"
        status="$(tr -d '[:space:]' < "${connector}/status" 2>/dev/null || echo unknown)"
        [[ "${status}" == "connected" ]] && connected_count=$((connected_count+1))
        printf '  %-24s status=%s\n' "${name}" "${status}"
        if [[ -r "${connector}/modes" ]]; then
            modes="$(head -5 "${connector}/modes" 2>/dev/null | paste -sd ',' -)"
            [[ -n "${modes}" ]] && printf '    modes: %s\n' "${modes}"
        fi
    done
    shopt -u nullglob
    echo ""
    if [[ "${connected_count}" -gt 0 ]]; then
        echo "Result: at least one DRM connector is connected. Physical/dummy-output KMS capture path is viable."
    else
        cat <<EOF_HEADLESS
Result: no DRM connector reports connected.
For this Plasma+KWin+Sunshine KMS architecture, a connected KMS output/CRTC is required.

Viable headless options:
  1) Recommended: HDMI/DP dummy plug on target GPU.
  2) Force EDID via kernel parameters:
     drm.edid_firmware=${HEADLESS_FORCE_OUTPUT}:edid/${HEADLESS_EDID_FILE} video=${HEADLESS_FORCE_OUTPUT}:${HEADLESS_FORCE_MODE}e
EOF_HEADLESS
    fi
}

cmd_headless_edid() {
    _LOG_CTX="headless-edid"
    local sub="${2:-status}" connector_arg="${3:-}" file_arg="${4:-}" connector sysfs short edid_file dest mode params
    edid_file="${file_arg:-${HEADLESS_EDID_FILE}}"
    mode="${HEADLESS_FORCE_MODE}"

    case "${sub}" in
        status)
            echo "=== plasmactl headless-edid status v${VERSION} ==="
            echo "HEADLESS_FORCE_OUTPUT=${HEADLESS_FORCE_OUTPUT}"
            echo "HEADLESS_FORCE_MODE=${HEADLESS_FORCE_MODE}"
            echo "HEADLESS_EDID_FILE=${HEADLESS_EDID_FILE}"
            echo ""
            echo "=== connected connectors ==="
            local c any=0 p st size
            for p in /sys/class/drm/card[0-9]*-*; do
                [[ -f "${p}/status" ]] || continue
                st="$(tr -d '[:space:]' < "${p}/status" 2>/dev/null || echo unknown)"
                [[ "${st}" == "connected" ]] || continue
                any=1
                c="$(basename "${p}")"
                size="0"
                [[ -r "${p}/edid" ]] && size="$(wc -c < "${p}/edid" 2>/dev/null || echo 0)"
                printf '  %-24s short=%-12s edid_bytes=%s\n' "${c}" "$(_connector_short_name "${c}")" "${size}"
                [[ -r "${p}/modes" ]] && head -5 "${p}/modes" | sed 's/^/    mode: /'
            done
            [[ "${any}" == "1" ]] || echo "  (none)"
            echo ""
            echo "=== installed EDID files ==="
            ls -lh /usr/lib/firmware/edid 2>/dev/null || echo "  (none under /usr/lib/firmware/edid)"
            ;;
        params)
            short="${connector_arg:-${HEADLESS_FORCE_OUTPUT}}"
            short="$(_connector_short_name "${short}")"
            _validate_headless_edid_inputs "${short}" "${HEADLESS_FORCE_MODE}" "${HEADLESS_EDID_FILE}" || return $?
            params="drm.edid_firmware=${short}:edid/${HEADLESS_EDID_FILE} video=${short}:${HEADLESS_FORCE_MODE}e"
            echo "Kernel params for forced EDID:"
            echo "  ${params}"
            ;;
        capture)
            connector="${connector_arg:-$(_first_connected_connector || true)}"
            [[ -n "${connector}" ]] || { err "No connected connector found to capture EDID from."; return 1; }
            sysfs="$(_connector_sysfs_path "${connector}" || true)"
            [[ -n "${sysfs}" && -r "${sysfs}/edid" ]] || { err "EDID not readable for connector ${connector}"; return 1; }
            local bytes
            bytes="$(wc -c < "${sysfs}/edid" 2>/dev/null || echo 0)"
            [[ "${bytes}" -gt 0 ]] || { err "Connector ${connector} has empty EDID."; return 1; }
            short="$(_connector_short_name "$(basename "${sysfs}")")"
            _validate_headless_edid_inputs "${short}" "${HEADLESS_FORCE_MODE}" "${edid_file}" || return $?
            dest="/usr/lib/firmware/edid/${edid_file}"
            log "Capturing EDID from $(basename "${sysfs}") to ${dest}..."
            sudo mkdir -p /usr/lib/firmware/edid
            sudo cp "${sysfs}/edid" "${dest}"
            sudo chmod 0644 "${dest}"
            echo "Captured: ${dest}"
            ;;
        install-limine|apply-limine)
            short="${connector_arg:-${HEADLESS_FORCE_OUTPUT}}"
            short="$(_connector_short_name "${short}")"
            edid_file="${file_arg:-${HEADLESS_EDID_FILE}}"
            _validate_headless_edid_inputs "${short}" "${HEADLESS_FORCE_MODE}" "${edid_file}" || return $?
            dest="/usr/lib/firmware/edid/${edid_file}"
            [[ -r "${dest}" ]] || { err "EDID file not found: ${dest}. Run headless-edid capture first."; return 1; }
            params="drm.edid_firmware=${short}:edid/${edid_file} video=${short}:${HEADLESS_FORCE_MODE}e"
            echo "Applying Limine forced-EDID params: ${params}"
            if [[ ! -f /etc/default/limine ]]; then
                err "/etc/default/limine not found."
                return 1
            fi
            sudo cp /etc/default/limine "/etc/default/limine.bak.$(date +%Y%m%d-%H%M%S)"
            if ! grep -Fq "drm.edid_firmware=${short}:edid/${edid_file}" /etc/default/limine; then
                if grep -q '^KERNEL_CMDLINE\[default\]+=' /etc/default/limine; then
                    sudo sed -i "$(_limine_cmdline_sed_expression "${params}")" /etc/default/limine || return 1
                    grep -Fq -- "${params}" /etc/default/limine || { err "Could not verify Limine kernel parameters after editing."; return 1; }
                else
                    printf 'KERNEL_CMDLINE[default]+="%s"\n' "${params}" | sudo tee -a /etc/default/limine >/dev/null
                fi
            else
                echo "Limine configuration already contains forced-EDID param."
            fi
            ;;
        *)
            cat <<EOF_EDID_USAGE
Usage:
  plasmactl headless-edid status
  plasmactl headless-edid params [HDMI-A-1]
  plasmactl headless-edid capture [card1-HDMI-A-1|HDMI-A-1] [edid_1080p.bin]
  plasmactl headless-edid install-limine [HDMI-A-1] [edid_1080p.bin]
EOF_EDID_USAGE
            return 1
            ;;
    esac
}

