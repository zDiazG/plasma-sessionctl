_write_all_profile_assets() {
    _write_sunshine_safe_assets
    _write_sunshine_performance_assets
    _write_plasmactl_profile_manifest
}

_resolve_sunshine_config_effective() {
    SUNSHINE_CONFIG_EFFECTIVE=""
    case "${SUNSHINE_PROFILE}" in
        normal|default|"")
            [[ -n "${SUNSHINE_CONFIG_PATH}" ]] && SUNSHINE_CONFIG_EFFECTIVE="${SUNSHINE_CONFIG_PATH}"
            ;;
        safe)
            _write_sunshine_safe_assets
            _write_plasmactl_profile_manifest
            SUNSHINE_CONFIG_EFFECTIVE="${SUNSHINE_SAFE_CONFIG}"
            ;;
        performance|perf|max)
            _write_sunshine_performance_assets
            _write_plasmactl_profile_manifest
            SUNSHINE_CONFIG_EFFECTIVE="${SUNSHINE_PERF_CONFIG}"
            ;;
        *)
            err "Invalid SUNSHINE_PROFILE=${SUNSHINE_PROFILE}. Use: normal, safe, or performance."
            return 1
            ;;
    esac
}

_sunshine_command_line_for_log() {
    local cfg="${SUNSHINE_CONFIG_EFFECTIVE:-}" args="${SUNSHINE_ARGS_EFFECTIVE:-}"
    if [[ -n "${cfg}" ]]; then
        printf '%s %q %s' "${SUNSHINE_BIN}" "${cfg}" "${args}"
    else
        printf '%s %s' "${SUNSHINE_BIN}" "${args}"
    fi
}

_wait_sunshine_ready() {
    wait_for "sunshine process" "${WAIT_SUNSHINE}" check_sunshine_process || { _show_sunshine_failure; return 1; }
    wait_for "sunshine TCP listeners (${SUNSHINE_REQUIRED_TCP_PORTS})" "${WAIT_SUNSHINE_PORTS}" check_sunshine_required_tcp_ports || { _show_sunshine_failure; return 1; }
    local spid
    spid="$(_sunshine_newest_pid)"
    [[ -n "${spid}" ]] && echo "${spid}" > "${SUNSHINE_PID_FILE}"
    log "Sunshine: stream-ready${spid:+ (PID ${spid})}"
    _sunshine_listeners | sed 's/^/[sunshine-listener] /' || true
}

_journalctl_unit() {
    local unit="$1"; shift || true
    if [[ "${EUID}" -eq 0 ]]; then
        journalctl -u "${unit}" "$@" --no-pager 2>/dev/null || true
    else
        sudo -n journalctl -u "${unit}" "$@" --no-pager 2>/dev/null \
            || journalctl -u "${unit}" "$@" --no-pager 2>/dev/null \
            || true
    fi
}

_sunshine_systemd_unit_name() {
    local role
    role="$(_effective_gpu_role)"
    [[ "${role}" == "auto" || -z "${role}" ]] && role="$(_target_driver 2>/dev/null || echo auto)"
    echo "${SUNSHINE_SYSTEMD_UNIT_PREFIX}-${role}"
}

_sunshine_systemd_known_units() {
    printf '%s\n' \
        "${SUNSHINE_SYSTEMD_UNIT_PREFIX}.service" \
        "${SUNSHINE_SYSTEMD_UNIT_PREFIX}-igpu.service" \
        "${SUNSHINE_SYSTEMD_UNIT_PREFIX}-dgpu.service" \
        "${SUNSHINE_SYSTEMD_UNIT_PREFIX}-auto.service" \
        "sunshine-igpu-test.service" \
        "sunshine-dgpu-test.service"
}

_stop_sunshine_systemd_run() {
    local unit
    while read -r unit; do
        [[ -n "${unit}" ]] || continue
        if [[ "${EUID}" -eq 0 ]]; then
            "${SYSTEMCTL_BIN}" stop "${unit}" >/dev/null 2>&1 || true
            "${SYSTEMCTL_BIN}" reset-failed "${unit}" >/dev/null 2>&1 || true
        else
            sudo -n "${SYSTEMCTL_BIN}" stop "${unit}" >/dev/null 2>&1 || true
            sudo -n "${SYSTEMCTL_BIN}" reset-failed "${unit}" >/dev/null 2>&1 || true
        fi
    done < <(_sunshine_systemd_known_units)
}

_selected_render_node_plain() {
    local card_name r
    card_name="$(basename "${TARGET_DRM_DEVICE:-}" 2>/dev/null || true)"
    [[ -n "${card_name}" ]] || return 1
    for r in /sys/class/drm/${card_name}/device/drm/renderD*; do
        [[ -e "${r}" ]] || continue
        echo "/dev/dri/$(basename "${r}")"
        return 0
    done
    return 1
}

_selected_card_node_plain() {
    [[ -n "${TARGET_DRM_DEVICE:-}" ]] || return 1
    readlink -f "${TARGET_DRM_DEVICE}" 2>/dev/null || echo "${TARGET_DRM_DEVICE}"
}

_sunshine_libva_for_target() {
    local driver
    driver="$(_target_driver 2>/dev/null || true)"
    case "${driver}" in
        i915|xe) echo "${SUNSHINE_IGPU_LIBVA_DRIVER_NAME}" ;;
        amdgpu|radeon) echo "${SUNSHINE_DGPU_LIBVA_DRIVER_NAME}" ;;
        *) echo "" ;;
    esac
}

_start_sunshine_systemd_run() {
    local wd unit cfg card_node render_node driver libva journal_since cmd
    [[ -n "${WAYLAND_DISPLAY_DETECTED}" ]] || check_wayland_socket || true
    wd="${WAYLAND_DISPLAY_DETECTED:-}"
    [[ -z "${wd}" && -f "${WAYLAND_DISPLAY_FILE}" ]] && wd="$(cat "${WAYLAND_DISPLAY_FILE}" 2>/dev/null || true)"
    [[ -n "${wd}" ]] || { err "Cannot start Sunshine: WAYLAND_DISPLAY unavailable"; return 1; }

    _stop_sunshine_systemd_run
    _stop_sunshine_systemd
    _stop_sunshine_tmux_window

    _resolve_sunshine_config_effective || return 1
    cfg="${SUNSHINE_CONFIG_EFFECTIVE:-}"
    [[ -n "${cfg}" && -f "${cfg}" ]] || { err "Sunshine systemd-run requires a generated config file"; return 1; }

    unit="$(_sunshine_systemd_unit_name)"
    card_node="$(_selected_card_node_plain)"
    render_node="$(_selected_render_node_plain)"
    driver="$(_target_driver 2>/dev/null || echo unknown)"
    libva="$(_sunshine_libva_for_target)"
    journal_since="$(date '+%Y-%m-%d %H:%M:%S')"

    log "Starting Sunshine via systemd-run unit ${unit}.service..."
    vlog "  DeviceAllow card=${card_node} render=${render_node} driver=${driver}"

    local args=(
        --unit="${unit}"
        --collect
        -p "User=${REAL_USER}"
        -p "Group=${REAL_USER}"
        -p 'SupplementaryGroups=video render input'
        -p "WorkingDirectory=${SUNSHINE_CONFIG_DIR}"
        -p 'NoNewPrivileges=no'
        -p 'PrivateDevices=no'
        -E "HOME=${REAL_HOME}"
        -E "XDG_RUNTIME_DIR=${RUNTIME_DIR}"
        -E "WAYLAND_DISPLAY=${wd}"
        -E 'XDG_SESSION_TYPE=wayland'
        -E 'XDG_CURRENT_DESKTOP=KDE'
        -E 'KDE_FULL_SESSION=true'
        -E "KWIN_DRM_DEVICES=${TARGET_DRM_DEVICE}"
    )
    [[ -n "${libva}" ]] && args+=( -E "LIBVA_DRIVER_NAME=${libva}" )

    if _bool_true "${SUNSHINE_SYSTEMD_ISOLATE_DRI}"; then
        args+=(
            -p 'DevicePolicy=closed'
            -p "DeviceAllow=${card_node} rw"
            -p "DeviceAllow=${render_node} rw"
        )
        if _bool_true "${SUNSHINE_SYSTEMD_DEVICE_ALLOW_UINPUT}"; then
            args+=( -p 'DeviceAllow=/dev/uinput rw' )
        fi
    fi
    if _bool_true "${SUNSHINE_SYSTEMD_REQUIRE_CAP_SYS_ADMIN}"; then
        args+=(
            -p 'CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_NICE CAP_SYS_RESOURCE'
            -p 'AmbientCapabilities=CAP_SYS_ADMIN CAP_SYS_NICE CAP_SYS_RESOURCE'
        )
    fi

    cmd=("${SUNSHINE_BIN}" "${cfg}")

    if [[ "${EUID}" -eq 0 ]]; then
        systemd-run "${args[@]}" "${cmd[@]}" >/dev/null || return 1
    else
        sudo systemd-run "${args[@]}" "${cmd[@]}" >/dev/null || return 1
    fi

    _wait_sunshine_ready || return 1
    case "${SUNSHINE_SYSTEMD_ASSERT_MODE}" in
        off|disabled|false|0)
            vlog "Sunshine systemd-run assertion disabled"
            ;;
        strict)
            if ! _assert_sunshine_systemd_run_alignment "${unit}.service" "${journal_since}" "${card_node}" "${render_node}" "${driver}"; then
                err "Sunshine systemd-run GPU assertion failed for ${unit}.service"
                _stop_sunshine_systemd_run || true
                return 1
            fi
            ;;
        journal|soft|*)
            if ! _assert_sunshine_systemd_run_alignment "${unit}.service" "${journal_since}" "${card_node}" "${render_node}" "${driver}"; then
                _warn "Sunshine systemd-run journal assertion not conclusive yet for ${unit}.service"
            fi
            ;;
    esac
}

_assert_sunshine_systemd_run_alignment() {
    local unit="$1" since="$2" card_node="$3" render_node="$4" driver="$5" spid fds journal card_base render_base
    spid="$(_sunshine_newest_pid)"
    [[ -n "${spid}" ]] || { err "No Sunshine PID for systemd-run assertion"; return 1; }
    card_base="$(basename "${card_node}")"
    render_base="$(basename "${render_node}")"

    journal="$(_journalctl_unit "${unit}" --since "${since}")"
    if ! grep -Eq "/dev/dri/${card_base} -> ${driver}" <<<"${journal}"; then
        err "Sunshine journal does not yet show selected KMS device /dev/dri/${card_base} -> ${driver}"
        printf '%s\n' "${journal}" | grep -Ei '/dev/dri/card|Screencasting|KMS|encoder|vaapi|Intel|AMD|Radeon|Error|Fatal' | tail -n 80 | sed 's/^/[sunshine-journal] /' >&2 || true
        return 1
    fi
    if grep -Eq 'Fatal:|Unable to initialize capture method|Failed to initialize video capture|Couldn.t get handle for DRM Framebuffer' <<<"${journal}"; then
        err "Sunshine journal contains fatal capture/encoder errors"
        printf '%s\n' "${journal}" | grep -Ei 'Fatal|Unable to initialize|Framebuffer|Failed to initialize' | tail -n 80 | sed 's/^/[sunshine-journal] /' >&2 || true
        return 1
    fi

    fds="$(sudo ls -l "/proc/${spid}/fd" 2>/dev/null | grep -E '/dev/dri|card|render' || true)"
    if [[ -n "${fds}" ]]; then
        if ! grep -q "${render_base}" <<<"${fds}"; then
            _warn "Sunshine PID ${spid} has no current fd for selected render ${render_node} yet"
            printf '%s\n' "${fds}" | sed 's/^/[sunshine-fd] /' >&2
        fi
        if grep -E '/dev/dri/(card|renderD)' <<<"${fds}" | grep -Ev "${card_base}|${render_base}" >/dev/null; then
            err "Sunshine has fd(s) open on non-selected DRM nodes:"
            grep -E '/dev/dri/(card|renderD)' <<<"${fds}" | sed 's/^/[sunshine-fd] /' >&2
            return 1
        fi
    else
        _warn "Sunshine PID ${spid} has no DRM fd visible yet; this can be normal before first Moonlight launch"
    fi

    if _bool_true "${SUNSHINE_SYSTEMD_FD_ASSERT_STRICT}" || [[ "${SUNSHINE_SYSTEMD_ASSERT_MODE}" == "strict" ]]; then
        if ! grep -q "${card_base}" <<<"${fds}"; then
            err "Sunshine PID ${spid} has no fd for selected ${card_node}"
            return 1
        fi
        if ! grep -q "${render_base}" <<<"${fds}"; then
            err "Sunshine PID ${spid} has no fd for selected render ${render_node}"
            return 1
        fi
    fi

    vlog "Sunshine systemd-run assertion OK: ${unit} journal shows /dev/dri/${card_base} -> ${driver}"
}

_start_sunshine_tmux() {
    local wd launcher target_driver
    [[ -n "${WAYLAND_DISPLAY_DETECTED}" ]] || check_wayland_socket || true
    wd="${WAYLAND_DISPLAY_DETECTED:-}"
    [[ -z "${wd}" && -f "${WAYLAND_DISPLAY_FILE}" ]] && wd="$(cat "${WAYLAND_DISPLAY_FILE}" 2>/dev/null || true)"
    [[ -n "${wd}" ]] || { err "Cannot start Sunshine: WAYLAND_DISPLAY unavailable"; return 1; }

    _stop_sunshine_systemd_run
    _stop_sunshine_systemd
    _stop_sunshine_tmux_window
    : > "${SUNSHINE_TMUX_LOG}"

    launcher="${STATE_DIR}/sunshine-launcher.sh"
    target_driver="$(_target_driver 2>/dev/null || true)"

    _resolve_sunshine_config_effective || return 1
    SUNSHINE_ARGS_EFFECTIVE="${SUNSHINE_ARGS:-}"
    if [[ " ${SUNSHINE_ARGS_EFFECTIVE} " == *" --cmd "* ]]; then
        err "Ignoring SUNSHINE_ARGS=--cmd: this Sunshine build reports 'Fatal: Unknown command: cmd'."
        SUNSHINE_ARGS_EFFECTIVE="${SUNSHINE_ARGS_EFFECTIVE//--cmd/}"
    fi
    if [[ " ${SUNSHINE_ARGS_EFFECTIVE} " == *" --no-tray "* ]]; then
        err "Ignoring SUNSHINE_ARGS=--no-tray: unsupported by this Sunshine build."
        SUNSHINE_ARGS_EFFECTIVE="${SUNSHINE_ARGS_EFFECTIVE//--no-tray/}"
    fi
    SUNSHINE_ARGS_EFFECTIVE="$(echo "${SUNSHINE_ARGS_EFFECTIVE}" | xargs 2>/dev/null || true)"

    local sunshine_cmd_log
    sunshine_cmd_log="$(_sunshine_command_line_for_log)"

    cat > "${launcher}" <<EOF_LAUNCHER
#!/usr/bin/env bash
set -u
exec > >(tee -a "${SUNSHINE_TMUX_LOG}") 2>&1
printf '[plasmactl] %s launching sunshine via tmux\n' "\$(date '+%Y-%m-%d %H:%M:%S')"
export XDG_RUNTIME_DIR="${RUNTIME_DIR}"
export WAYLAND_DISPLAY="${wd}"
export XDG_SESSION_TYPE="wayland"
export XDG_CURRENT_DESKTOP="KDE"
export KDE_FULL_SESSION="true"
export KWIN_DRM_DEVICES="${TARGET_DRM_DEVICE}"
if [[ "${target_driver}" == "i915" || "${target_driver}" == "xe" ]]; then
  if [[ -n "${SUNSHINE_IGPU_LIBVA_DRIVER_NAME}" ]]; then
    export LIBVA_DRIVER_NAME="${SUNSHINE_IGPU_LIBVA_DRIVER_NAME}"
  fi
fi
unset DISPLAY
printf '[plasmactl] env: XDG_RUNTIME_DIR=%s WAYLAND_DISPLAY=%s KWIN_DRM_DEVICES=%s LIBVA_DRIVER_NAME=%s\n' "\$XDG_RUNTIME_DIR" "\$WAYLAND_DISPLAY" "\$KWIN_DRM_DEVICES" "${SUNSHINE_IGPU_LIBVA_DRIVER_NAME}"
printf '[plasmactl] profile: %s config: %s supervise: %s\n' "${SUNSHINE_PROFILE}" "${SUNSHINE_CONFIG_EFFECTIVE}" "${SUNSHINE_SUPERVISE}"
printf '[plasmactl] command: %s\n' "${sunshine_cmd_log}"
run_count=0
while true; do
  if [[ -n "${SUNSHINE_CONFIG_EFFECTIVE}" ]]; then
    # shellcheck disable=SC2086
    ${SUNSHINE_BIN} "${SUNSHINE_CONFIG_EFFECTIVE}" ${SUNSHINE_ARGS_EFFECTIVE}
  else
    # shellcheck disable=SC2086
    ${SUNSHINE_BIN} ${SUNSHINE_ARGS_EFFECTIVE}
  fi
  rc=\$?
  printf '[plasmactl] %s sunshine exited rc=%s\n' "\$(date '+%Y-%m-%d %H:%M:%S')" "\$rc"
  if [[ "${SUNSHINE_SUPERVISE}" != "true" && "${SUNSHINE_SUPERVISE}" != "1" && "${SUNSHINE_SUPERVISE}" != "yes" ]]; then
    exit "\$rc"
  fi
  run_count=\$((run_count+1))
  if [[ "${SUNSHINE_SUPERVISE_MAX_RESTARTS}" != "0" && "\$run_count" -ge "${SUNSHINE_SUPERVISE_MAX_RESTARTS}" ]]; then
    printf '[plasmactl] %s supervisor max restarts reached (%s); exiting\n' "\$(date '+%Y-%m-%d %H:%M:%S')" "${SUNSHINE_SUPERVISE_MAX_RESTARTS}"
    exit "\$rc"
  fi
  printf '[plasmactl] %s supervisor restarting sunshine in %ss (attempt %s)\n' "\$(date '+%Y-%m-%d %H:%M:%S')" "${SUNSHINE_SUPERVISE_RESTART_DELAY}" "\$((run_count+1))"
  sleep "${SUNSHINE_SUPERVISE_RESTART_DELAY}"
done
EOF_LAUNCHER
    chmod 700 "${launcher}"

    log "Starting Sunshine in tmux window '${SUNSHINE_WINDOW}' using launcher ${launcher}..."
    _run_as_user "${TMUX_BIN}" new-window -d -t "${SESSION}:" -n "${SUNSHINE_WINDOW}" "bash '${launcher}'"
    _wait_sunshine_ready || return 1
    if ! _assert_sunshine_gpu_alignment_from_log; then
        _stop_sunshine_tmux_window || true
        return 1
    fi
}

_start_sunshine_systemd() {
    local journal_since
    journal_since="$(date '+%Y-%m-%d %H:%M:%S')"
    check_sunshine_exists || { err "Sunshine unit not found: ${SUNSHINE_UNIT}"; return 1; }
    _set_systemd_user_env_for_sunshine
    _run_as_user "${SYSTEMCTL_BIN}" --user reset-failed "${SUNSHINE_UNIT}" sunshine.service >/dev/null 2>&1 || true
    if ! check_sunshine_enabled; then
        log "Sunshine not enabled — enabling on-demand..."
        _run_as_user "${SYSTEMCTL_BIN}" --user enable "${SUNSHINE_UNIT}" >/dev/null 2>&1 || vlog "Sunshine enable non-fatal"
    fi
    log "Starting Sunshine via systemd user service..."
    if check_sunshine_service_active && _bool_true "${SUNSHINE_RESTART_ON_START}"; then
        _run_as_user "${SYSTEMCTL_BIN}" --user restart "${SUNSHINE_UNIT}" 2>/dev/null || true
    else
        _run_as_user "${SYSTEMCTL_BIN}" --user start "${SUNSHINE_UNIT}" 2>/dev/null || true
    fi
    if ! _wait_sunshine_ready; then
        err "Sunshine did not become stream-ready via the systemd user service."
        return 1
    fi
    _warn_if_sunshine_selected_vkms "${journal_since}"
    return 0
}

_start_sunshine_supervised() {
    case "${SUNSHINE_START_MODE}" in
        tmux)
            _start_sunshine_tmux
            ;;
        systemd-run|systemdrun|transient)
            _start_sunshine_systemd_run
            ;;
        systemd)
            _start_sunshine_systemd
            ;;
        auto)
            if _start_sunshine_systemd; then
                return 0
            fi
            _warn "systemd Sunshine did not become stream-ready; falling back to tmux launcher"
            _stop_sunshine_if_active
            _start_sunshine_tmux
            ;;
        *)
            err "Invalid SUNSHINE_START_MODE=${SUNSHINE_START_MODE}. Use: systemd-run, tmux, systemd, or auto."
            return 1
            ;;
    esac
}

_assert_sunshine_gpu_alignment_from_log() {
    _bool_true "${SUNSHINE_STRICT_GPU_ASSERT}" || return 0
    [[ -f "${SUNSHINE_TMUX_LOG}" ]] || return 0

    local card driver role recent captures adapter output bad=false
    card="$(basename "${TARGET_DRM_DEVICE:-}" 2>/dev/null || true)"
    driver="$(_target_driver 2>/dev/null || true)"
    role="$(_effective_gpu_role)"
    adapter="$(_selected_sunshine_adapter 2>/dev/null || true)"
    output="$(_selected_sunshine_output 2>/dev/null || true)"

    [[ -n "${card}" && -n "${driver}" ]] || return 0
    sleep 1
    recent="$(tail -n 500 "${SUNSHINE_TMUX_LOG}" 2>/dev/null || true)"

    captures="$(awk '
        /Screencasting with KMS/ { want=1; next }
        want && /\/dev\/dri\/card[0-9]+ ->/ { print; want=0 }
    ' <<<"${recent}" | tail -n 10)"

    if [[ -n "${captures}" ]] && ! grep -Fq "/dev/dri/${card} -> ${driver}" <<<"${captures}"; then
        err "Sunshine KMS capture is not using selected ${TARGET_DRM_DEVICE} (${driver})."
        err "Expected capture line: /dev/dri/${card} -> ${driver}"
        sed 's/^/  /' <<<"${captures}" >&2
        bad=true
    fi

    if [[ "${role}" == "igpu" ]]; then
        if grep -Eiq 'vaapi vendor: .*AMD|vaapi vendor: .*Radeon' <<<"${recent}"; then
            err "Sunshine is using AMD/Radeon VAAPI while iGPU role is enforced."
            bad=true
        fi
    elif [[ "${role}" == "dgpu" ]]; then
        if grep -Eiq 'vaapi vendor: .*Intel' <<<"${recent}"; then
            err "Sunshine is using Intel VAAPI while dGPU role is enforced."
            bad=true
        fi
    fi

    if [[ "${bad}" == "true" ]]; then
        err "Sunshine GPU assertion failed. adapter_name=${adapter:-unknown} output_name=${output:-unset}"
        return 1
    fi
    return 0
}

# ─────────────────────────────────────────────────────────────────────────────
# START / STOP COMMANDS
# ─────────────────────────────────────────────────────────────────────────────

# Experimental backend: desktop units use the user manager, while managed
# Sunshine uses the restricted system-manager helper. Native desktop units
# remain separate from the launcher scope.
_scope_systemctl() { _run_as_user "${SYSTEMCTL_BIN}" --user "$@"; }
_scope_sunshine_helper() {
    sudo -n /usr/local/libexec/plasmactl-sunshine "$@"
}

_scope_sunshine_preflight() {
    local role="$1" info
    [[ -z "${SUNSHINE_ARGS}" && -z "${SUNSHINE_CONFIG_PATH}" ]] || {
        err "The scope backend uses fixed profile paths and accepts no custom Sunshine arguments."; return 1;
    }
    case "${SUNSHINE_PROFILE}" in normal|safe|performance) ;; *) err "Unsupported managed Sunshine profile."; return 1 ;; esac
    case "${role}" in igpu|dgpu) ;; *) err "Select an explicit GPU role for managed Sunshine."; return 1 ;; esac
    [[ -z "$(_sunshine_newest_pid)" ]] || { err "An existing Sunshine process must be stopped by its owner first."; return 1; }
    info="$(_scope_sunshine_helper check 00000000000000000000000000000000 "${role}")" || return 1
    jq -e --arg card "${TARGET_DRM_DEVICE}" --arg render "$(_selected_render_node_plain)" \
        '.card == $card and .render == $render' <<< "${info}" >/dev/null || {
        err "Installed Sunshine device policy differs from the selected GPU."; return 1;
    }
}

_scope_prepare_sunshine_config() {
    local target apps stage
    case "${SUNSHINE_PROFILE}" in
        normal) [[ -f "${SUNSHINE_DEFAULT_CONFIG}" ]] || { err "Normal Sunshine config is missing."; return 1; }; return 0 ;;
        safe) target="${SUNSHINE_SAFE_CONFIG}"; apps="${SUNSHINE_SAFE_APPS}" ;;
        performance) target="${SUNSHINE_PERF_CONFIG}"; apps="${SUNSHINE_PERF_APPS}" ;;
        *) return 1 ;;
    esac
    # Existing settings and application lists are operator-owned. Generate only
    # absent assets, publishing each without replacing a concurrent edit.
    [[ ! -e "${target}" && ! -L "${target}" ]] || { [[ -f "${target}" ]] && return 0; return 1; }
    stage="$(mktemp -d "${SUNSHINE_CONFIG_DIR}/.plasmactl-profile.XXXXXX")" || return 1
    local SUNSHINE_SAFE_CONFIG="${stage}/$(basename "${SUNSHINE_SAFE_CONFIG}")"
    local SUNSHINE_SAFE_APPS="${stage}/$(basename "${SUNSHINE_SAFE_APPS}")"
    local SUNSHINE_PERF_CONFIG="${stage}/$(basename "${SUNSHINE_PERF_CONFIG}")"
    local SUNSHINE_PERF_APPS="${stage}/$(basename "${SUNSHINE_PERF_APPS}")"
    local result=0
    if [[ "${SUNSHINE_PROFILE}" == safe ]]; then
        _write_sunshine_safe_assets >&2 || result=$?
    else
        _write_sunshine_performance_assets >&2 || result=$?
    fi
    if (( result == 0 )); then
        # Generated configs for the managed backend retain Sunshine's secure
        # WAN default. Existing user configs are never rewritten here.
        sed -i 's/^wan_encryption_mode = 0$/wan_encryption_mode = 2/' "${stage}/$(basename "${target}")" || result=$?
        if [[ ! -e "${apps}" && ! -L "${apps}" ]]; then
            ln -- "${stage}/$(basename "${apps}")" "${apps}" || result=$?
        fi
        if (( result == 0 )); then
            ln -- "${stage}/$(basename "${target}")" "${target}" || result=$?
        fi
    fi
    rm -rf -- "${stage}"
    return "${result}"
}

_scope_wayland_display() {
    local run="$1" properties pid entry display=""
    properties="$(_scope_unit plasma-plasmashell.service)" || return 1
    pid="$(_scope_property "${properties}" MainPID)"
    _scope_pid_owned "${pid}" "${run}" || return 1
    while IFS= read -r -d '' entry; do
        case "${entry}" in WAYLAND_DISPLAY=*) display="${entry#WAYLAND_DISPLAY=}" ;; esac
    done < "/proc/${pid}/environ"
    [[ "${display}" =~ ^wayland-[0-9]+$ && -S "${RUNTIME_DIR}/${display}" &&
       ! -L "${RUNTIME_DIR}/${display}" && "$(stat -c %u "${RUNTIME_DIR}/${display}")" == "${REAL_UID}" ]] || return 1
    printf '%s\n' "${display}"
}

_scope_sunshine_info() {
    local run role info expected
    run="$(jq -r '.run' "${SCOPE_STATE_FILE}")" || return 1
    role="$(jq -r '.sunshine.role' "${SCOPE_STATE_FILE}")" || return 1
    expected="plasmactl-sunshine-u${REAL_UID}-${role}@${run}.service"
    info="$(_scope_sunshine_helper status "${run}" "${role}")" || return 1
    jq -e --arg unit "${expected}" '.unit == $unit and (.recorded|type == "boolean")
        and (.state|type == "string") and (.invocation|type == "string")
        and (.listeners|type == "array" and all(.[]; type == "number"))' <<< "${info}" >/dev/null || return 1
    printf '%s\n' "${info}"
}

_scope_sunshine_ready() {
    local info="$1" invocation port
    invocation="$(jq -r '.sunshine.invocation // empty' "${SCOPE_STATE_FILE}")" || return 1
    [[ -n "${invocation}" ]] || return 1
    jq -e --arg invocation "${invocation}" '.recorded and .state == "active" and .invocation == $invocation' \
        <<< "${info}" >/dev/null || return 1
    for port in ${SUNSHINE_REQUIRED_TCP_PORTS}; do
        [[ "${port}" =~ ^[0-9]+$ ]] || return 1
        jq -e --argjson port "${port}" '.listeners|index($port) != null' <<< "${info}" >/dev/null || return 1
    done
}

_scope_start_sunshine() {
    local run="$1" sid="$2" role="$3" display info invocation ticks=0 result=0
    display="$(_scope_wayland_display "${run}")" || { err "No owned Wayland socket is ready."; return 1; }
    _scope_update --arg role "${role}" --arg profile "${SUNSHINE_PROFILE}" --arg display "${display}" \
        '.sunshine = {role:$role,profile:$profile,display:$display,invocation:null}' || return 1
    _scope_sunshine_helper start "${run}" "${role}" "${sid}" "${display}" "${SUNSHINE_PROFILE}" >/dev/null || result=$?
    # Query even after a failed start: the manager may have activated the unit
    # before a later readiness query failed. Preserve its identity for rollback.
    info="$(_scope_sunshine_info)" || return 1
    invocation="$(jq -r '.invocation' <<< "${info}")"
    if [[ "${invocation}" =~ ^[a-f0-9]{32}$ ]] && jq -e '.recorded' <<< "${info}" >/dev/null; then
        _scope_update --arg invocation "${invocation}" '.sunshine.invocation = $invocation' || return 1
    fi
    (( result == 0 )) || return "${result}"
    while (( ticks < WAIT_SUNSHINE_PORTS )); do
        _scope_sunshine_ready "${info}" && return 0
        [[ "$(jq -r '.state' <<< "${info}")" == active ]] || break
        sleep 1
        (( ticks += 1 ))
        info="$(_scope_sunshine_info)" || return 1
    done
    err "Owned Sunshine did not open the required TCP listeners."
    return 1
}

_scope_stop_sunshine() {
    jq -e '.sunshine != null' "${SCOPE_STATE_FILE}" >/dev/null || return 0
    local info run role invocation current
    info="$(_scope_sunshine_info)" || return 1
    run="$(jq -r '.run' "${SCOPE_STATE_FILE}")"
    role="$(jq -r '.sunshine.role' "${SCOPE_STATE_FILE}")"
    invocation="$(jq -r '.sunshine.invocation // empty' "${SCOPE_STATE_FILE}")"
    current="$(jq -r '.invocation' <<< "${info}")"
    case "$(jq -r '.state' <<< "${info}")" in
        inactive|failed) ;;
        *) [[ -n "${invocation}" && "${invocation}" == "${current}" ]] || {
            err "Sunshine invocation changed or was not recorded; refusing stop."; return 1;
        } ;;
    esac
    if jq -e '.recorded' <<< "${info}" >/dev/null; then
        _scope_sunshine_helper stop "${run}" "${role}" "${invocation:-00000000000000000000000000000000}" >/dev/null || return 1
    fi
    _scope_update '.sunshine.stopped = true'
}
_scope_boot_id() { cat /proc/sys/kernel/random/boot_id; }
_scope_property() { _session_property "$1" "$2"; }
_scope_unit() {
    local properties status=0
    properties="$(_scope_systemctl show -p Id -p LoadState -p ActiveState -p InvocationID -p MainPID -p PartOf -- "$1")" || status=$?
    # A collected transient scope is expected absence. Query/permission failures
    # must remain distinguishable from a unit that no longer exists.
    if (( status != 0 )) && [[ "$(_scope_property "${properties}" LoadState)" != not-found ]]; then
        return "${status}"
    fi
    printf '%s\n' "${properties}"
}
_scope_update() {
    local candidate
    candidate="$(mktemp "${SCOPE_STATE_FILE}.XXXXXX")" || return 1
    if ! jq "$@" "${SCOPE_STATE_FILE}" > "${candidate}"; then
        rm -- "${candidate}"
        return 1
    fi
    chmod 600 "${candidate}" && mv -- "${candidate}" "${SCOPE_STATE_FILE}"
}
_scope_load() {
    command -v jq >/dev/null || { err "The scope backend requires jq."; return 1; }
    [[ -f "${SCOPE_STATE_FILE}" && ! -L "${SCOPE_STATE_FILE}" ]] || return 1
    jq -e --arg uid "${REAL_UID}" --arg boot "$(_scope_boot_id)" '
        .schema == 1 and (.uid|tostring) == $uid and .boot == $boot
        and (.run|type == "string" and test("^[a-f0-9]{32}$"))
        and .scope == ("plasmactl-plasma-" + .run + ".scope")
        and (.sid|type == "string" and test("^[a-zA-Z0-9_-]+$"))
        and (.tty|type == "string" and test("^tty[0-9]+$"))
        and (.gpu|type == "string" and test("^/dev/dri/card[0-9]+$"))
        and (.phase == "starting" or .phase == "running")
        and (.environment_before|type == "object" and all(.[]; type == "string"))
        and ((.environment_after // {})|type == "object" and all(.[]; type == "string"))
        and (.baseline_active|type == "array" and all(.[]; type == "string"))
        and (.units|type == "object")
        and (.units|to_entries|all(.key|test("^[a-zA-Z0-9_.@:\\\\-]+\\.(service|scope|target)$")))
        and (.units|to_entries|all(.value|type == "string" and test("^[a-f0-9]{32}$")))
        and (.sunshine == null or (.sunshine|type == "object"
            and (.role == "igpu" or .role == "dgpu")
            and (.profile == "normal" or .profile == "safe" or .profile == "performance")
            and (.display|type == "string" and test("^wayland-[0-9]+$"))
            and (.invocation == null or (.invocation|type == "string" and test("^[a-f0-9]{32}$")))))
    ' "${SCOPE_STATE_FILE}" >/dev/null || {
        err "Scope state is invalid or belongs to another boot/user; preserving it for review."
        return 1
    }
}
_scope_manager_environment() {
    _run_as_user busctl --user --json=short get-property \
        org.freedesktop.systemd1 /org/freedesktop/systemd1 \
        org.freedesktop.systemd1.Manager Environment |
        jq -ce 'if .type != "as" or (.data|type) != "array" then error("invalid manager environment") else
            [.data[] | capture("^(?<key>[^=]+)=(?<value>.*)$"; "s") |
            select(.key | test("^(PLASMACTL_RUN_ID|KWIN_DRM_DEVICES|KWIN_RENDER_NODES|XDG_SESSION_ID|XDG_SESSION_TYPE|XDG_CURRENT_DESKTOP|KDE_FULL_SESSION|WAYLAND_DISPLAY|DISPLAY|DBUS_SESSION_BUS_ADDRESS)$"))] | from_entries end'
}
_scope_graph_units() {
    local active unit properties relations members=""
    # Enumerate raw names as JSON. Query PartOf on active units instead of
    # relying on a target object that may be garbage-collected while inactive.
    active="$(_scope_systemctl list-units --all --state=active,activating,reloading,deactivating --output=json --no-pager |
        jq -r '.[].unit')" || return 1
    while read -r unit; do
        [[ -n "${unit}" ]] || continue
        properties="$(_scope_unit "${unit}")" || return 1
        relations="$(_scope_property "${properties}" PartOf)"
        case " ${relations} " in
            *" graphical-session.target "*) members+="${unit}"$'\n' ;;
        esac
    done <<< "${active}"
    {
        printf '%s\n' graphical-session.target graphical-session-pre.target \
            plasma-workspace-wayland.target plasma-workspace.target plasma-core.target \
            plasma-kwin_wayland.service plasma-plasmashell.service
        printf '%s' "${members}"
    } | sort -u
}

_scope_validate_login() {
    local sid="$1" properties
    properties="$("${LOGINCTL_BIN}" show-session "${sid}" -p User -p Seat -p TTY)" || return 1
    [[ "$(_scope_property "${properties}" User)" == "${REAL_UID}" &&
       "$(_scope_property "${properties}" Seat)" == seat0 &&
       "$(_scope_property "${properties}" TTY)" == "${TTY_NAME}" ]]
}
_scope_pid_owned() {
    local pid="$1" run="$2" sid gpu
    [[ "${pid}" =~ ^[1-9][0-9]*$ ]] || return 1
    sid="$(jq -er '.sid' "${SCOPE_STATE_FILE}")" || return 1
    gpu="$(jq -er '.gpu' "${SCOPE_STATE_FILE}")" || return 1
    # Match whole NUL-delimited entries, not path or token substrings.
    grep -zFxq -- "PLASMACTL_RUN_ID=${run}" "/proc/${pid}/environ" 2>/dev/null &&
        grep -zFxq -- "XDG_SESSION_ID=${sid}" "/proc/${pid}/environ" 2>/dev/null &&
        grep -zFxq -- "KWIN_DRM_DEVICES=${gpu}" "/proc/${pid}/environ" 2>/dev/null
}
_scope_capture_unit() {
    local unit="$1" run="$2" graph_proof="${3:-false}" properties state invocation known pid
    local unit_pattern='^[a-zA-Z0-9_.@:\\-]+\.(service|scope|target)$'
    [[ "${unit}" =~ ${unit_pattern} ]] || { err "Invalid unit identity ${unit}."; return 1; }
    properties="$(_scope_unit "${unit}")" || return 1
    state="$(_scope_property "${properties}" ActiveState)"
    case "${state}" in inactive|failed) return 0 ;; active|activating|reloading) ;; *) return 1 ;; esac
    invocation="$(_scope_property "${properties}" InvocationID)"
    [[ "${invocation}" =~ ^[a-f0-9]{32}$ ]] || return 1
    known="$(jq -r --arg u "${unit}" '.units[$u] // empty' "${SCOPE_STATE_FILE}")" || return 1
    if [[ -n "${known}" ]]; then
        [[ "${known}" == "${invocation}" ]] || { err "Invocation changed for ${unit}; refusing adoption."; return 1; }
    elif [[ "${unit}" == *.service ]]; then
        pid="$(_scope_property "${properties}" MainPID)"
        if ! _scope_pid_owned "${pid}" "${run}"; then
            case "${unit}" in
                plasma-kwin_wayland.service|plasma-plasmashell.service)
                    err "Cannot prove compositor/shell ownership for ${unit}."; return 1 ;;
            esac
            # PartOf is an explicit lifetime relationship to the owned desktop.
            # Require the complete pre-launch active-unit baseline as well.
            if [[ "${graph_proof}" != true ]] || ! jq -e --arg u "${unit}" \
                '(.baseline_active|type == "array") and ((.baseline_active|index($u)) == null)' \
                "${SCOPE_STATE_FILE}" >/dev/null; then
                err "Cannot prove graph ownership of ${unit}."
                return 1
            fi
        fi
    elif [[ "${unit}" == *.scope ]]; then
        [[ "${unit}" == "plasmactl-plasma-${run}.scope" ]] || return 1
    else
        case "${unit}" in
            graphical-session.target|graphical-session-pre.target|plasma-workspace-wayland.target|plasma-workspace.target|plasma-core.target) ;;
            *) err "Unrecognized desktop target ${unit}."; return 1 ;;
        esac
    fi
    _scope_update --arg u "${unit}" --arg i "${invocation}" '.units[$u] = $i'
}
_scope_capture_graph() {
    local run="$1" units unit anchor pid
    anchor="$(_scope_unit plasma-kwin_wayland.service)" || return 1
    pid="$(_scope_property "${anchor}" MainPID)"
    _scope_pid_owned "${pid}" "${run}" || { err "No owned compositor anchors this desktop graph."; return 1; }
    units="$(_scope_graph_units)" || return 1
    while read -r unit; do
        [[ -n "${unit}" ]] || continue
        _scope_capture_unit "${unit}" "${run}" true || return 1
    done <<< "${units}"
}
_scope_match_unit() {
    local unit="$1" expected="$2" properties state current
    properties="$(_scope_unit "${unit}")" || return 1
    state="$(_scope_property "${properties}" ActiveState)"
    case "${state}" in inactive|failed) return 0 ;; esac
    current="$(_scope_property "${properties}" InvocationID)"
    [[ "${current}" == "${expected}" && -n "${current}" ]] || {
        err "Refusing to control a different invocation of ${unit}."
        return 1
    }
}
_scope_restore_environment() {
    local current before after key value
    current="$(_scope_manager_environment)" || return 1
    before="$(jq -c '.environment_before' "${SCOPE_STATE_FILE}")" || return 1
    after="$(jq -c '.environment_after // {}' "${SCOPE_STATE_FILE}")" || return 1
    while read -r key; do
        [[ -n "${key}" ]] || continue
        # Another actor may have updated the environment during shutdown.
        if ! jq -e --arg k "${key}" --argjson now "${current}" --argjson after "${after}" \
            '($now|has($k)) == ($after|has($k)) and $now[$k] == $after[$k]' <<< '{}' >/dev/null; then
            continue
        fi
        if jq -e --arg k "${key}" 'has($k)' <<< "${before}" >/dev/null; then
            value="$(jq -r --arg k "${key}" '.[$k]' <<< "${before}")" || return 1
            _scope_systemctl set-environment "${key}=${value}" || return 1
        else
            _scope_systemctl unset-environment "${key}" || return 1
        fi
    done < <(jq -r --argjson before "${before}" '(. + $before)|keys[]' <<< "${after}")
}
_scope_status() {
    _scope_load || return 1
    local unit invocation properties status=0
    while IFS=$'\t' read -r unit invocation; do
        _scope_match_unit "${unit}" "${invocation}" || return 1
        properties="$(_scope_unit "${unit}")" || return 1
        printf '%s: %s\n' "${unit}" "$(_scope_property "${properties}" ActiveState)"
        [[ "$(_scope_property "${properties}" ActiveState)" == active ]] || status=1
    done < <(jq -r '.units|to_entries[]|.key + "\t" + .value' "${SCOPE_STATE_FILE}")
    jq -e '.phase == "running" and (.units[.scope] != null)
        and (.units["plasma-kwin_wayland.service"] != null)
        and (.units["plasma-plasmashell.service"] != null)' "${SCOPE_STATE_FILE}" >/dev/null || status=1
    if jq -e '.sunshine != null' "${SCOPE_STATE_FILE}" >/dev/null; then
        local info
        info="$(_scope_sunshine_info)" || return 1
        printf 'Owned Sunshine: %s\n' "$(jq -r '.state' <<< "${info}")"
        _scope_sunshine_ready "${info}" || status=1
    else
        printf 'Plasma-only execution; Sunshine is disabled.\n'
    fi
    return "${status}"
}
_scope_stop() {
    _scope_load || return 1
    local run scope unit invocation properties units remaining ticks=0
    run="$(jq -r '.run' "${SCOPE_STATE_FILE}")"
    scope="$(jq -r '.scope' "${SCOPE_STATE_FILE}")"
    # Require the recorded launcher identity; do not infer ownership from a name.
    invocation="$(jq -r --arg u "${scope}" '.units[$u] // empty' "${SCOPE_STATE_FILE}")"
    [[ -n "${invocation}" ]] || { err "Launcher identity was not recorded; manual review is required."; return 1; }
    _scope_match_unit "${scope}" "${invocation}" || return 1
    # An incomplete startup or late desktop autostart may need a refresh.
    # Refresh only while the original scope and both core process identities
    # still prove the desktop execution. Otherwise retain the strict record.
    properties="$(_scope_unit "${scope}")" || return 1
    if [[ "$(_scope_property "${properties}" ActiveState)" == active ]]; then
        local core owned_cores=true
        for core in plasma-kwin_wayland.service plasma-plasmashell.service; do
            properties="$(_scope_unit "${core}")" || return 1
            if ! _scope_pid_owned "$(_scope_property "${properties}" MainPID)" "${run}"; then
                owned_cores=false
            fi
        done
        if [[ "${owned_cores}" == true ]]; then
            _scope_capture_graph "${run}" || return 1
        fi
    fi
    local graph known
    graph="$(_scope_graph_units)" || return 1
    while read -r unit; do
        [[ -n "${unit}" ]] || continue
        properties="$(_scope_unit "${unit}")" || return 1
        case "$(_scope_property "${properties}" ActiveState)" in inactive|failed) continue ;; esac
        known="$(jq -r --arg u "${unit}" '.units[$u] // empty' "${SCOPE_STATE_FILE}")" || return 1
        [[ -n "${known}" ]] || { err "Unrecorded active desktop dependency ${unit}; refusing stop."; return 1; }
        _scope_match_unit "${unit}" "${known}" || return 1
    done <<< "${graph}"
    units="$(jq -r '.units|to_entries[]|.key + "\t" + .value' "${SCOPE_STATE_FILE}")" || return 1
    # Validate the entire set before issuing any stop operation.
    while IFS=$'\t' read -r unit invocation; do
        _scope_match_unit "${unit}" "${invocation}" || return 1
    done <<< "${units}"
    # The root helper independently rechecks the system-manager invocation.
    # Streaming must end before any desktop unit receives a stop request.
    _scope_stop_sunshine || return 1
    while IFS=$'\t' read -r unit invocation; do
        _scope_match_unit "${unit}" "${invocation}" || return 1
        properties="$(_scope_unit "${unit}")" || return 1
        case "$(_scope_property "${properties}" ActiveState)" in inactive|failed) continue ;; esac
        _scope_systemctl --no-block stop -- "${unit}" || return 1
    done <<< "${units}"
    while :; do
        remaining=false
        while IFS=$'\t' read -r unit invocation; do
            _scope_match_unit "${unit}" "${invocation}" || return 1
            properties="$(_scope_unit "${unit}")" || return 1
            case "$(_scope_property "${properties}" ActiveState)" in inactive|failed) ;; *) remaining=true ;; esac
        done <<< "${units}"
        [[ "${remaining}" == true ]] || break
        if (( ticks >= WAIT_STOP * 5 )); then
            err "Timed out stopping owned units; state retained."
            return 1
        fi
        sleep 0.2
        (( ticks += 1 ))
    done
    _scope_restore_environment || return 1
    rm -- "${SCOPE_STATE_FILE}"
    log "Owned Plasma execution stopped; unrelated process names were not signalled."
}
_scope_activate_login() {
    local sid="$1"
    [[ "$(get_session_active_state "${sid}")" == yes ]] && return 0
    _bool_true "${ACTIVATE_TTY_ON_START}" || { err "The scope backend requires its login to be active."; return 1; }
    "${LOGINCTL_BIN}" --no-ask-password activate "${sid}" || {
        err "Cannot activate the login non-interactively; no scope has been launched."
        return 1
    }
    local ticks=0
    while (( ticks < TTY_ACTIVATE_TIMEOUT * 5 )); do
        [[ "$(get_session_active_state "${sid}")" == yes ]] && return 0
        sleep 0.2
        (( ticks += 1 ))
    done
    err "The selected login did not become active."
    return 1
}
_scope_check_sunshine_autostart() {
    local properties dependencies unit load
    properties="$(_scope_systemctl show -p Wants -p Requires -- graphical-session.target)" || return 1
    dependencies="$(_scope_property "${properties}" Wants) $(_scope_property "${properties}" Requires)"
    for unit in "${SUNSHINE_UNIT}" sunshine.service app-dev.lizardbyte.app.Sunshine.service; do
        case " ${dependencies} " in
            *" ${unit} "*)
                properties="$(_scope_unit "${unit}")" || return 1
                load="$(_scope_property "${properties}" LoadState)"
                if [[ "${load}" != masked ]]; then
                    err "Desktop autostart would launch ${unit}; managed starts require it to be explicitly disabled or runtime-masked."
                    return 1
                fi ;;
        esac
    done
}
_scope_start_transaction() {
    local sid run scope before unit properties pane launcher env_after baseline role ticks=0
    [[ "${EUID}" -ne 0 ]] || { err "Run the scope backend as the desktop user, without sudo."; return 1; }
    if [[ -e "${SCOPE_STATE_FILE}" || -L "${SCOPE_STATE_FILE}" ]]; then
        err "An execution record already exists; inspect status or stop it before starting again."
        return 1
    fi
    for launcher in jq busctl systemd-run startplasma-wayland; do
        command -v "${launcher}" >/dev/null || { err "Missing executable: ${launcher}"; return 1; }
    done
    cmd_session_check || return $?
    _scope_check_sunshine_autostart || return 1
    sid="$(get_tty_session_id)"
    _scope_validate_login "${sid}" || { err "Login identity does not match user/seat/TTY."; return 1; }
    check_tmux_session || { err "Configured tmux session is unavailable."; return 1; }
    # Reject already-running dependents, even if the desktop target is inactive.
    properties="$(_scope_graph_units)" || return 1
    while read -r unit; do
        [[ -n "${unit}" ]] || continue
        before="$(_scope_unit "${unit}")" || return 1
        case "$(_scope_property "${before}" ActiveState)" in
            inactive) ;;
            *) err "Desktop dependency ${unit} is not inactive; refusing adoption."; return 1 ;;
        esac
    done <<< "${properties}"
    resolve_plasma_drm_device || return 1
    _require_kms_output_ready || return 1
    local render
    render="$(_selected_render_node_plain)" || return 1
    [[ "${render}" =~ ^/dev/dri/renderD[0-9]+$ ]] || {
        err "No render node belongs to the selected GPU."; return 1;
    }
    role="$(_effective_gpu_role)"
    if _bool_true "${SUNSHINE_SUPERVISE}"; then
        _scope_sunshine_preflight "${role}" || return 1
        _scope_prepare_sunshine_config || return 1
    fi
    before="$(_scope_manager_environment)" || return 1
    baseline="$(_scope_systemctl list-units --all --output=json --no-pager |
        jq -ce '[.[] | select(.active != "inactive" and .active != "failed") | .unit]')" || return 1
    run="$(tr -d '-' < /proc/sys/kernel/random/uuid)"
    scope="plasmactl-plasma-${run}.scope"
    # Create without overwriting an existing state record, including symlinks.
    (umask 077; set -o noclobber; jq -n --arg uid "${REAL_UID}" --arg boot "$(_scope_boot_id)" \
        --arg run "${run}" --arg sid "${sid}" --arg tty "${TTY_NAME}" --arg gpu "${TARGET_DRM_DEVICE}" \
        --arg scope "${scope}" --argjson before "${before}" --argjson baseline "${baseline}" \
        '{schema:1,phase:"starting",uid:$uid,boot:$boot,run:$run,sid:$sid,tty:$tty,gpu:$gpu,scope:$scope,units:{},baseline_active:$baseline,environment_before:$before}' > "${SCOPE_STATE_FILE}") || return 1
    SCOPE_ATTEMPT_RUN="${run}"
    _scope_activate_login "${sid}" || return 1
    launcher="$(command -v systemd-run)"
    pane="$(_run_as_user "${TMUX_BIN}" new-window -d -P -F '#{pane_id}' -t "${SESSION}" \
        -n "plasmactl-${run:0:8}" -c "${REAL_HOME}" -- \
        "${launcher}" --user --scope --unit="${scope}" \
        /usr/bin/env "PLASMACTL_RUN_ID=${run}" "XDG_SESSION_ID=${sid}" \
        "XDG_RUNTIME_DIR=${RUNTIME_DIR}" "DBUS_SESSION_BUS_ADDRESS=unix:path=${RUNTIME_DIR}/bus" \
        "KWIN_DRM_DEVICES=${TARGET_DRM_DEVICE}" "KWIN_RENDER_NODES=${render}" XDG_SESSION_TYPE=wayland \
        XDG_CURRENT_DESKTOP=KDE KDE_FULL_SESSION=true "$(command -v startplasma-wayland)")" || return 1
    _scope_update --arg pane "${pane}" '.pane = $pane' || return 1
    while (( ticks < WAIT_PLASMA * 5 )); do
        properties="$(_scope_unit "${scope}")" || return 1
        if [[ "$(_scope_property "${properties}" ActiveState)" == active ]]; then
            _scope_capture_unit "${scope}" "${run}" || return 1
            break
        fi
        sleep 0.2
        (( ticks += 1 ))
    done
    [[ "$(jq '.units|length' "${SCOPE_STATE_FILE}")" -gt 0 ]] || {
        err "Scope did not become active; state retained for review."
        return 1
    }
    ticks=0
    while (( ticks < WAIT_PLASMA * 5 )); do
        properties="$(_scope_unit plasma-plasmashell.service)" || return 1
        if [[ "$(_scope_property "${properties}" ActiveState)" == active ]]; then
            properties="$(_scope_unit plasma-kwin_wayland.service)" || return 1
            if [[ "$(_scope_property "${properties}" ActiveState)" == active ]]; then
                properties="$(_scope_unit plasma-workspace-wayland.target)" || return 1
                if [[ "$(_scope_property "${properties}" ActiveState)" == active ]]; then break; fi
            fi
        fi
        sleep 0.2
        (( ticks += 1 ))
    done
    env_after="$(_scope_manager_environment)" || return 1
    _scope_update --argjson after "${env_after}" '.environment_after = $after' || return 1
    if (( ticks >= WAIT_PLASMA * 5 )); then
        err "Native Plasma units did not become active; state retained."
        return 1
    fi
    _scope_capture_graph "${run}" || return 1
    local display
    display="$(_scope_wayland_display "${run}")" || { err "Owned Wayland endpoint is unavailable."; return 1; }
    _scope_update --arg display "${display}" '.wayland = $display' || return 1
    if _bool_true "${SUNSHINE_SUPERVISE}"; then
        _scope_start_sunshine "${run}" "${sid}" "${role}" || return 1
    fi
    _scope_update '.phase = "running"' || return 1
    _scope_status
}

_scope_start() {
    local result=0 run scope properties graph unit untouched=true
    SCOPE_ATTEMPT_RUN=""
    if _scope_start_transaction; then return 0; else result=$?; fi
    [[ -n "${SCOPE_ATTEMPT_RUN}" ]] || return "${result}"
    _scope_load || return "${result}"
    run="$(jq -r '.run' "${SCOPE_STATE_FILE}")" || return "${result}"
    [[ "${run}" == "${SCOPE_ATTEMPT_RUN}" ]] || return "${result}"
    scope="$(jq -r '.scope' "${SCOPE_STATE_FILE}")" || return "${result}"
    properties="$(_scope_unit "${scope}")" || return "${result}"
    case "$(_scope_property "${properties}" ActiveState)" in
        inactive|failed)
            graph="$(_scope_graph_units)" || return "${result}"
            while read -r unit; do
                [[ -n "${unit}" ]] || continue
                properties="$(_scope_unit "${unit}")" || return "${result}"
                case "$(_scope_property "${properties}" ActiveState)" in inactive|failed) ;; *) untouched=false ;; esac
            done <<< "${graph}"
            if [[ "${untouched}" == true ]] && ! jq -e '.sunshine != null' "${SCOPE_STATE_FILE}" >/dev/null; then
                rm -- "${SCOPE_STATE_FILE}"
                err "Startup failed before any desktop unit remained active; execution state cleared."
                return "${result}"
            fi ;;
    esac
    err "Startup failed; attempting rollback of the identified execution."
    if ! _scope_stop; then
        err "Rollback could not prove or stop every component; state retained for review."
    fi
    return "${result}"
}

cmd_start() {
    _LOG_CTX="start"
    acquire_lock || return 1
    : > "${START_LOG}"
    : > "${LAST_LOG}"
    exec > >(tee -a "${START_LOG}") 2>&1

    log "─── plasmactl start v${VERSION} (user=${REAL_USER}) ───"
    case "${PLASMA_SESSION_BACKEND}" in
        systemd-scope) _scope_start; return $? ;;
        legacy) [[ ! -e "${SCOPE_STATE_FILE}" && ! -L "${SCOPE_STATE_FILE}" ]] || {
            err "Scope state exists; refusing legacy start."; return 1;
        } ;;
        *) err "Unknown PLASMA_SESSION_BACKEND=${PLASMA_SESSION_BACKEND}"; return 2 ;;
    esac

    log "Checking required binaries..."
    check_required_bins || exit 1

    log "Resolving Plasma DRM device..."
    log "GPU role: $(_effective_gpu_role) (default=${PLASMA_GPU_DEFAULT}, override=${PLASMA_GPU_OVERRIDE:-none})"
    resolve_plasma_drm_device || exit 1
    log "Plasma DRM target: ${TARGET_DRM_DEVICE} ($(_target_driver 2>/dev/null || echo unknown))"
    _require_kms_output_ready || exit 1

    log "Checking ${TTY_NAME} loginctl session..."
    if ! check_tty_session; then
        err "No loginctl session on ${TTY_NAME}. Check getty@${TTY_NAME} autologin."
        "${LOGINCTL_BIN}" list-sessions --no-legend 2>&1 || true
        exit 1
    fi
    if ! check_tty_seat0; then
        err "${TTY_NAME} session exists but is not on seat0. Plasma Wayland needs a real seat."
        exit 1
    fi
    local sid; sid="$(get_tty_session_id)"
    log "${TTY_NAME} session: OK (session ${sid}, seat0)"
    ensure_tty_active_for_kms "${sid}" || exit 1

    log "Checking tmux session '${SESSION}'..."
    if ! check_tmux_session; then
        err "tmux session '${SESSION}' not found. Verify autologin / shell configuration."
        exit 1
    fi
    if ! check_tmux_attached; then
        _warn "tmux session '${SESSION}' is not attached."
    fi
    log "TMUX '${SESSION}': OK"
    _tmux_unlock_clients || true

    if check_plasma_healthy; then
        log "Plasma already healthy on target — skipping launch"
    else
        if check_sunshine; then
            _stop_sunshine_if_active
        fi
        if check_any_kwin || check_plasmashell || check_startplasma_running; then
            log "Partial/stale Plasma detected — cleaning before relaunch"
            _stop_plasma_processes
            sleep 1
        fi

        local safe_target cmd
        safe_target="$(_escape_sq "${TARGET_DRM_DEVICE}")"
        cmd="export KWIN_DRM_DEVICES='${safe_target}'; export XDG_SESSION_TYPE=wayland; export XDG_CURRENT_DESKTOP=KDE; export KDE_FULL_SESSION=true; dbus-run-session startplasma-wayland"

        log "Launching Plasma via tmux '${SESSION}'..."
        vlog "  KWIN_DRM_DEVICES=${TARGET_DRM_DEVICE}"
        send_tmux_command "${cmd}"
        log "startplasma-wayland injected"

        wait_for "kwin_wayland" "${WAIT_KWIN}" check_kwin || {
            err "KWin did not start on ${TARGET_DRM_DEVICE}. Capturing tmux pane:"
            _run_as_user "${TMUX_BIN}" capture-pane -pt "${SESSION}" -S -120 2>/dev/null | sed 's/^/[tmux] /' || true
            exit 1
        }
        local kpid
        kpid="$(get_kwin_pid_for_target)"
        echo "${kpid}" > "${PLASMA_PID_FILE}"
        log "kwin PID: ${kpid}"

        wait_for "Wayland socket" "${WAIT_WAYLAND}" check_wayland_socket || exit 1
        log "WAYLAND_DISPLAY: ${WAYLAND_DISPLAY_DETECTED}"

        wait_for "plasmashell" "${WAIT_PLASMA}" check_plasmashell || {
            err "plasmashell did not start. Capturing tmux pane:"
            _run_as_user "${TMUX_BIN}" capture-pane -pt "${SESSION}" -S -160 2>/dev/null | sed 's/^/[tmux] /' || true
            exit 1
        }
        log "plasmashell PID: $(_pid_first plasmashell)"
    fi

    echo "${sid}" > "${SESSION_ID_FILE}"
    echo "${TARGET_DRM_DEVICE}" > "${TARGET_DEVICE_FILE}"

    _start_sunshine_supervised || exit 1

    log "─── Health check ───"
    cmd_status_inner
    log "─── plasmactl start: SUCCESS ───"
}

_tmux_unlock_clients() {
    check_tmux_session || return 0
    local clients c
    clients="$(_run_as_user "${TMUX_BIN}" list-clients -t "${SESSION}" -F '#{client_name}' 2>/dev/null || true)"
    [[ -n "${clients}" ]] || return 0
    while IFS= read -r c; do
        [[ -n "${c}" ]] || continue
        _run_as_user "${TMUX_BIN}" lock-client -U -t "${c}" >/dev/null 2>&1 || true
    done <<< "${clients}"
}

_tmux_lock_clients() {
    check_tmux_session || return 0
    [[ "${LOCK_TMUX_ON_STOP}" == "true" || "${LOCK_TMUX_ON_STOP}" == "1" || "${LOCK_TMUX_ON_STOP}" == "yes" ]] || return 0
    log "Locking tmux session '${SESSION}' on physical tty..."
    _run_as_user "${TMUX_BIN}" lock-session -t "${SESSION}" >/dev/null 2>&1 || _run_as_user "${TMUX_BIN}" lock-server >/dev/null 2>&1 || true
}

_tmux_kill_main_session_if_requested() {
    [[ "${KILL_TMUX_ON_STOP}" == "true" || "${KILL_TMUX_ON_STOP}" == "1" || "${KILL_TMUX_ON_STOP}" == "yes" ]] || return 0
    if check_tmux_session; then
        log "KILL_TMUX_ON_STOP=true: killing tmux session '${SESSION}'..."
        _run_as_user "${TMUX_BIN}" kill-session -t "${SESSION}" >/dev/null 2>&1 || true
    fi
}

_return_to_idle_tty_on_stop() {
    [[ "${RETURN_TTY_ON_STOP}" == "true" || "${RETURN_TTY_ON_STOP}" == "1" || "${RETURN_TTY_ON_STOP}" == "yes" ]] || return 0
    local n="${RETURN_TTY_NAME#tty}" target="${RETURN_TTY_NAME}"
    [[ "${n}" =~ ^[0-9]+$ ]] || { _warn "RETURN_TTY_NAME=${RETURN_TTY_NAME} is invalid; skipping VT return"; return 0; }
    log "Returning physical console to ${target} after stop..."
    if _sudo "${CHVT_BIN}" "${n}" >/dev/null 2>&1; then
        sleep 0.5
        local active
        active="$(get_active_tty_name)"
        log "Active VT after stop: ${active:-unknown}"
    else
        _warn "Could not chvt to ${target}. Add sudoers NOPASSWD for ${CHVT_BIN} if needed."
    fi
}

_terminate_tty_session_if_requested() {
    [[ "${TERMINATE_TTY_SESSION_ON_STOP}" == "true" || "${TERMINATE_TTY_SESSION_ON_STOP}" == "1" || "${TERMINATE_TTY_SESSION_ON_STOP}" == "yes" ]] || return 0
    local sid
    sid="$(get_tty_session_id || true)"
    [[ -n "${sid}" ]] || return 0
    log "TERMINATE_TTY_SESSION_ON_STOP=true: terminating loginctl session ${sid} (${TTY_NAME})..."
    "${LOGINCTL_BIN}" terminate-session "${sid}" >/dev/null 2>&1 || _sudo "${LOGINCTL_BIN}" terminate-session "${sid}" >/dev/null 2>&1 || true
}

cmd_stop() {
    _LOG_CTX="stop"
    acquire_lock || return 1
    : > "${STOP_LOG}"
    exec > >(tee -a "${STOP_LOG}") 2>&1

    log "─── plasmactl stop v${VERSION} ───"

    if [[ "${PLASMA_SESSION_BACKEND}" == systemd-scope || -e "${SCOPE_STATE_FILE}" || -L "${SCOPE_STATE_FILE}" ]]; then
        _scope_stop
        return $?
    fi
    [[ "${PLASMA_SESSION_BACKEND}" == legacy ]] || { err "Unknown session backend."; return 2; }
    _stop_sunshine_if_active
    _stop_plasma_processes

    _run_as_user "${SYSTEMCTL_BIN}" --user unset-environment WAYLAND_DISPLAY KWIN_DRM_DEVICES XDG_SESSION_TYPE XDG_CURRENT_DESKTOP KDE_FULL_SESSION 2>/dev/null || true
    rm -f "${PLASMA_PID_FILE}" "${SUNSHINE_PID_FILE}" "${SESSION_ID_FILE}" "${WAYLAND_DISPLAY_FILE}"

    _tmux_lock_clients
    _tmux_kill_main_session_if_requested
    _terminate_tty_session_if_requested
    _return_to_idle_tty_on_stop

    log "State cleaned. ${TTY_NAME}/tmux preserved and locked when possible."
    log "─── plasmactl stop: SUCCESS ───"
}

cmd_restart() {
    local args=()
    ${VERBOSE} && args+=(--verbose)
    [[ -n "${PLASMA_GPU_OVERRIDE:-}" ]] && args+=("--gpu=${PLASMA_GPU_OVERRIDE}")
    [[ "${PLASMA_SESSION_BACKEND}" == legacy ]] || args+=("--session-backend=${PLASMA_SESSION_BACKEND}")
    # Stop uses the manifest, while --plasma-only is meaningful only on start.
    "$0" "${args[@]}" stop || return $?
    sleep 2
    [[ "${PLASMA_ONLY}" != true ]] || args+=(--plasma-only)
    "$0" "${args[@]}" start
}

# ─────────────────────────────────────────────────────────────────────────────
# STATUS / DOCTOR / LOGS / DIAGNOSTICS
# ─────────────────────────────────────────────────────────────────────────────

_st_ok()   { printf '\033[1;32mOK\033[0m\n'; }
_st_fail() { printf '\033[1;31mFAIL\033[0m\n'; }
_st_run()  { printf '\033[1;32mRUNNING\033[0m'; }
_st_dead() { printf '\033[1;31mSTOPPED\033[0m'; }
_section() { local t="$1"; printf '\n\033[1m%s\033[0m\n%s\n' "${t}" "$(printf '%0.s-' $(seq 1 ${#t}))"; }

cmd_status_inner() {
    resolve_plasma_drm_device >/dev/null 2>&1 || true
    local ready=true sid kpid ps wd

    _section "Session"
    printf '  %-24s ' "${TTY_NAME} loginctl:"; check_tty_session && _st_ok || { _st_fail; ready=false; }
    sid="$(get_tty_session_id || true)"
    [[ -n "${sid}" ]] && echo "    session=${sid} seat=$("${LOGINCTL_BIN}" show-session "${sid}" -p Seat --value 2>/dev/null || echo '?') active=$(get_session_active_state "${sid}") active_vt=$(get_active_tty_name)"
    printf '  %-24s ' "tmux ${SESSION}:"; check_tmux_session && _st_ok || { _st_fail; ready=false; }

    _section "Display"
    echo "  target DRM: ${TARGET_DRM_DEVICE:-not resolved}"
    printf '  %-24s ' "kwin_wayland:"; check_kwin && { _st_run; kpid="$(get_kwin_pid_for_target)"; echo " PID ${kpid}"; } || { _st_dead; echo; ready=false; }
    printf '  %-24s ' "Wayland socket:"; check_wayland_socket && { _st_ok; wd="${WAYLAND_DISPLAY_DETECTED}"; echo "    WAYLAND_DISPLAY=${wd}"; } || { _st_fail; ready=false; }
    printf '  %-24s ' "plasmashell:"; check_plasmashell && { _st_run; ps="$(_pid_first plasmashell)"; echo " PID ${ps}"; } || { _st_dead; echo; ready=false; }
    printf '  %-24s ' "Xwayland:"; check_xwayland && { _st_run; echo " PID $(_pid_first Xwayland)"; } || { _st_dead; echo; }

    case "${SUNSHINE_PROFILE}" in
        safe) [[ -z "${SUNSHINE_CONFIG_EFFECTIVE}" ]] && SUNSHINE_CONFIG_EFFECTIVE="${SUNSHINE_SAFE_CONFIG}" ;;
        performance|perf|max) [[ -z "${SUNSHINE_CONFIG_EFFECTIVE}" ]] && SUNSHINE_CONFIG_EFFECTIVE="${SUNSHINE_PERF_CONFIG}" ;;
    esac

    _section "Sunshine"
    echo "  start mode: ${SUNSHINE_START_MODE}"
    echo "  profile: ${SUNSHINE_PROFILE}"
    echo "  config effective: ${SUNSHINE_CONFIG_EFFECTIVE:-default}"
    echo "  supervise: ${SUNSHINE_SUPERVISE}"
    echo "  args: ${SUNSHINE_ARGS:-none}"

    if [[ "${SUNSHINE_START_MODE}" == "systemd-run" || "${SUNSHINE_START_MODE}" == "systemdrun" || "${SUNSHINE_START_MODE}" == "transient" ]]; then
        local sr_unit sr_pid
        sr_unit="$(_sunshine_systemd_unit_name).service"
        printf '  %-24s ' "systemd-run unit:"
        if sudo -n "${SYSTEMCTL_BIN}" is-active --quiet "${sr_unit}" 2>/dev/null; then
            _st_run; echo " ${sr_unit}"
        else
            _st_dead; echo " ${sr_unit}"; ready=false
        fi
        sr_pid="$(_sunshine_newest_pid)"
        if [[ -n "${sr_pid}" ]]; then
            echo "    sunshine PID=${sr_pid}"
            sudo -n ls -l "/proc/${sr_pid}/fd" 2>/dev/null | grep -E '/dev/dri|card|render' | sed 's/^/    fd: /' || true
        fi
    else
        printf '  %-24s ' "unit exists:"; check_sunshine_exists && _st_ok || { _st_fail; ready=false; }
        printf '  %-24s ' "service active:"; check_sunshine_service_active && { _st_run; echo; } || { _st_dead; echo; }
    fi
    printf '  %-24s ' "process:"; check_sunshine_process && { _st_run; echo " PID $(_sunshine_newest_pid)"; } || { _st_dead; echo; ready=false; }
    printf '  %-24s ' "required TCP ports:"; check_sunshine_required_tcp_ports && _st_ok || { _st_fail; ready=false; }
    _print_sunshine_ports_status

    _section "Stop security"
    echo "  lock tmux on stop:      ${LOCK_TMUX_ON_STOP}"
    echo "  kill tmux on stop:      ${KILL_TMUX_ON_STOP}"
    echo "  terminate tty session:  ${TERMINATE_TTY_SESSION_ON_STOP}"
    echo "  return tty on stop:     ${RETURN_TTY_ON_STOP} (${RETURN_TTY_NAME})"

    _section "State"
    ls -lh "${STATE_DIR}/" 2>/dev/null || echo "  (empty)"

    ${ready} && return 0 || return 1
}

cmd_status() {
    if [[ "${PLASMA_SESSION_BACKEND}" == systemd-scope || -e "${SCOPE_STATE_FILE}" || -L "${SCOPE_STATE_FILE}" ]]; then
        _scope_status
        return $?
    fi
    _LOG_CTX="status"; cmd_status_inner
}

cmd_doctor() {
    _LOG_CTX="doctor"
    local failures=0 bin sid
    resolve_plasma_drm_device >/dev/null 2>&1 || true

    echo ""
    printf '\033[1mplasmactl doctor v%s\033[0m\n' "${VERSION}"
    echo "───────────────────────"
    _info "Diagnostics only; automatic repairs are not implemented"
    echo ""

    echo "Binaries"; echo "--------"
    for bin in "${REQUIRED_BINS[@]}"; do
        command -v "${bin}" >/dev/null 2>&1 && _pass "${bin}" || { _fail "${bin}"; ((failures += 1)); }
    done
    command -v sunshine >/dev/null 2>&1 && _pass "sunshine binary" || _warn "sunshine binary not found in PATH"
    echo ""

    echo "Getty / ${TTY_NAME}"; echo "------------"
    "${SYSTEMCTL_BIN}" is-active --quiet "getty@${TTY_NAME}" && _pass "getty@${TTY_NAME} active" || { _fail "getty@${TTY_NAME} inactive"; ((failures += 1)); }
    if check_tty_session; then
        sid="$(get_tty_session_id)"
        _pass "${TTY_NAME} loginctl session active (session ${sid})"
        check_tty_seat0 && _pass "${TTY_NAME} on seat0" || { _fail "${TTY_NAME} not on seat0"; ((failures += 1)); }
        check_tty_active && _pass "${TTY_NAME} is active on seat0" || _warn "${TTY_NAME} is not active now (active VT=$(get_active_tty_name))"
    else
        _fail "no ${TTY_NAME} session in loginctl"; ((failures += 1))
    fi
    echo ""

    echo "DRM target"; echo "----------"
    if [[ -n "${TARGET_DRM_DEVICE}" && -e "${TARGET_DRM_DEVICE}" ]]; then
        _pass "Plasma target: ${TARGET_DRM_DEVICE}"
        case "${TARGET_DRM_DEVICE}" in
            */card*)
                local cn="${TARGET_DRM_DEVICE##*/}"
                local cd="/sys/class/drm/${cn}"
                if [[ -d "${cd}" ]]; then
                    _info "driver=$(_card_driver "${cd}") vendor=$(_card_vendor "${cd}")"
                    _is_vkms_card "${cd}" && _warn "selected target is VKMS/faux; real GPU is preferred"
                fi
                ;;
        esac
    else
        _fail "No usable DRM target selected"; ((failures += 1))
    fi
    _print_drm_map
    echo ""

    echo "TMUX"; echo "----"
    check_tmux_session && _pass "session '${SESSION}' exists" || { _fail "session '${SESSION}' not found"; ((failures += 1)); }
    check_tmux_attached && _pass "session '${SESSION}' attached" || _warn "session '${SESSION}' not attached"
    echo ""

    echo "Sunshine"; echo "--------"
    command -v sunshine >/dev/null 2>&1 && _pass "binary: $(command -v sunshine)" || { _fail "sunshine binary not found"; ((failures += 1)); }
    _info "start mode: ${SUNSHINE_START_MODE}"
    _info "profile: ${SUNSHINE_PROFILE}"
    if check_sunshine_ready; then
        _pass "Sunshine stream-ready: process + TCP ${SUNSHINE_REQUIRED_TCP_PORTS}"
    elif check_sunshine_process; then
        _warn "sunshine process exists but required TCP listeners are missing"
    else
        _info "sunshine not running before start is OK"
    fi
    echo ""

    echo "Summary"; echo "-------"
    if [[ ${failures} -eq 0 ]]; then
        printf '\033[1;32m✓ All critical checks passed\033[0m\n'
    else
        printf '\033[1;31m✗ %d critical check(s) failed\033[0m\n' "${failures}"
    fi
    echo ""
    return $(( failures > 0 ? 1 : 0 ))
}

