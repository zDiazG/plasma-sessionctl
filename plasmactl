    _LOG_CTX="cleanup"
    acquire_lock || return 1
    # Recheck after acquiring the lock: start may have created state meanwhile.
    if [[ -e "${SCOPE_STATE_FILE}" || -L "${SCOPE_STATE_FILE}" ]]; then
        err "Scope execution state exists; refusing cleanup."
        return 1
    fi
    log "Cleaning up state files..."
    rm -f "${PLASMA_PID_FILE}" "${SUNSHINE_PID_FILE}" "${SESSION_ID_FILE}" "${TARGET_DEVICE_FILE}" "${WAYLAND_DISPLAY_FILE}"
    log "Done."
    ls -lh "${STATE_DIR}/" 2>/dev/null || true
}

