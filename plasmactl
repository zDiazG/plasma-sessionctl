# Optional structured JSON overlay configuration support
_apply_json_scalar() {
    local var="$1" jqpath="$2" present val
    command -v jq >/dev/null 2>&1 || return 0
    [[ -f "${PLASMACTL_JSON_CONFIG}" ]] || return 0
    if ! present="$(jq -e "(${jqpath}) != null" "${PLASMACTL_JSON_CONFIG}" 2>/dev/null)" || [[ "${present}" != true ]]; then
        return 0
    fi
    val="$(jq -r "(${jqpath}) | if type == \"array\" then join(\" \") elif type == \"object\" then error(\"expected a scalar or array\") else tostring end" "${PLASMACTL_JSON_CONFIG}")" || {
        echo "[plasmactl] ERROR: Invalid JSON value for ${var} in ${PLASMACTL_JSON_CONFIG}" >&2
        return 1
    }
    printf -v "${var}" '%s' "${val}"
}

