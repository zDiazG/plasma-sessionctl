# Run user-space tools under REAL_USER context when script runs as root
_run_as_user() (
    # A tmux client or any long-lived child must not retain the lifecycle lock.
    if [[ -n "${PLASMACTL_LOCK_FD:-}" ]]; then
        exec {PLASMACTL_LOCK_FD}>&-
    fi
    if [[ "${EUID}" -eq 0 ]]; then
        sudo -u "${REAL_USER}" "$@"
    else
        "$@"
    fi
)

_sudo() {
    sudo -n "$@"
}

_priv() {
    if [[ "${EUID}" -eq 0 ]]; then
        "$@"
    else
        _sudo "$@"
    fi
}

