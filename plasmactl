_write_sunshine_profile_conf() {
    local target_file="$1" profile_name="$2" min_log="$3" encoder="$4" capture="$5" max_bitrate="$6" fps="$7" qp="$8" fec="$9" apps_file="${10}"
    shift 10

    local name adapter output csrf default_host
    default_host="plasmactl-$(hostname 2>/dev/null || echo "host")"
    name="$(_sunshine_conf_get sunshine_name 2>/dev/null || true)"
    adapter="$(_selected_sunshine_adapter 2>/dev/null || true)"
    output="$(_selected_sunshine_output 2>/dev/null || true)"
    csrf="$(_sunshine_conf_get csrf_allowed_origins 2>/dev/null || true)"
    [[ -z "${name}" ]] && name="${default_host}"

    cat > "${target_file}" <<EOF_SUNSHINE_CONF
# Generated by plasmactl v${VERSION} (${profile_name} profile)
# Purpose: ${profile_name} Sunshine profile for KDE Wayland + KMS capture.

sunshine_name = ${name}
min_log_level = ${min_log}
system_tray = disabled

address_family = ipv4
bind_address = 0.0.0.0
port = 47989
upnp = disabled
lan_encryption_mode = 0
wan_encryption_mode = 0
ping_timeout = ${SUNSHINE_SAFE_PING_TIMEOUT}

keyboard = enabled
mouse = enabled
controller = enabled
gamepad = auto
high_resolution_scrolling = enabled
native_pen_touch = enabled

file_apps = $(basename "${apps_file}")
credentials_file = sunshine_state.json
file_state = sunshine_state.json
pkey = ${SUNSHINE_CONFIG_DIR}/credentials/cakey.pem
cert = ${SUNSHINE_CONFIG_DIR}/credentials/cacert.pem

${adapter:+adapter_name = ${adapter}
}${output:+output_name = ${output}
}capture = ${capture}
encoder = ${encoder}
hevc_mode = ${SUNSHINE_PERF_HEVC_MODE}
av1_mode = ${SUNSHINE_PERF_AV1_MODE}
max_bitrate = ${max_bitrate}
minimum_fps_target = ${fps}
fec_percentage = ${fec}
qp = ${qp}
EOF_SUNSHINE_CONF

    # Append any extra profile-specific key=value settings
    local extra
    for extra in "$@"; do
        echo "${extra}" >> "${target_file}"
    done

    if [[ -n "${csrf}" ]]; then
        printf 'csrf_allowed_origins = %s\n' "${csrf}" >> "${target_file}"
    fi
}

_write_sunshine_safe_assets() {
