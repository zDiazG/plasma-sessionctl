_kwin_pids() { pgrep -u "${REAL_UID}" -x kwin_wayland 2>/dev/null || true; }
_plasmashell_pids() { pgrep -u "${REAL_UID}" -x plasmashell 2>/dev/null || true; }
_xwayland_pids() { pgrep -u "${REAL_UID}" -x Xwayland 2>/dev/null || true; }

get_kwin_pid_for_target() {
    local pid envdev
    while IFS= read -r pid; do
        [[ -n "${pid}" ]] || continue
        envdev="$(_pid_env "${pid}" 2>/dev/null | awk -F= '$1=="KWIN_DRM_DEVICES" {print $2; exit}' || true)"
        if [[ -n "${TARGET_DRM_DEVICE}" && "${envdev}" == *"${TARGET_DRM_DEVICE}"* ]]; then
            echo "${pid}"
            return 0
        fi
    done < <(_kwin_pids)

    local count first
    count="$(_kwin_pids | awk 'NF{c++} END{print c+0}')"
    if [[ "${count}" == "1" ]]; then
        first="$(_kwin_pids | awk 'NF{print; exit}')"
        [[ -n "${first}" ]] && echo "${first}" && return 0
    fi
    return 1
}

check_kwin() { [[ -n "$(get_kwin_pid_for_target 2>/dev/null || true)" ]]; }
check_plasmashell() { [[ -n "$(_pid_first plasmashell)" ]]; }
check_xwayland() { [[ -n "$(_pid_first Xwayland)" ]]; }
check_startplasma_running() { pgrep -u "${REAL_UID}" -fa 'startplasma-wayland|dbus-run-session.*startplasma' >/dev/null 2>&1; }

_detect_wayland_display_from_pid() {
    local pid="$1" wd xrd
    wd="$(_pid_env "${pid}" 2>/dev/null | awk -F= '$1=="WAYLAND_DISPLAY" {print $2; exit}' || true)"
    xrd="$(_pid_env "${pid}" 2>/dev/null | awk -F= '$1=="XDG_RUNTIME_DIR" {print $2; exit}' || true)"
    [[ -z "${xrd}" ]] && xrd="${RUNTIME_DIR}"
    if [[ -n "${wd}" && -S "${xrd}/${wd}" ]]; then
        WAYLAND_DISPLAY_DETECTED="${wd}"
        echo "${wd}" > "${WAYLAND_DISPLAY_FILE}"
        return 0
    fi
    return 1
}

check_wayland_socket() {
    local pid sock base
    pid="$(get_kwin_pid_for_target 2>/dev/null || true)"
    [[ -n "${pid}" ]] && _detect_wayland_display_from_pid "${pid}" && return 0
    while IFS= read -r sock; do
        [[ -S "${sock}" ]] || continue
        base="$(basename "${sock}")"
        WAYLAND_DISPLAY_DETECTED="${base}"
        echo "${base}" > "${WAYLAND_DISPLAY_FILE}"
        return 0
    done < <(find "${RUNTIME_DIR}" -maxdepth 1 -type s -name 'wayland-*' 2>/dev/null | sort)
    return 1
}

check_plasma_healthy() {
    check_kwin && check_wayland_socket && check_plasmashell
}

# Polling loops optimized to 0.2s intervals (5 ticks per second)
wait_for() {
    local label="$1" timeout="$2" check_fn="$3" waited_ticks=0
    local max_ticks=$(( timeout * 5 ))
    log "Waiting for ${label} (max ${timeout}s)..."
    while ! ${check_fn}; do
        if [[ ${waited_ticks} -ge ${max_ticks} ]]; then
            err "Timeout waiting for ${label} after ${timeout}s"
            return 1
        fi
        sleep 0.2
        (( waited_ticks += 1 ))
    done
    local sec=$(( waited_ticks / 5 ))
    local tenths=$(( (waited_ticks % 5) * 2 ))
    log "${label} ready after ${sec}.${tenths}s"
}

wait_gone() {
    local label="$1" timeout="$2" check_fn="$3" waited_ticks=0
    local max_ticks=$(( timeout * 5 ))
    log "Waiting for ${label} to exit (max ${timeout}s)..."
    while ${check_fn}; do
        if [[ ${waited_ticks} -ge ${max_ticks} ]]; then
            err "Timeout: ${label} still running after ${timeout}s"
            return 1
        fi
        sleep 0.2
        (( waited_ticks += 1 ))
    done
    local sec=$(( waited_ticks / 5 ))
    local tenths=$(( (waited_ticks % 5) * 2 ))
    log "${label} exited after ${sec}.${tenths}s"
}

_stop_plasma_processes() {
    if check_plasmashell; then
        log "Stopping plasmashell for user ${REAL_USER}..."
        pkill -u "${REAL_UID}" -TERM plasmashell 2>/dev/null || true
        wait_gone "plasmashell" "${WAIT_STOP}" check_plasmashell || pkill -u "${REAL_UID}" -KILL plasmashell 2>/dev/null || true
    fi
    if check_xwayland; then
        log "Stopping Xwayland for user ${REAL_USER}..."
        pkill -u "${REAL_UID}" -TERM Xwayland 2>/dev/null || true
        wait_gone "Xwayland" 5 check_xwayland || pkill -u "${REAL_UID}" -KILL Xwayland 2>/dev/null || true
    fi
    if check_kwin || [[ -n "$(_pid_first kwin_wayland)" ]]; then
        log "Stopping kwin_wayland for user ${REAL_USER}..."
        pkill -u "${REAL_UID}" -TERM kwin_wayland 2>/dev/null || true
        wait_gone "kwin_wayland" "${WAIT_STOP}" check_any_kwin || pkill -u "${REAL_UID}" -KILL kwin_wayland 2>/dev/null || true
    fi
    pkill -u "${REAL_UID}" -TERM -f 'dbus-run-session.*startplasma-wayland' 2>/dev/null || true
    pkill -u "${REAL_UID}" -TERM -f 'startplasma-wayland' 2>/dev/null || true
}

check_any_kwin() { [[ -n "$(_pid_first kwin_wayland)" ]]; }

# ─────────────────────────────────────────────────────────────────────────────
# SUNSHINE MANAGED COMPONENT
# ─────────────────────────────────────────────────────────────────────────────

check_sunshine_exists() {
    _run_as_user "${SYSTEMCTL_BIN}" --user cat "${SUNSHINE_UNIT}" >/dev/null 2>&1 || _run_as_user "${SYSTEMCTL_BIN}" --user cat sunshine.service >/dev/null 2>&1
}
check_sunshine_service_active() { _run_as_user "${SYSTEMCTL_BIN}" --user is-active --quiet "${SUNSHINE_UNIT}" 2>/dev/null; }
check_sunshine_enabled()        { _run_as_user "${SYSTEMCTL_BIN}" --user is-enabled --quiet "${SUNSHINE_UNIT}" 2>/dev/null; }
check_sunshine_process()        { pgrep -u "${REAL_UID}" -x sunshine >/dev/null 2>&1; }
check_sunshine()                { check_sunshine_process; }

_sunshine_pids()       { pgrep -u "${REAL_UID}" -x sunshine 2>/dev/null || true; }
_sunshine_newest_pid() { _pid_newest sunshine; }

_sunshine_listeners() {
    {
        ss -lntup 2>/dev/null || true
        ss -lnup 2>/dev/null || true
    } | grep -E 'sunshine|47984|47989|47990|48010|47998|47999|48000' || true
}

_tcp_port_listening() {
    local port="$1"
    ss -ltn 2>/dev/null | awk -v p=":${port}" '$4 ~ p"$" {found=1} END{exit !found}'
}

_udp_port_listening() {
    local port="$1"
    ss -lun 2>/dev/null | awk -v p=":${port}" '$4 ~ p"$" {found=1} END{exit !found}'
}

check_sunshine_required_tcp_ports() {
    local port
    for port in ${SUNSHINE_REQUIRED_TCP_PORTS}; do
        _tcp_port_listening "${port}" || return 1
    done
}

check_sunshine_ready() {
    check_sunshine_process && check_sunshine_required_tcp_ports
}

_print_sunshine_ports_status() {
    local port ok_any=false
    for port in ${SUNSHINE_TCP_PORTS}; do
        if _tcp_port_listening "${port}"; then
            printf '    tcp/%s: LISTEN\n' "${port}"
            ok_any=true
        else
            printf '    tcp/%s: closed\n' "${port}"
        fi
    done
    for port in ${SUNSHINE_UDP_PORTS}; do
        if _udp_port_listening "${port}"; then
            printf '    udp/%s: LISTEN\n' "${port}"
        fi
    done
    ${ok_any} || true
}

_show_sunshine_failure() {
    err "Sunshine is not stream-ready. Required TCP listeners missing: ${SUNSHINE_REQUIRED_TCP_PORTS}"
    echo "[sunshine-listeners]"
    _sunshine_listeners | sed 's/^/[sunshine-listeners] /' || true
    echo "[sunshine-processes]"
    pgrep -u "${REAL_UID}" -a sunshine 2>/dev/null | sed 's/^/[sunshine-process] /' || echo "[sunshine-process] none"
    echo "[sunshine-service]"
    _run_as_user "${SYSTEMCTL_BIN}" --user status "${SUNSHINE_UNIT}" --no-pager -l 2>&1 | sed 's/^/[sunshine-status] /' || true
    echo "[sunshine-journal]"
    _run_as_user journalctl --user -u "${SUNSHINE_UNIT}" -n 100 --no-pager 2>&1 | sed 's/^/[sunshine-journal] /' || true
    echo "[sunshine-tmux-log]"
    [[ -f "${SUNSHINE_TMUX_LOG}" ]] && tail -n 120 "${SUNSHINE_TMUX_LOG}" | sed 's/^/[sunshine-tmux] /' || echo "[sunshine-tmux] no tmux log"
}

_stop_sunshine_systemd() {
    _run_as_user "${SYSTEMCTL_BIN}" --user stop "${SUNSHINE_UNIT}" sunshine.service >/dev/null 2>&1 || true
    _run_as_user "${SYSTEMCTL_BIN}" --user reset-failed "${SUNSHINE_UNIT}" sunshine.service >/dev/null 2>&1 || true
}

_stop_sunshine_tmux_window() {
    if _run_as_user "${TMUX_BIN}" list-windows -t "${SESSION}" -F '#{window_name}' 2>/dev/null | grep -qx "${SUNSHINE_WINDOW}"; then
        log "Stopping Sunshine tmux window '${SUNSHINE_WINDOW}'..."
        _run_as_user "${TMUX_BIN}" kill-window -t "${SESSION}:${SUNSHINE_WINDOW}" >/dev/null 2>&1 || true
    fi
}

_stop_sunshine_if_active() {
    local had=false
    if check_sunshine_service_active; then had=true; fi
    if check_sunshine_process; then had=true; fi
    if _run_as_user "${TMUX_BIN}" list-windows -t "${SESSION}" -F '#{window_name}' 2>/dev/null | grep -qx "${SUNSHINE_WINDOW}"; then had=true; fi

    ${had} && log "Stopping Sunshine before Plasma transition..." || true
    _stop_sunshine_systemd_run
    _stop_sunshine_systemd
    _stop_sunshine_tmux_window

    if check_sunshine_process; then
        pkill -u "${REAL_UID}" -TERM -x sunshine 2>/dev/null || true
        wait_gone "sunshine process" "${WAIT_STOP}" check_sunshine_process || pkill -u "${REAL_UID}" -KILL -x sunshine 2>/dev/null || true
    fi
    rm -f "${SUNSHINE_PID_FILE}"
}

_set_systemd_user_env_for_sunshine() {
    [[ -n "${WAYLAND_DISPLAY_DETECTED}" ]] || check_wayland_socket || true
    local wd="${WAYLAND_DISPLAY_DETECTED:-}"
    [[ -z "${wd}" && -f "${WAYLAND_DISPLAY_FILE}" ]] && wd="$(cat "${WAYLAND_DISPLAY_FILE}" 2>/dev/null || true)"
    if [[ -n "${wd}" ]]; then
        log "Importing Wayland environment into systemd --user (WAYLAND_DISPLAY=${wd})"
        _run_as_user "${SYSTEMCTL_BIN}" --user set-environment \
            "XDG_RUNTIME_DIR=${RUNTIME_DIR}" \
            "XDG_SESSION_TYPE=wayland" \
            "XDG_CURRENT_DESKTOP=KDE" \
            "KDE_FULL_SESSION=true" \
            "KWIN_DRM_DEVICES=${TARGET_DRM_DEVICE}" \
            "WAYLAND_DISPLAY=${wd}" 2>/dev/null || true
    else
        _warn "WAYLAND_DISPLAY not detected; Sunshine will start without Wayland env import"
    fi
}

_warn_if_sunshine_selected_vkms() {
    local since="${1:-}" fresh
    [[ -n "${since}" ]] || since="5 minutes ago"
    fresh="$(_run_as_user journalctl --user -u "${SUNSHINE_UNIT}" --since "${since}" --no-pager 2>/dev/null || true)"
    if printf '%s\n' "${fresh}" | grep -Eq '/dev/dri/card[0-9]+ -> (vkms|faux)|No render device name for: /dev/dri/card[0-9]+'; then
        _warn "Sunshine appears to be selecting VKMS/faux for KMS capture. This can cause stream/RTSP failures."
        printf '%s\n' "${fresh}" | grep -E '/dev/dri/card[0-9]+ ->|No render device name|wlgrab|wayland|KMS|CLIENT|RTSP|Error' | tail -n 25 | sed 's/^/[sunshine-fresh] /' || true
    fi
}

_sunshine_conf_get() {
    local key="$1" file="${2:-${SUNSHINE_DEFAULT_CONFIG}}"
    [[ -f "${file}" ]] || return 1
    awk -F= -v k="${key}" '
        {
            lhs=$1
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", lhs)
            if (lhs == k) {
                $1=""
                sub(/^=/, "")
                gsub(/^[[:space:]]+|[[:space:]]+$/, "")
                print
                exit
            }
        }
    ' "${file}"
}

_selected_sunshine_adapter() {
    local selected_card adapter
    if [[ -n "${SUNSHINE_ADAPTER_NAME}" ]]; then
        echo "${SUNSHINE_ADAPTER_NAME}"; return 0
    fi
    case "${SUNSHINE_ADAPTER_MODE}" in
        disabled|none|off|auto|"")
            return 1
            ;;
        preserve)
            adapter="$(_sunshine_conf_get adapter_name 2>/dev/null || true)"
            [[ -n "${adapter}" ]] && { echo "${adapter}"; return 0; }
            return 1
            ;;
        selected)
            selected_card="$(basename "${TARGET_DRM_DEVICE:-}" 2>/dev/null || true)"
            if [[ -n "${selected_card}" ]]; then
                adapter="$(_card_render_node "${selected_card}" 2>/dev/null || true)"
                [[ -n "${adapter}" ]] && { echo "${adapter}"; return 0; }
            fi
            return 1
            ;;
        path)
            [[ -n "${SUNSHINE_ADAPTER_NAME}" ]] && { echo "${SUNSHINE_ADAPTER_NAME}"; return 0; }
            return 1
            ;;
        *)
            _warn "Unknown SUNSHINE_ADAPTER_MODE=${SUNSHINE_ADAPTER_MODE}; leaving adapter_name unset."
            return 1
            ;;
    esac
}

_selected_sunshine_output() {
    local output=""
    case "${SUNSHINE_OUTPUT_MODE}" in
        disabled|none|off)
            return 1
            ;;
        preserve)
            output="$(_sunshine_conf_get output_name 2>/dev/null || true)"
            [[ -n "${output}" ]] && { echo "${output}"; return 0; }
            return 1
            ;;
        selected|auto|"")
            output="${SUNSHINE_OUTPUT_NAME:-0}"
            [[ -n "${output}" ]] && { echo "${output}"; return 0; }
            echo "0"; return 0
            ;;
        path|name|id)
            output="${SUNSHINE_OUTPUT_NAME:-}"
            [[ -n "${output}" ]] && { echo "${output}"; return 0; }
            return 1
            ;;
        *)
            echo "${SUNSHINE_OUTPUT_NAME:-0}"; return 0
            ;;
    esac
}

# ─────────────────────────────────────────────────────────────────────────────
# REFACTORED DRY SUNSHINE PROFILE GENERATION
