# ─────────────────────────────────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────────────────────────────────

_ts() { date '+%Y-%m-%d %H:%M:%S'; }

log() {
    local msg="[${_LOG_CTX:-plasmactl}] $(_ts) $*"
    echo "${msg}"
    echo "${msg}" >> "${LAST_LOG}"
}

vlog() {
    local msg="[${_LOG_CTX:-plasmactl}] $(_ts) [v] $*"
    ${VERBOSE} && echo "${msg}" || true
    echo "${msg}" >> "${LAST_LOG}"
}

err() {
    local msg="[${_LOG_CTX:-plasmactl}] $(_ts) ERROR: $*"
    echo "${msg}" >&2
    echo "${msg}" >> "${LAST_LOG}"
}

_pass() { printf '  \033[1;32m✓\033[0m %s\n' "$*"; }
_fail() { printf '  \033[1;31m✗\033[0m %s\n' "$*"; }
_warn() { printf '  \033[1;33m!\033[0m %s\n' "$*"; }
_info() { printf '  \033[1;34m→\033[0m %s\n' "$*"; }

# ─────────────────────────────────────────────────────────────────────────────
# GENERAL HELPERS
# ─────────────────────────────────────────────────────────────────────────────

_sudo() {
    if sudo -n true 2>/dev/null; then
        sudo -n "$@"
    else
        return 1
    fi
}

_priv() {
    if [[ "${EUID}" -eq 0 ]]; then
        "$@"
    else
        _sudo "$@"
    fi
}

_bool_true() {
    case "${1:-}" in true|yes|1|on|enabled) return 0 ;; *) return 1 ;; esac
}

_pid_first() {
    local name="$1"
    pgrep -xo "${name}" 2>/dev/null || true
}

_pid_newest() {
    local name="$1"
    pgrep -xn "${name}" 2>/dev/null || true
}

_pid_env() {
    local pid="$1"
    [[ -n "${pid}" && -r "/proc/${pid}/environ" ]] || return 1
    tr '\0' '\n' < "/proc/${pid}/environ" 2>/dev/null
}

_escape_sq() {
    # Safe single-quote escape for shell injection into tmux.
    printf "%s" "$1" | sed "s/'/'\\''/g"
}

check_required_bins() {
    local missing=() bin
    for bin in "${REQUIRED_BINS[@]}"; do
        command -v "${bin}" >/dev/null 2>&1 || missing+=("${bin}")
    done
    if [[ ${#missing[@]} -gt 0 ]]; then
        err "Missing required binaries: ${missing[*]}"
        return 1
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
# LOCK
# ─────────────────────────────────────────────────────────────────────────────

acquire_lock() {
    local timeout=10 waited=0 holder=""
    vlog "Acquiring lock..."
    while ! (set -o noclobber; echo $$ > "${LOCK_FILE}") 2>/dev/null; do
        holder="$(cat "${LOCK_FILE}" 2>/dev/null || echo unknown)"
        if [[ "${holder}" =~ ^[0-9]+$ ]] && ! kill -0 "${holder}" 2>/dev/null; then
            vlog "Removing stale lock from dead PID ${holder}"
            rm -f "${LOCK_FILE}"
            continue
        fi
        if [[ ${waited} -ge ${timeout} ]]; then
            err "Lock held by PID ${holder} after ${timeout}s — run: plasmactl cleanup"
            exit 1
        fi
        sleep 1; (( waited++ ))
    done
    trap release_lock EXIT
    vlog "Lock acquired (PID $$)"
}
release_lock() { rm -f "${LOCK_FILE}"; }

# ─────────────────────────────────────────────────────────────────────────────
# LOGINCTL / TMUX
# ─────────────────────────────────────────────────────────────────────────────

get_tty_session_id() {
    loginctl list-sessions --no-legend 2>/dev/null | awk -v tty="${TTY_NAME}" '$7==tty {print $1; exit}'
}

check_tty_session() {
    [[ -n "$(get_tty_session_id)" ]]
}

check_tty_seat0() {
    local sid; sid="$(get_tty_session_id)"
    [[ -n "${sid}" ]] || return 1
    loginctl show-session "${sid}" -p Seat --value 2>/dev/null | grep -qx 'seat0'
}

get_session_active_state() {
    local sid="$1"
    [[ -n "${sid}" ]] || return 1
    loginctl show-session "${sid}" -p Active --value 2>/dev/null || true
}

get_active_session_id() {
    loginctl show-seat seat0 -p ActiveSession --value 2>/dev/null | awk '{print $1}'
}

get_active_tty_name() {
    local active_sid tty=""
    active_sid="$(get_active_session_id || true)"
    if [[ -n "${active_sid}" ]]; then
        tty="$(loginctl show-session "${active_sid}" -p TTY --value 2>/dev/null || true)"
    fi
    if [[ -z "${tty}" && -r /sys/class/tty/tty0/active ]]; then
        tty="$(cat /sys/class/tty/tty0/active 2>/dev/null | awk '{print $NF}')"
    fi
    echo "${tty}"
}

check_tty_active() {
    local sid; sid="$(get_tty_session_id)"
    [[ -n "${sid}" ]] || return 1
    [[ "$(get_session_active_state "${sid}")" == "yes" ]]
}

_activate_tty_session() {
    local sid="$1" target_tty="${TTY_NAME}"
    [[ -n "${sid}" ]] || return 1

    log "Activating ${target_tty} session ${sid} on seat0 before Plasma/KMS capture..."

    # Prefer non-interactive chvt first to avoid Polkit password prompts over SSH.
    # Fallback to loginctl activate when chvt is not permitted.
    if _sudo /usr/bin/chvt "${target_tty#tty}" >/dev/null 2>&1; then
        vlog "sudo -n /usr/bin/chvt ${target_tty#tty}: OK"
    elif loginctl activate "${sid}" >/dev/null 2>&1; then
        vlog "loginctl activate ${sid}: OK"
    else
        _warn "Could not switch active VT automatically. Configure passwordless sudo for chvt or run: sudo chvt ${target_tty#tty}"
    fi

    local waited active_tty active_state
    for ((waited=0; waited<TTY_ACTIVATE_TIMEOUT; waited++)); do
        active_state="$(get_session_active_state "${sid}")"
        active_tty="$(get_active_tty_name)"
        if [[ "${active_state}" == "yes" || "${active_tty}" == "${target_tty}" ]]; then
            log "Active VT: ${active_tty:-unknown}; ${target_tty} session Active=${active_state:-unknown}"
            return 0
        fi
        sleep 1
    done

    active_state="$(get_session_active_state "${sid}")"
    active_tty="$(get_active_tty_name)"
    _warn "${target_tty} is not active after ${TTY_ACTIVATE_TIMEOUT}s (active VT=${active_tty:-unknown}, session Active=${active_state:-unknown})"
    return 1
}

ensure_tty_active_for_kms() {
    local sid="$1"
    [[ "${ACTIVATE_TTY_ON_START}" == "true" ]] || return 0
    if check_tty_active; then
        log "${TTY_NAME} is already the active seat0 session"
        return 0
    fi
    _activate_tty_session "${sid}" && return 0
    if [[ "${REQUIRE_ACTIVE_TTY_ON_START}" == "true" ]]; then
        err "${TTY_NAME} is not active. KMS capture will stream the current VT/login screen instead of Plasma."
        echo "Fix once: echo '${REAL_USER} ALL=(root) NOPASSWD: /usr/bin/chvt' | sudo tee /etc/sudoers.d/plasmactl-chvt" >&2
        echo "Then retry: ~/bin/plasmactl restart --verbose" >&2
        return 1
    fi
    return 0
}

check_tmux_session() {
    tmux has-session -t "${SESSION}" 2>/dev/null || return 1
    tmux list-windows -t "${SESSION}" >/dev/null 2>&1
}

check_tmux_attached() {
    check_tmux_session || return 1
    local attached
    attached="$(tmux display-message -p -t "${SESSION}" '#{session_attached}' 2>/dev/null || echo 0)"
    [[ "${attached}" != "0" ]]
}

send_tmux_command() {
    local cmd="$1"
    tmux send-keys -t "${SESSION}" C-c
    sleep 0.2
    tmux send-keys -t "${SESSION}" "${cmd}" C-m
}

# ─────────────────────────────────────────────────────────────────────────────
# DRM / GPU DETECTION
# ─────────────────────────────────────────────────────────────────────────────

_card_name_from_dir() { basename "$1"; }
_card_dev_from_name() { printf '/dev/dri/%s' "$1"; }

_card_device_path() {
    local card_dir="$1"
    readlink -f "${card_dir}/device" 2>/dev/null || true
}

_card_driver() {
    local card_dir="$1" mod_link drv_link dev_path
    mod_link="${card_dir}/device/driver/module"
    if [[ -e "${mod_link}" ]]; then
        readlink -f "${mod_link}" 2>/dev/null | xargs basename 2>/dev/null && return
    fi
    drv_link="${card_dir}/device/driver"
    if [[ -e "${drv_link}" ]]; then
        basename "$(readlink -f "${drv_link}" 2>/dev/null || true)" 2>/dev/null && return
    fi
    dev_path="$(_card_device_path "${card_dir}")"
    [[ -n "${dev_path}" ]] && basename "${dev_path}" || echo "unknown"
}

_card_vendor() {
    local f="$1/device/vendor"
    [[ -r "${f}" ]] && tr -d '[:space:]' < "${f}" || echo ""
}

_card_render_node() {
    local card_name="$1" r node byp
    for r in /sys/class/drm/${card_name}/device/drm/renderD*; do
        [[ -e "${r}" ]] || continue
        node="/dev/dri/$(basename "${r}")"
        # Prefer stable by-path symlink when available. Sunshine accepts /dev/dri/renderD*;
        # by-path avoids stale renderD numbering across reboots on multi-GPU hosts.
        for byp in /dev/dri/by-path/*-render; do
            [[ -e "${byp}" ]] || continue
            if [[ "$(readlink -f "${byp}" 2>/dev/null || true)" == "$(readlink -f "${node}" 2>/dev/null || true)" ]]; then
                echo "${byp}"
                return 0
            fi
        done
        echo "${node}"
        return 0
    done
    return 1
}

_card_driver_from_dev() {
    local dev="$1" card_dir
    card_dir="/sys/class/drm/$(basename "${dev}")"
    [[ -d "${card_dir}" ]] || return 1
    _card_driver "${card_dir}"
}

_selected_sunshine_adapter() {
    local selected_card adapter
    if [[ -n "${SUNSHINE_ADAPTER_NAME}" ]]; then
        echo "${SUNSHINE_ADAPTER_NAME}"; return 0
    fi
    case "${SUNSHINE_ADAPTER_MODE}" in
        disabled|none|off|auto|"")
            # In v0.4.0 systemd-run mode, GPU selection is enforced by DeviceAllow.
            # Leaving adapter_name unset lets Sunshine auto-select the only permitted GPU.
            return 1
            ;;
        preserve)
            adapter="$(_sunshine_conf_get adapter_name 2>/dev/null || true)"
            [[ -n "${adapter}" ]] && { echo "${adapter}"; return 0; }
            return 1
            ;;
        selected)
            selected_card="$(basename "${TARGET_DRM_DEVICE:-}" 2>/dev/null || true)"
            if [[ -n "${selected_card}" ]]; then
                adapter="$(_card_render_node "${selected_card}" 2>/dev/null || true)"
                [[ -n "${adapter}" ]] && { echo "${adapter}"; return 0; }
            fi
            return 1
            ;;
        path)
            [[ -n "${SUNSHINE_ADAPTER_NAME}" ]] && { echo "${SUNSHINE_ADAPTER_NAME}"; return 0; }
            return 1
            ;;
        *)
            _warn "Unknown SUNSHINE_ADAPTER_MODE=${SUNSHINE_ADAPTER_MODE}; leaving adapter_name unset."
            return 1
            ;;
    esac
}


_selected_sunshine_output() {
    local output=""
    case "${SUNSHINE_OUTPUT_MODE}" in
        disabled|none|off)
            return 1
            ;;
        preserve)
            output="$(_sunshine_conf_get output_name 2>/dev/null || true)"
            [[ -n "${output}" ]] && { echo "${output}"; return 0; }
            return 1
            ;;
        selected|auto|"")
            # Sunshine expects a display id for Linux. Because KWin is started on the selected DRM
            # device, the compositor-visible stream output should be display id 0 in Sunshine's list.
            output="${SUNSHINE_OUTPUT_NAME:-0}"
            [[ -n "${output}" ]] && { echo "${output}"; return 0; }
            echo "0"; return 0
            ;;
        path|name|id)
            output="${SUNSHINE_OUTPUT_NAME:-}"
            [[ -n "${output}" ]] && { echo "${output}"; return 0; }
            return 1
            ;;
        *)
            _warn "Unknown SUNSHINE_OUTPUT_MODE=${SUNSHINE_OUTPUT_MODE}; using output_name=${SUNSHINE_OUTPUT_NAME:-0}."
            echo "${SUNSHINE_OUTPUT_NAME:-0}"; return 0
            ;;
    esac
}

_card_has_connected_display() {
    local card_name="$1" connector status
    for connector in /sys/class/drm/${card_name}-*; do
        [[ -f "${connector}/status" ]] || continue
        status="$(tr -d '[:space:]' < "${connector}/status" 2>/dev/null || true)"
        [[ "${status}" == "connected" ]] && return 0
    done
    return 1
}

_card_connected_connectors() {
    local card_name="$1" connector status
    for connector in /sys/class/drm/${card_name}-*; do
        [[ -f "${connector}/status" ]] || continue
        status="$(tr -d '[:space:]' < "${connector}/status" 2>/dev/null || true)"
        [[ "${status}" == "connected" ]] && basename "${connector}"
    done
}

_first_connected_connector() {
    local connector status
    for connector in /sys/class/drm/card[0-9]*-*; do
        [[ -f "${connector}/status" ]] || continue
        status="$(tr -d '[:space:]' < "${connector}/status" 2>/dev/null || true)"
        [[ "${status}" == "connected" ]] && { basename "${connector}"; return 0; }
    done
    return 1
}

_connector_short_name() {
    # card1-HDMI-A-1 -> HDMI-A-1
    local name="$1"
    echo "${name}" | sed -E 's/^card[0-9]+-//'
}

_connector_sysfs_path() {
    local input="$1" connector
    # Accept card1-HDMI-A-1 or HDMI-A-1. Prefer exact card-qualified path.
    if [[ -d "/sys/class/drm/${input}" ]]; then
        echo "/sys/class/drm/${input}"; return 0
    fi
    for connector in /sys/class/drm/card[0-9]*-${input}; do
        [[ -d "${connector}" ]] && { echo "${connector}"; return 0; }
    done
    return 1
}

_selected_card_name() {
    [[ -n "${TARGET_DRM_DEVICE:-}" ]] || return 1
    basename "${TARGET_DRM_DEVICE}"
}

_require_kms_output_ready() {
    _bool_true "${REQUIRE_CONNECTED_OUTPUT_ON_START}" || return 0
    local card_name connectors
    card_name="$(_selected_card_name || true)"
    [[ -n "${card_name}" ]] || return 0
    connectors="$(_card_connected_connectors "${card_name}" | paste -sd ' ' -)"
    if [[ -n "${connectors}" ]]; then
        vlog "Connected KMS output(s) on ${card_name}: ${connectors}"
        return 0
    fi
    err "Selected DRM target ${TARGET_DRM_DEVICE} has no connected KMS output/CRTC."
    cat >&2 <<EOF_NO_OUTPUT
For the current Plasma Wayland + Sunshine KMS architecture, a connected output is required.
Use one of these:
  1) HDMI/DP dummy plug on the target GPU/iGPU; or
  2) kernel-forced EDID, then reboot and confirm connector status becomes connected; or
  3) set REQUIRE_CONNECTED_OUTPUT_ON_START=false only for diagnostics, knowing Moonlight may fail with 503.

Run:
  plasmactl headless-check
  plasmactl headless-edid status
  plasmactl headless-edid params
EOF_NO_OUTPUT
    return 1
}

_is_vkms_card() {
    local card_dir="$1" dev_path driver
    dev_path="$(_card_device_path "${card_dir}")"
    driver="$(_card_driver "${card_dir}")"
    [[ "$(basename "${dev_path:-x}")" == "vkms" ]] && return 0
    [[ "${driver}" == "vkms" || "${driver}" == "faux_driver" ]] && return 0
    [[ "${dev_path}" == */vkms* ]] && return 0
    return 1
}

_card_is_real() { ! _is_vkms_card "$1"; }

_print_drm_map() {
    local card_dir cname dev driver vendor conn vkms rec
    for card_dir in /sys/class/drm/card[0-9]*; do
        cname="$(_card_name_from_dir "${card_dir}")"
        [[ "${cname}" =~ ^card[0-9]+$ ]] || continue
        dev="$(_card_dev_from_name "${cname}")"
        driver="$(_card_driver "${card_dir}")"
        vendor="$(_card_vendor "${card_dir}")"
        conn=""
        _card_has_connected_display "${cname}" && conn=" [display connected]" || true
        vkms=""
        _is_vkms_card "${card_dir}" && vkms=" ← VKMS/faux" || true
        rec=""
        [[ "${dev}" == "${TARGET_DRM_DEVICE:-}" ]] && rec=" ← selected"
        printf '  %-10s → %-12s vendor=%-8s%s%s%s\n' "${cname}" "${driver}" "${vendor:-?}" "${conn}" "${vkms}" "${rec}"
    done
}


_driver_in_list() {
    local needle="$1" item
    shift || true
    for item in "$@"; do
        [[ "${item}" == "${needle}" ]] && return 0
    done
    return 1
}

_effective_gpu_role() {
    local role="${PLASMA_GPU_OVERRIDE:-${PLASMA_GPU_DEFAULT:-auto}}"
    case "${role}" in
        igpu|integrated|intel) echo "igpu" ;;
        dgpu|discrete|amd|nvidia) echo "dgpu" ;;
        auto|any|"") echo "auto" ;;
        *) echo "${role}" ;;
    esac
}

_gpu_role_drivers() {
    case "$(_effective_gpu_role)" in
        igpu) echo "${PLASMA_GPU_IGPU_DRIVERS}" ;;
        dgpu) echo "${PLASMA_GPU_DGPU_DRIVERS}" ;;
        auto) echo "${PLASMA_DRM_DRIVER_ORDER}" ;;
        *) echo "${PLASMA_DRM_DRIVER_ORDER}" ;;
    esac
}

_target_driver() {
    local card_dir
    [[ -n "${TARGET_DRM_DEVICE:-}" ]] || return 1
    card_dir="/sys/class/drm/$(basename "${TARGET_DRM_DEVICE}")"
    _card_driver "${card_dir}"
}

_driver_list_contains() {
    local wanted="$1" list="$2" drv
    for drv in ${list}; do
        [[ "${drv}" == "${wanted}" ]] && return 0
    done
    return 1
}

_assert_target_driver_policy() {
    local driver role allowed forbidden
    driver="$(_target_driver 2>/dev/null || true)"
    [[ -n "${driver}" ]] || return 0

    for forbidden in ${PLASMA_GPU_FORBID_DRIVERS}; do
        if [[ "${driver}" == "${forbidden}" ]]; then
            err "Selected DRM target ${TARGET_DRM_DEVICE} uses forbidden driver '${driver}'."
            return 1
        fi
    done

    if [[ -n "${PLASMA_DRM_REQUIRE_DRIVER}" && "${driver}" != "${PLASMA_DRM_REQUIRE_DRIVER}" ]]; then
        err "Selected DRM target ${TARGET_DRM_DEVICE} uses driver '${driver}', but PLASMA_DRM_REQUIRE_DRIVER=${PLASMA_DRM_REQUIRE_DRIVER}."
        return 1
    fi

    role="$(_effective_gpu_role)"
    if [[ "${role}" != "auto" ]] && ! _bool_true "${PLASMA_GPU_ALLOW_FALLBACK}"; then
        allowed="$(_gpu_role_drivers)"
        if ! _driver_list_contains "${driver}" "${allowed}"; then
            err "GPU role '${role}' is enforced, but selected DRM target ${TARGET_DRM_DEVICE} uses driver '${driver}'."
            err "Allowed drivers for role '${role}': ${allowed}"
            err "Use --gpu=dgpu/--gpu=igpu for a one-shot override, or set PLASMA_GPU_DEFAULT accordingly."
            return 1
        fi
    fi
    return 0
}

_find_connected_card_by_driver_list() {
    local drv found
    for drv in $1; do
        found="$(_find_connected_card_by_driver "${drv}" || true)"
        [[ -n "${found}" ]] && { echo "${found}"; return 0; }
    done
    return 1
}

_find_card_by_driver_list() {
    local drv found
    for drv in $1; do
        found="$(_find_card_by_driver "${drv}" || true)"
        [[ -n "${found}" ]] && { echo "${found}"; return 0; }
    done
    return 1
}

_resolve_configured_drm() {
    local configured="${PLASMA_DRM_DEVICE:-auto}"
    # Runtime GPU role overrides intentionally bypass a static PLASMA_DRM_DEVICE path.
    if [[ -n "${PLASMA_GPU_OVERRIDE:-}" && "${PLASMA_GPU_OVERRIDE}" != "auto" ]]; then
        return 2
    fi
    [[ -n "${KWIN_DRM_DEVICES:-}" ]] && configured="${KWIN_DRM_DEVICES%%:*}"
    if [[ "${configured}" != "auto" && -n "${configured}" ]]; then
        if [[ -e "${configured}" ]]; then
            TARGET_DRM_DEVICE="${configured}"
            _assert_target_driver_policy || return 1
            echo "${TARGET_DRM_DEVICE}" > "${TARGET_DEVICE_FILE}"
            return 0
        fi
        if _bool_true "${PLASMA_DRM_DEVICE_AUTO_FALLBACK}"; then
            _warn "Configured PLASMA_DRM_DEVICE=${configured} does not exist; falling back to auto DRM detection."
            _warn "This often happens after booting with no monitor/dummy connected or when card numbering changes."
            return 2
        fi
        err "Configured PLASMA_DRM_DEVICE=${configured} does not exist"
        return 1
    fi
    return 2
}

_find_card_by_driver() {
    local wanted="$1" card_dir cname dev
    for card_dir in /sys/class/drm/card[0-9]*; do
        cname="$(_card_name_from_dir "${card_dir}")"
        [[ "${cname}" =~ ^card[0-9]+$ ]] || continue
        _card_is_real "${card_dir}" || continue
        [[ "$(_card_driver "${card_dir}")" == "${wanted}" ]] || continue
        dev="$(_card_dev_from_name "${cname}")"
        [[ -e "${dev}" ]] || continue
        echo "${dev}"
        return 0
    done
    return 1
}

_find_connected_card_by_driver() {
    local wanted="$1" card_dir cname dev
    for card_dir in /sys/class/drm/card[0-9]*; do
        cname="$(_card_name_from_dir "${card_dir}")"
        [[ "${cname}" =~ ^card[0-9]+$ ]] || continue
        _card_is_real "${card_dir}" || continue
        [[ "$(_card_driver "${card_dir}")" == "${wanted}" ]] || continue
        _card_has_connected_display "${cname}" || continue
        dev="$(_card_dev_from_name "${cname}")"
        [[ -e "${dev}" ]] || continue
        echo "${dev}"
        return 0
    done
    return 1
}

_find_connected_real_card() {
    local card_dir cname dev
    for card_dir in /sys/class/drm/card[0-9]*; do
        cname="$(_card_name_from_dir "${card_dir}")"
        [[ "${cname}" =~ ^card[0-9]+$ ]] || continue
        _card_is_real "${card_dir}" || continue
        _card_has_connected_display "${cname}" || continue
        dev="$(_card_dev_from_name "${cname}")"
        [[ -e "${dev}" ]] || continue
        echo "${dev}"
        return 0
    done
    return 1
}

_find_any_real_card() {
    local card_dir cname dev
    for card_dir in /sys/class/drm/card[0-9]*; do
        cname="$(_card_name_from_dir "${card_dir}")"
        [[ "${cname}" =~ ^card[0-9]+$ ]] || continue
        _card_is_real "${card_dir}" || continue
        dev="$(_card_dev_from_name "${cname}")"
        [[ -e "${dev}" ]] || continue
        echo "${dev}"
        return 0
    done
    return 1
}

_find_vkms_card() {
    local card_dir cname dev
    for card_dir in /sys/class/drm/card[0-9]*; do
        cname="$(_card_name_from_dir "${card_dir}")"
        [[ "${cname}" =~ ^card[0-9]+$ ]] || continue
        _is_vkms_card "${card_dir}" || continue
        dev="$(_card_dev_from_name "${cname}")"
        [[ -e "${dev}" ]] || continue
        echo "${dev}"
        return 0
    done
    return 1
}

resolve_plasma_drm_device() {
    if _resolve_configured_drm; then
        vlog "Using configured DRM device: ${TARGET_DRM_DEVICE}"
        return 0
    elif [[ $? -eq 1 ]]; then
        return 1
    fi

    local found="" drv role role_drivers
    role="$(_effective_gpu_role)"
    role_drivers="$(_gpu_role_drivers)"

    if [[ -n "${PLASMA_DRM_REQUIRE_DRIVER}" ]]; then
        found="$(_find_connected_card_by_driver "${PLASMA_DRM_REQUIRE_DRIVER}" || true)"
        [[ -z "${found}" ]] && found="$(_find_card_by_driver "${PLASMA_DRM_REQUIRE_DRIVER}" || true)"
        if [[ -z "${found}" ]]; then
            err "PLASMA_DRM_REQUIRE_DRIVER=${PLASMA_DRM_REQUIRE_DRIVER} was requested, but no such DRM card exists."
            echo "Run: plasmactl headless-check" >&2
            return 1
        fi
    fi

    # Enforced GPU role path: igpu/dgpu must not silently fall back unless explicitly allowed.
    if [[ -z "${found}" && "${role}" != "auto" ]]; then
        found="$(_find_connected_card_by_driver_list "${role_drivers}" || true)"
        [[ -z "${found}" ]] && found="$(_find_card_by_driver_list "${role_drivers}" || true)"
        if [[ -z "${found}" ]] && ! _bool_true "${PLASMA_GPU_ALLOW_FALLBACK}"; then
            err "GPU role '${role}' requested, but no matching DRM card exists."
            err "Drivers for '${role}': ${role_drivers}"
            err "Current DRM map:"
            _print_drm_map >&2 || true
            return 1
        fi
    fi

    # General auto/fallback path: prefer connected outputs in configured order.
    if [[ -z "${found}" ]]; then
        for drv in ${PLASMA_DRM_DRIVER_ORDER}; do
            found="$(_find_connected_card_by_driver "${drv}" || true)"
            [[ -n "${found}" ]] && break
        done
    fi

    # Then prefer any real card with a connected connector; useful for explicitly allowing fallback/dummy HDMI/DP.
    [[ -z "${found}" ]] && found="$(_find_connected_real_card || true)"

    # Then fall back by driver order even without a connector. REQUIRE_CONNECTED_OUTPUT_ON_START will catch this later.
    if [[ -z "${found}" ]]; then
        for drv in ${PLASMA_DRM_DRIVER_ORDER}; do
            found="$(_find_card_by_driver "${drv}" || true)"
            [[ -n "${found}" ]] && break
        done
    fi
    [[ -z "${found}" ]] && found="$(_find_any_real_card || true)"

    if [[ -z "${found}" ]] && _bool_true "${ALLOW_VKMS}"; then
        found="$(_find_vkms_card || true)"
    fi

    if [[ -z "${found}" ]]; then
        err "No suitable real DRM card found. Run: plasmactl detect-gpu --verbose"
        err "If you intentionally want VKMS, set ALLOW_VKMS=true in ${CONFIG_FILE}"
        return 1
    fi

    TARGET_DRM_DEVICE="${found}"
    _assert_target_driver_policy || return 1
    echo "${TARGET_DRM_DEVICE}" > "${TARGET_DEVICE_FILE}"
    vlog "Auto-selected DRM device: ${TARGET_DRM_DEVICE}"
}

cmd_detect_gpu() {
    _LOG_CTX="detect-gpu"
    resolve_plasma_drm_device >/dev/null 2>&1 || true
    echo ""
    printf '\033[1mDRM Device Map\033[0m\n'
    echo "──────────────"
    _print_drm_map
    echo ""
    echo "Selected Plasma DRM target: ${TARGET_DRM_DEVICE:-not resolved}"
    echo "Config file: ${CONFIG_FILE}"
    echo "Override example:"
    echo "  mkdir -p ~/.config"
    echo "  echo 'PLASMA_DRM_DEVICE=/dev/dri/card1' > ~/.config/plasmactl.conf"
    echo ""
}

# ─────────────────────────────────────────────────────────────────────────────
# PLASMA HEALTH
# ─────────────────────────────────────────────────────────────────────────────

_kwin_pids() { pgrep -x kwin_wayland 2>/dev/null || true; }
_plasmashell_pids() { pgrep -x plasmashell 2>/dev/null || true; }
_xwayland_pids() { pgrep -x Xwayland 2>/dev/null || true; }

get_kwin_pid_for_target() {
    local pid envdev
    while IFS= read -r pid; do
        [[ -n "${pid}" ]] || continue
        envdev="$(_pid_env "${pid}" 2>/dev/null | awk -F= '$1=="KWIN_DRM_DEVICES" {print $2; exit}' || true)"
        if [[ -n "${TARGET_DRM_DEVICE}" && "${envdev}" == *"${TARGET_DRM_DEVICE}"* ]]; then
            echo "${pid}"
            return 0
        fi
    done < <(_kwin_pids)

    # Fallback: if exactly one kwin exists, accept it but log that env did not match/was unavailable.
    local count first
    count="$(_kwin_pids | awk 'NF{c++} END{print c+0}')"
    if [[ "${count}" == "1" ]]; then
        first="$(_kwin_pids | awk 'NF{print; exit}')"
        [[ -n "${first}" ]] && echo "${first}" && return 0
    fi
    return 1
}

check_kwin() { [[ -n "$(get_kwin_pid_for_target 2>/dev/null || true)" ]]; }
check_plasmashell() { [[ -n "$(_pid_first plasmashell)" ]]; }
check_xwayland() { [[ -n "$(_pid_first Xwayland)" ]]; }
check_startplasma_running() { pgrep -fa 'startplasma-wayland|dbus-run-session.*startplasma' >/dev/null 2>&1; }

_detect_wayland_display_from_pid() {
    local pid="$1" wd xrd
    wd="$(_pid_env "${pid}" 2>/dev/null | awk -F= '$1=="WAYLAND_DISPLAY" {print $2; exit}' || true)"
    xrd="$(_pid_env "${pid}" 2>/dev/null | awk -F= '$1=="XDG_RUNTIME_DIR" {print $2; exit}' || true)"
    [[ -z "${xrd}" ]] && xrd="${RUNTIME_DIR}"
    if [[ -n "${wd}" && -S "${xrd}/${wd}" ]]; then
        WAYLAND_DISPLAY_DETECTED="${wd}"
        echo "${wd}" > "${WAYLAND_DISPLAY_FILE}"
        return 0
    fi
    return 1
}

check_wayland_socket() {
    local pid sock base
    pid="$(get_kwin_pid_for_target 2>/dev/null || true)"
    [[ -n "${pid}" ]] && _detect_wayland_display_from_pid "${pid}" && return 0
    while IFS= read -r sock; do
        [[ -S "${sock}" ]] || continue
        base="$(basename "${sock}")"
        WAYLAND_DISPLAY_DETECTED="${base}"
        echo "${base}" > "${WAYLAND_DISPLAY_FILE}"
        return 0
    done < <(find "${RUNTIME_DIR}" -maxdepth 1 -type s -name 'wayland-*' 2>/dev/null | sort)
    return 1
}

check_plasma_healthy() {
    check_kwin && check_wayland_socket && check_plasmashell
}

wait_for() {
    local label="$1" timeout="$2" check_fn="$3" waited=0
    log "Waiting for ${label} (max ${timeout}s)..."
    while ! ${check_fn}; do
        if [[ ${waited} -ge ${timeout} ]]; then
            err "Timeout waiting for ${label} after ${timeout}s"
            return 1
        fi
        sleep 1; (( waited++ ))
        vlog "  ${label}: ${waited}s"
    done
    log "${label} ready after ${waited}s"
}

wait_gone() {
    local label="$1" timeout="$2" check_fn="$3" waited=0
    log "Waiting for ${label} to exit (max ${timeout}s)..."
    while ${check_fn}; do
        if [[ ${waited} -ge ${timeout} ]]; then
            err "Timeout: ${label} still running after ${timeout}s"
            return 1
        fi
        sleep 1; (( waited++ ))
        vlog "  ${label} alive: ${waited}s"
    done
    log "${label} exited after ${waited}s"
}

_stop_plasma_processes() {
    if check_plasmashell; then
        log "Stopping plasmashell..."
        pkill -TERM plasmashell 2>/dev/null || true
        wait_gone "plasmashell" "${WAIT_STOP}" check_plasmashell || pkill -KILL plasmashell 2>/dev/null || true
    fi
    if check_xwayland; then
        log "Stopping Xwayland..."
        pkill -TERM Xwayland 2>/dev/null || true
        wait_gone "Xwayland" 5 check_xwayland || pkill -KILL Xwayland 2>/dev/null || true
    fi
    if check_kwin || [[ -n "$(_pid_first kwin_wayland)" ]]; then
        log "Stopping kwin_wayland..."
        pkill -TERM kwin_wayland 2>/dev/null || true
        wait_gone "kwin_wayland" "${WAIT_STOP}" check_any_kwin || pkill -KILL kwin_wayland 2>/dev/null || true
    fi
    pkill -TERM -f 'dbus-run-session.*startplasma-wayland' 2>/dev/null || true
    pkill -TERM -f 'startplasma-wayland' 2>/dev/null || true
}
check_any_kwin() { [[ -n "$(_pid_first kwin_wayland)" ]]; }

# ─────────────────────────────────────────────────────────────────────────────
# SUNSHINE
# ─────────────────────────────────────────────────────────────────────────────

check_sunshine_exists() {
    systemctl --user cat "${SUNSHINE_UNIT}" >/dev/null 2>&1 || systemctl --user cat sunshine.service >/dev/null 2>&1
}
check_sunshine_service_active() { systemctl --user is-active --quiet "${SUNSHINE_UNIT}" 2>/dev/null; }
check_sunshine_enabled() { systemctl --user is-enabled --quiet "${SUNSHINE_UNIT}" 2>/dev/null; }
check_sunshine_process() { pgrep -x sunshine >/dev/null 2>&1; }

# Backward-compatible name used by old call sites; in v0.2.6 this means real process.
check_sunshine() { check_sunshine_process; }

_sunshine_pids() { pgrep -x sunshine 2>/dev/null || true; }
_sunshine_newest_pid() { _pid_newest sunshine; }

_sunshine_listeners() {
    {
        ss -lntup 2>/dev/null || true
        ss -lnup 2>/dev/null || true
    } | grep -E 'sunshine|47984|47989|47990|48010|47998|47999|48000' || true
}

_tcp_port_listening() {
    local port="$1"
    ss -ltn 2>/dev/null | awk -v p=":${port}" '$4 ~ p"$" {found=1} END{exit !found}'
}
_udp_port_listening() {
    local port="$1"
    ss -lun 2>/dev/null | awk -v p=":${port}" '$5 ~ p"$" {found=1} END{exit !found}'
}

check_sunshine_required_tcp_ports() {
    local port
    for port in ${SUNSHINE_REQUIRED_TCP_PORTS}; do
        _tcp_port_listening "${port}" || return 1
    done
}

check_sunshine_ready() {
    check_sunshine_process && check_sunshine_required_tcp_ports
}

_print_sunshine_ports_status() {
    local port ok_any=false
    for port in ${SUNSHINE_TCP_PORTS}; do
        if _tcp_port_listening "${port}"; then
            printf '    tcp/%s: LISTEN
' "${port}"
            ok_any=true
        else
            printf '    tcp/%s: closed
' "${port}"
        fi
    done
    # UDP may not be visible until session negotiation depending on Sunshine build/config,
    # so report it, but do not make idle readiness depend on it.
    for port in 47998 47999 48000 48010; do
        if _udp_port_listening "${port}"; then
            printf '    udp/%s: LISTEN
' "${port}"
        fi
    done
    ${ok_any} || true
}

_show_sunshine_failure() {
    err "Sunshine is not stream-ready. Required TCP listeners missing: ${SUNSHINE_REQUIRED_TCP_PORTS}"
    echo "[sunshine-listeners]"
    _sunshine_listeners | sed 's/^/[sunshine-listeners] /' || true
    echo "[sunshine-processes]"
    pgrep -a sunshine 2>/dev/null | sed 's/^/[sunshine-process] /' || echo "[sunshine-process] none"
    echo "[sunshine-service]"
    systemctl --user status "${SUNSHINE_UNIT}" --no-pager -l 2>&1 | sed 's/^/[sunshine-status] /' || true
    echo "[sunshine-journal]"
    journalctl --user -u "${SUNSHINE_UNIT}" -n 100 --no-pager 2>&1 | sed 's/^/[sunshine-journal] /' || true
    echo "[sunshine-tmux-log]"
    [[ -f "${SUNSHINE_TMUX_LOG}" ]] && tail -n 120 "${SUNSHINE_TMUX_LOG}" | sed 's/^/[sunshine-tmux] /' || echo "[sunshine-tmux] no tmux log"
}

_stop_sunshine_systemd() {
    # Clear start-limit-hit and stop any unit instance. This service has been observed
    # failing with signal=TRAP/start-limit-hit, so always reset it before retries.
    systemctl --user stop "${SUNSHINE_UNIT}" sunshine.service >/dev/null 2>&1 || true
    systemctl --user reset-failed "${SUNSHINE_UNIT}" sunshine.service >/dev/null 2>&1 || true
}

_stop_sunshine_tmux_window() {
    if tmux list-windows -t "${SESSION}" -F '#{window_name}' 2>/dev/null | grep -qx "${SUNSHINE_WINDOW}"; then
        log "Stopping Sunshine tmux window '${SUNSHINE_WINDOW}'..."
        tmux kill-window -t "${SESSION}:${SUNSHINE_WINDOW}" >/dev/null 2>&1 || true
    fi
}

_stop_sunshine_if_active() {
    local had=false
    if check_sunshine_service_active; then had=true; fi
    if check_sunshine_process; then had=true; fi
    if tmux list-windows -t "${SESSION}" -F '#{window_name}' 2>/dev/null | grep -qx "${SUNSHINE_WINDOW}"; then had=true; fi

    ${had} && log "Stopping Sunshine before Plasma transition..." || true
    _stop_sunshine_systemd_run
    _stop_sunshine_systemd
    _stop_sunshine_tmux_window

    if check_sunshine_process; then
        pkill -TERM -x sunshine 2>/dev/null || true
        wait_gone "sunshine process" "${WAIT_STOP}" check_sunshine_process || pkill -KILL -x sunshine 2>/dev/null || true
    fi
    rm -f "${SUNSHINE_PID_FILE}"
}

_set_systemd_user_env_for_sunshine() {
    [[ -n "${WAYLAND_DISPLAY_DETECTED}" ]] || check_wayland_socket || true
    local wd="${WAYLAND_DISPLAY_DETECTED:-}"
    [[ -z "${wd}" && -f "${WAYLAND_DISPLAY_FILE}" ]] && wd="$(cat "${WAYLAND_DISPLAY_FILE}" 2>/dev/null || true)"
    if [[ -n "${wd}" ]]; then
        log "Importing Wayland environment into systemd --user (WAYLAND_DISPLAY=${wd})"
        systemctl --user set-environment             "XDG_RUNTIME_DIR=${RUNTIME_DIR}"             "XDG_SESSION_TYPE=wayland"             "XDG_CURRENT_DESKTOP=KDE"             "KDE_FULL_SESSION=true"             "KWIN_DRM_DEVICES=${TARGET_DRM_DEVICE}"             "WAYLAND_DISPLAY=${wd}" 2>/dev/null || true
    else
        _warn "WAYLAND_DISPLAY not detected; Sunshine will start without Wayland env import"
    fi
}

_warn_if_sunshine_selected_vkms() {
    local since="${1:-}" fresh
    [[ -n "${since}" ]] || since="5 minutes ago"
    fresh="$(journalctl --user -u "${SUNSHINE_UNIT}" --since "${since}" --no-pager 2>/dev/null || true)"
    if printf '%s
' "${fresh}" | grep -Eq '/dev/dri/card[0-9]+ -> (vkms|faux)|No render device name for: /dev/dri/card[0-9]+'; then
        _warn "Sunshine appears to be selecting VKMS/faux for KMS capture. This can cause stream/RTSP failures."
        printf '%s
' "${fresh}" | grep -E '/dev/dri/card[0-9]+ ->|No render device name|wlgrab|wayland|KMS|CLIENT|RTSP|Error' | tail -n 25 | sed 's/^/[sunshine-fresh] /' || true
    fi
}


_sunshine_conf_get() {
    local key="$1" file="${2:-${SUNSHINE_DEFAULT_CONFIG}}"
    [[ -f "${file}" ]] || return 1
    awk -F= -v k="${key}" '
        {
            lhs=$1
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", lhs)
            if (lhs == k) {
                $1=""
                sub(/^=/, "")
                gsub(/^[[:space:]]+|[[:space:]]+$/, "")
                print
                exit
            }
        }
    ' "${file}"
}

